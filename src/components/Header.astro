---
import BrandMark from "../components/BrandMark.astro";
import "../styles/connected-flowmark.css";
const { currentPath = "/" } = Astro.props;

const services = [
  {
    name: "Performance Marketing",
    detail: "Google Ads & Meta Ads",
    url: "/performance-marketing/"
  },
  {
    name: "Ad Creatives & Content",
    detail: "Image ads, video ads & social creatives",
    url: "/ad-creatives-content/"
  },
  {
    name: "Websites & Funnels",
    detail: "Custom websites & conversion funnels",
    url: "/websites-funnels/"
  },
  {
    name: "Systems & AI Automation",
    detail: "CRM, custom AI agents & integrations",
    url: "/crm-automation/"
  },
  {
    name: "Appointment Setting",
    detail: "AI receptionist, calls & bookings",
    url: "/appointment-setting/"
  }
];
---

<header class="site-header">
  <div class="container nav-wrap">
    <a href="/" class="wordmark" aria-label="LeadsFlo homepage"><BrandMark theme="light" /></a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span></span><span></span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
      <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>
        Home
      </a>

      <details class="services-dropdown">
        <summary>
          Services
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>

        <div class="services-panel">
          <p class="dropdown-label">WHAT WE DO</p>

          {services.map((service, index) => (
            <a href={service.url} class="services-option"
               aria-current={currentPath === service.url ? "page" : undefined}>
              <span class="option-number">0{index + 1}</span>
              <span class="option-body">
                <strong>{service.name}</strong>
                <small>{service.detail}</small>
              </span>
              <span class="option-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </details>

      <a href="/our-approach/"
         aria-current={currentPath === "/our-approach/" ? "page" : undefined}>
        Our Approach
      </a>

      <details class="services-dropdown lf-explore-dropdown">
        <summary>Explore <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary>
        <div class="services-panel">
          <p class="dropdown-label">DISCOVER LEADSFLO</p>
          <a class="services-option" href="/work/"><span class="option-number">01</span><span class="option-body"><strong>Our Work</strong><small>Projects and case studies</small></span><span class="option-arrow">↗</span></a>
          <a class="services-option" href="/about/"><span class="option-number">02</span><span class="option-body"><strong>About</strong><small>Meet the founder</small></span><span class="option-arrow">↗</span></a>
          <a class="services-option" href="/insights/"><span class="option-number">03</span><span class="option-body"><strong>Insights</strong><small>Guides and ideas</small></span><span class="option-arrow">↗</span></a>
        </div>
      </details>

      <a href="/contact/" class="nav-cta">
        Let's Talk <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector(".menu-toggle");
  const primaryNav = document.querySelector(".primary-nav");
  const dropdown = document.querySelector(".services-dropdown");
  const exploreDropdown = document.querySelector(".lf-explore-dropdown");
  const dropdownSummary = dropdown?.querySelector("summary");

  function closeDropdown() {
    if (dropdown) dropdown.open = false;
    if (exploreDropdown) exploreDropdown.open = false;
  }

  function closeMobileMenu() {
    primaryNav?.classList.remove("is-open");
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.setAttribute("aria-label", "Open navigation");
  }

  menuButton?.addEventListener("click", () => {
    const willOpen = !primaryNav?.classList.contains("is-open");
    primaryNav?.classList.toggle("is-open", willOpen);
    menuButton.setAttribute("aria-expanded", String(willOpen));
    menuButton.setAttribute(
      "aria-label",
      willOpen ? "Close navigation" : "Open navigation"
    );
    if (!willOpen) closeDropdown();
  });

  dropdown?.addEventListener("mouseenter", () => {
    if (window.matchMedia("(min-width: 801px) and (hover: hover)").matches) {
      dropdown.open = true;
    }
  });

  dropdown?.addEventListener("mouseleave", () => {
    if (window.matchMedia("(min-width: 801px) and (hover: hover)").matches &&
        !dropdown.contains(document.activeElement)) {
      closeDropdown();
    }
  });

  dropdown?.addEventListener("focusout", (event) => {
    // On touch/mobile, focus changes between summary and links must not
    // collapse a menu before the link click is delivered.
    if (window.matchMedia("(max-width: 800px)").matches) return;
    if (!dropdown.contains(event.relatedTarget)) dropdown.open = false;
  });

  exploreDropdown?.addEventListener("mouseenter", () => {
    if (window.matchMedia("(min-width: 801px) and (hover: hover)").matches) exploreDropdown.open = true;
  });
  exploreDropdown?.addEventListener("mouseleave", () => {
    if (window.matchMedia("(min-width: 801px) and (hover: hover)").matches && !exploreDropdown.contains(document.activeElement)) exploreDropdown.open = false;
  });
  exploreDropdown?.addEventListener("focusout", (event) => {
    if (window.matchMedia("(max-width: 800px)").matches) return;
    if (!exploreDropdown.contains(event.relatedTarget)) exploreDropdown.open = false;
  });
  document.addEventListener("click", (event) => {
    // A mobile tap outside the dropdown should not disrupt a navigation tap.
    if (window.matchMedia("(max-width: 800px)").matches) return;
    if (!dropdown?.contains(event.target) && !exploreDropdown?.contains(event.target)) closeDropdown();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    const wasOpen = dropdown?.open;
    closeDropdown();

    if (primaryNav?.classList.contains("is-open")) {
      closeMobileMenu();
      menuButton?.focus();
    } else if (wasOpen) {
      dropdownSummary?.focus();
    }
  });

  primaryNav?.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      // Allow the anchor navigation to complete before collapsing the menu.
      // On mobile this also prevents a premature layout change during taps.
      if (!window.matchMedia("(max-width: 800px)").matches) {
        closeDropdown();
        closeMobileMenu();
      }
    });
  });

  // LEADSFLO_HOVER_PREVIEW_V1
  // Mouse hover previews existing interactive demo selections.
  // Touch and keyboard interactions retain their native behavior.
  document.addEventListener("pointerover", (event) => {
    if (event.pointerType !== "mouse") return;

    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest("main button[aria-pressed]");
    if (!(button instanceof HTMLButtonElement)) return;

    // LEADSFLO_CREATIVE_EVENT_ISOLATION_V1
    // Creative Studio manages its own thumbnail hover and tab selection.
    if (button.closest("[data-creative-studio]")) return;

    // Ignore movement between child elements within one button.
    if (
      event.relatedTarget instanceof Node &&
      button.contains(event.relatedTarget)
    ) return;

    if (button.disabled) return;
    if (button.getAttribute("aria-pressed") === "true") return;

    // Activate the component's existing handler rather than
    // implementing separate or inconsistent hover logic.
    button.click();
  });

</script>
