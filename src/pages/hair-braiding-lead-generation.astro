<style is:global>
:root{--hb-ink:#26172e;--hb-berry:#6c395f;--hb-rose:#e3b9b1;--hb-champagne:#e6ca9d;--hb-paper:#faf6f3;--hb-muted:#716674}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body.hb{margin:0;background:var(--hb-paper);color:var(--hb-ink);font-family:Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased}
.hb a{color:inherit}.hb button,.hb input{font:inherit}.hb button{cursor:pointer}.hb :focus-visible{outline:3px solid #b87976;outline-offset:4px}
.hb-wrap{width:min(1180px,calc(100% - 48px));margin:auto}
.hb-header{position:sticky;top:0;z-index:90;background:#fffbf7ec;border-bottom:1px solid #e9dadc;backdrop-filter:blur(16px);transition:transform .25s}
.hb-header.hide{transform:translateY(-110%)}
.hb-nav{min-height:82px;display:flex;align-items:center;justify-content:space-between;gap:22px}
.hb-logo{text-decoration:none!important;display:inline-flex;align-items:center;position:relative}
.hb-logo .lf-brand-v4{--brand-text:#281a31;--brand-flo:#9c537d;--brand-period:#c59668;--brand-plane:#9c537d;font-size:31px}
.hb-logo .lf-brand-v4__current1{stroke:#9c537d}.hb-logo .lf-brand-v4__current2{stroke:#c89c77}
.hb-logo:hover .lf-brand-v4__plane{transform:rotate(-9deg) translate(3px,-2px)}
.hb-links{display:flex;align-items:center;gap:23px}
.hb-links a:not(.hb-cta){text-decoration:none;font-size:13px;font-weight:800}
.hb-cta{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:49px;padding:13px 22px;border-radius:6px;background:#512a4d;color:#fff!important;text-decoration:none!important;font-size:13px;font-weight:800;transition:transform .2s,background .2s}
.hb-cta:hover{background:#7b476b;transform:translateY(-2px)}
.hb-menu{display:none;width:52px;height:52px;border:1px solid #e0cbd2;border-radius:8px;background:white;align-items:center;justify-content:center}
.hb-menu span{display:grid;gap:6px}.hb-menu i{display:block;width:28px;height:3px;background:#512a4d;border-radius:4px}
.hb-hero{position:relative;overflow:hidden;background:linear-gradient(125deg,#fbf4ed,#f5e5e7 68%,#e8d9e7);padding:105px 0 110px}
.hb-hero:before,.hb-section:before{content:"";position:absolute;pointer-events:none;inset:0;background:repeating-linear-gradient(128deg,transparent 0 92px,#8f57720d 93px 95px,transparent 96px 170px);opacity:.7}
.hb-hero-grid{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:56px;position:relative}
.hb-kicker{display:inline-flex;gap:12px;align-items:center;text-transform:uppercase;color:#8a4d72;font-size:11px;font-weight:850;letter-spacing:.17em}
.hb-kicker:before{content:"";width:26px;height:2px;background:#cb9a70}
.hb h1{font-size:clamp(45px,6vw,76px);letter-spacing:-.07em;line-height:1.06;margin:20px 0 25px}
.hb h1 em{font-style:normal;color:#a05b82}.hb-lede{font-size:18px;line-height:1.82;color:#6b5b6d;max-width:640px}
.hb-actions{display:flex;flex-wrap:wrap;gap:13px;margin:32px 0}
.hb-outline{display:inline-flex;align-items:center;justify-content:center;padding:13px 21px;border:1px solid #b58eaa;border-radius:6px;color:#522d4d;text-decoration:none;font-size:13px;font-weight:800}
.hb-tags{display:flex;gap:10px;flex-wrap:wrap}.hb-tags span{padding:9px 13px;background:#fff9;border:1px solid #dfc9d2;border-radius:22px;font-size:12px;font-weight:750;color:#795672}
.hb-art{min-height:500px;border:10px solid #fff9;border-radius:24px;position:relative;overflow:hidden;background:radial-gradient(circle at 75% 20%,#cc99a7,#6e4267 65%,#382438);box-shadow:0 30px 70px #63385440}
.hb-art svg{width:100%;height:100%;position:absolute;inset:0}.hb-art-label{position:absolute;bottom:25px;left:25px;right:25px;background:#f9f1e8ed;padding:20px;border-radius:12px;display:grid;gap:4px}
.hb-art-label strong{font-size:20px}.hb-art-label small{font-size:12px;color:#755e6e}
.hb-band{background:#301d38;color:#f9e4e5;padding:21px 0;overflow:hidden}
.hb-band-track{display:flex;gap:12px;width:max-content;animation:hb-slide 34s linear infinite}
.hb-band-track span{white-space:nowrap;padding:11px 19px;border:1px solid #805b7b;border-radius:7px;font-size:12px;font-weight:800}
.hb-band-track span:before{content:"✦";color:#e8c48f;margin-right:13px}
.hb-section{position:relative;padding:95px 0;overflow:hidden}.hb-section>*{position:relative}
.hb-section.soft{background:#f4eaed}.hb-section.dark{background:#301d38;color:#fff}
.hb-section h2{font-size:clamp(34px,4.5vw,55px);line-height:1.13;letter-spacing:-.055em;margin:16px 0 18px;max-width:850px}
.hb-intro{color:#746477;font-size:16px;line-height:1.8;max-width:770px}
.hb-section.dark .hb-intro{color:#d7c1d5}
.hb-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:34px}
.hb-tile{background:#fff;border:1px solid #e7d4dd;border-radius:12px;padding:27px;min-height:210px;transition:transform .2s,box-shadow .2s}
.hb-tile:hover{transform:translateY(-4px);box-shadow:0 16px 32px #57384d17}
.hb-tile small{font-size:11px;letter-spacing:.13em;color:#9a607e;font-weight:850}
.hb-tile h3{font-size:23px;letter-spacing:-.04em;margin:28px 0 9px}
.hb-tile p{color:#746879;line-height:1.75;font-size:14px}
.hb-select-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:20px;margin-top:38px}
.hb-options{display:grid;align-content:start;gap:10px}
.hb-select{border:1px solid #decbd5;background:#fff;text-align:left;border-radius:9px;padding:20px;min-height:65px;display:flex;justify-content:space-between;gap:14px;align-items:center;color:#4f2f4c;font-weight:800;transition:transform .2s,background .2s}
.hb-select:hover,.hb-select:focus-visible,.hb-select.active{background:#673858;color:#fff;border-color:#673858;transform:translateX(3px)}
.hb-panel{background:#482a47;color:white;border-radius:15px;padding:32px;min-height:445px;display:flex;flex-direction:column}
.hb-panel small{color:#e5bf8e;letter-spacing:.13em;font-size:11px;font-weight:850}
.hb-panel h3{font-size:clamp(26px,3vw,38px);line-height:1.16;letter-spacing:-.045em;margin:22px 0 15px}
.hb-panel p{line-height:1.8;color:#eddfe9}.hb-panel-foot{border-top:1px solid #886584;padding-top:21px;margin-top:auto}
.hb-braid{height:160px;border-radius:10px;overflow:hidden;background:radial-gradient(circle at center,#734664,#382138);margin:15px 0}
.hb-braid svg{width:100%;height:100%}
.hb-flow{display:flex;flex-wrap:wrap;gap:9px;margin-top:17px}.hb-flow span{padding:10px;border:1px solid #946f8b;background:#64405d;border-radius:5px;font-size:11px;font-weight:750}
.hb-quote{background:#fff2;border:1px solid #997593;border-radius:12px;padding:21px;margin:19px 0}
.hb-quote small{color:#e4c18f}.hb-quote p{font-size:15px;line-height:1.75;color:#fff;margin-bottom:0}
.hb-journey{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-top:35px}
.hb-step{min-height:180px;background:#573653;color:#fff;border:1px solid #805b7b;border-radius:10px;padding:22px;text-align:left;transition:transform .2s}
.hb-step:hover,.hb-step.active{background:#764d6d;transform:translateY(-3px)}
.hb-step small{display:block;color:#efcc9d;font-size:11px;letter-spacing:.1em;margin-bottom:27px}
.hb-step strong{font-size:20px}.hb-step-detail{margin-top:13px;background:#f5e9ee;border-radius:10px;padding:24px;color:#4b2d49}
.hb-step-detail p{color:#755d71;line-height:1.75}
.hb-planner{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:34px}
.hb-fields,.hb-results{border-radius:12px;padding:30px;border:1px solid #e7d1dc;background:white}
.hb-fields label{display:flex;justify-content:space-between;font-size:14px;font-weight:800;margin:15px 0 10px;gap:12px}
.hb-fields input{width:100%;accent-color:#865378}.hb-fields output{color:#9d527a}
.hb-results{background:#42263e;color:#fff;border-color:#42263e}
.hb-results small{letter-spacing:.12em;font-size:11px;color:#e8c48f}
.hb-result{display:flex;justify-content:space-between;align-items:center;padding:19px 0;border-bottom:1px solid #866681;gap:15px}
.hb-result strong{font-size:32px}.hb-result span{font-size:13px;color:#dfc9da}
.hb-disclaimer{font-size:12px!important;line-height:1.8!important;color:#dfccdc!important}
.hb-faqs{display:grid;gap:11px;margin-top:30px}
.hb-faqs details{background:#fff;border:1px solid #e3d5dd;border-radius:9px;padding:19px 22px}
.hb-faqs details:hover,.hb-faqs details[open]{border-color:#b685a6}
.hb-faqs summary{cursor:pointer;font-weight:800;font-size:16px}
.hb-faqs p{color:#756676;line-height:1.85}
.hb-guide{display:flex;flex-direction:column;gap:16px;padding:27px;background:white;border:1px solid #e2cfda;border-radius:12px;text-decoration:none;min-height:265px}
.hb-guide:hover{border-color:#a36e91;transform:translateY(-3px)}
.hb-guide small{font-size:11px;letter-spacing:.1em;color:#9a587c;font-weight:850}
.hb-guide strong{font-size:22px;line-height:1.2;letter-spacing:-.035em}
.hb-guide span{font-size:13px;color:#746777;line-height:1.75}.hb-guide b{margin-top:auto;color:#7f486d;font-size:12px}
.hb-close{background:linear-gradient(130deg,#42273e,#784767);color:#fff;padding:90px 0}.hb-close h2{font-size:clamp(38px,5vw,62px);line-height:1.13;letter-spacing:-.06em;max-width:860px}
.hb-close p{font-size:17px;color:#efdeea;line-height:1.8;max-width:690px}
.hb-footer{background:#25172d;color:#f5e7ed;padding:66px 0 35px}
.hb-footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:38px}
.hb-footer nav{display:flex;flex-direction:column;gap:14px}
.hb-footer nav a{font-size:14px;text-decoration:none;color:#f5e7ed}
.hb-footer h3{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:#e6c89f}
.hb-footer p{font-size:14px;line-height:1.85;color:#d4bfd0;max-width:520px}
.hb-footer .hb-logo .lf-brand-v4{--brand-text:#f7e8ec;--brand-flo:#e5b4cb;--brand-period:#d9b68a;--brand-plane:#d9b68a;font-size:37px}
.hb-footer .hb-logo .lf-brand-v4__current1{stroke:#d9adc9}
.hb-footer .hb-logo .lf-brand-v4__current2{stroke:#e8c999}
.hb-foot-bottom{margin-top:50px;padding-top:25px;border-top:1px solid #715269;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;color:#ccb6c8;font-size:12px}
.hb-sticky{display:none}
@keyframes hb-slide{to{transform:translateX(-50%)}}
@media(max-width:900px){.hb-hero-grid{gap:25px}.hb-art{min-height:380px}.hb-links{gap:12px}.hb-journey{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){
.hb-nav{min-height:73px}.hb-menu{display:flex}
.hb-links{display:none;position:absolute;top:100%;left:0;right:0;background:#fffaf8;padding:15px 24px 26px;box-shadow:0 18px 32px #39233433;flex-direction:column;align-items:stretch}
.hb-links.open{display:flex}
.hb-links a{padding:11px 0}
.hb-hero{padding:70px 0}.hb-hero-grid,.hb-select-layout,.hb-planner{grid-template-columns:1fr}
.hb-section{padding:70px 0}.hb-grid{grid-template-columns:repeat(2,1fr)}
.hb-art{min-height:360px}.hb-footer-grid{grid-template-columns:1fr 1fr}
.hb-footer-grid>div{grid-column:1/-1}
.hb-sticky{display:block;position:fixed;z-index:100;bottom:0;left:0;right:0;padding:10px 15px calc(10px + env(safe-area-inset-bottom));background:#fffaf8f0;backdrop-filter:blur(14px);border-top:1px solid #e0ccd7}
.hb-sticky .hb-cta{width:100%}body.hb{padding-bottom:calc(70px + env(safe-area-inset-bottom))}
}
@media(max-width:520px){.hb-wrap{width:calc(100% - 30px)}.hb h1{font-size:clamp(40px,10vw,55px)}.hb-art{min-height:310px}.hb-grid,.hb-journey,.hb-footer-grid{grid-template-columns:1fr}.hb-footer-grid>div{grid-column:auto}.hb-step{min-height:125px}.hb-step small{margin-bottom:13px}.hb-panel{padding:23px;min-height:410px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.hb-band-track{animation:none}.hb-cta,.hb-tile,.hb-select,.hb-step,.hb-guide{transition:none}}


/* LEADSFLO_HAIR_BRAIDING_VISUAL_V2 */

/* Retain the original LeadsFlo logo with a subtle braided detail. */
.hb-logo-weave{
  position:absolute;
  right:-31px;
  top:52%;
  width:38px;
  height:15px;
  fill:none;
  stroke:#b77996;
  stroke-width:2.7;
  stroke-linecap:round;
  pointer-events:none;
  opacity:.9;
  transition:transform .35s ease;
}
.hb-logo-weave path:nth-child(2){stroke:#e1b78d}
.hb-logo-weave path:nth-child(3){stroke:#c68ca7}
.hb-logo:hover .hb-logo-weave{
  transform:translate(4px,-2px) rotate(-7deg);
}
.hb-footer .hb-logo-weave{
  opacity:1;
}

/* Woven patterns instead of snow or floating decorative particles. */
.hb-section::after{
  content:"";
  position:absolute;
  right:-160px;
  bottom:-140px;
  width:450px;
  height:450px;
  background:
    repeating-radial-gradient(
      ellipse at center,
      transparent 0 21px,
      #a96e8a 22px 23px,
      transparent 24px 44px
    );
  border-radius:50%;
  transform:rotate(-22deg);
  opacity:.09;
  pointer-events:none;
}
.hb-section:nth-of-type(even)::after{
  right:auto;
  left:-170px;
  transform:rotate(20deg);
}
.hb-section.dark::after{
  opacity:.12;
  filter:brightness(1.8);
}
.hb-section .hb-wrap{
  position:relative;
  z-index:1;
}
.hb-braid svg{
  display:block;
  width:100%;
  height:100%;
}
.hb-select.active{
  box-shadow:inset 4px 0 0 #e8c299;
}

/* Expanded style categories. */
.hb-service-list{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:11px;
  margin-top:35px;
}
.hb-service-list span{
  background:white;
  border:1px solid #e5d2dc;
  border-radius:9px;
  padding:20px 16px;
  color:#573652;
  font-size:13px;
  font-weight:800;
  transition:transform .2s,background .2s;
}
.hb-service-list span:hover{
  background:#f9f0f3;
  transform:translateY(-3px);
}

/* Prominent genuine LeadsFlo project reference. */
.hb-case{
  display:grid;
  grid-template-columns:1.15fr .85fr;
  gap:25px;
  padding:35px;
  margin-top:35px;
  background:#40263f;
  border-radius:15px;
  color:#fff;
}
.hb-case small{
  color:#eac79b;
  font-weight:850;
  letter-spacing:.12em;
}
.hb-case h3{
  font-size:clamp(26px,3vw,36px);
  letter-spacing:-.05em;
  margin:16px 0;
}
.hb-case p{
  font-size:15px;
  color:#ecd8e4;
  line-height:1.85;
}
.hb-case a{
  display:inline-flex;
  text-decoration:none;
  padding:13px 18px;
  background:#f5e7eb;
  color:#482943;
  border-radius:6px;
  font-weight:850;
  font-size:13px;
  margin-top:15px;
}
.hb-case-art{
  position:relative;
  min-height:230px;
  overflow:hidden;
  border:1px solid #9e7597;
  border-radius:12px;
}
.hb-case-art svg{
  display:block;
  width:100%;
  height:100%;
}
.hb-case-art strong{
  position:absolute;
  left:20px;
  bottom:20px;
  color:white;
  font-size:24px;
  letter-spacing:-.05em;
}
@media(max-width:900px){
  .hb-service-list{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }
}
@media(max-width:760px){
  .hb-case{
    grid-template-columns:1fr;
  }
  .hb-logo-weave{
    width:30px;
    right:-24px;
  }
}
@media(max-width:520px){
  .hb-service-list{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
  .hb-service-list span{
    padding:16px 12px;
  }
  .hb-case{
    padding:24px;
  }
}
@media(prefers-reduced-motion:reduce){
  .hb-logo-weave,
  .hb-service-list span{
    transition:none;
  }
}


/* LEADSFLO_HAIR_PROFILE_LEFT_V5 */
.hb-logo {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 7px;
  overflow: visible;
}

.hb-logo-profile {
  display: block;
  position: relative;
  flex: 0 0 37px;
  width: 37px;
  height: 47px;
  margin: 0;
  transform-origin: center bottom;
  transition: transform .3s ease;
}

.hb-logo:hover .hb-logo-profile {
  transform: translateY(-2px);
}

.hb-logo .lf-brand-v4 {
  flex-shrink: 0;
}

.hb-logo-weave {
  display: none !important;
}

.hb-footer .hb-logo {
  gap: 8px;
}

.hb-footer .hb-logo-profile {
  flex-basis: 44px;
  width: 44px;
  height: 54px;
}

@media (max-width: 520px) {
  .hb-logo { gap: 5px; }
  .hb-logo-profile {
    flex-basis: 31px;
    width: 31px;
    height: 40px;
  }
  .hb-footer .hb-logo-profile {
    flex-basis: 39px;
    width: 39px;
    height: 48px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hb-logo-profile { transition: none; }
}


/* LEADSFLO_SONYA_REAL_IMAGE_V1 */
.hb-case-photo {
