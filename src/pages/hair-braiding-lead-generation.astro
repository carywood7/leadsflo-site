<script is:inline>
(()=>{
const header=document.querySelector('.hb-header'),menu=document.querySelector('.hb-menu'),nav=document.getElementById('hb-links');
const close=()=>{nav.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.setAttribute('aria-label','Open navigation')};
menu.addEventListener('click',()=>{const on=nav.classList.toggle('open');menu.setAttribute('aria-expanded',String(on));menu.setAttribute('aria-label',on?'Close navigation':'Open navigation')});
nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});
document.addEventListener('click',e=>{if(nav.classList.contains('open')&&!header.contains(e.target))close()});
let previous=window.scrollY;
window.addEventListener('scroll',()=>{const y=window.scrollY,delta=y-previous;if(y<90||header.contains(document.activeElement)||nav.classList.contains('open'))header.classList.remove('hide');else if(Math.abs(delta)>7)header.classList.toggle('hide',delta>0);previous=y},{passive:true});
const styles={"knotless": ["STYLE / KNOTLESS", "Show the style. Capture the appointment intent.", "Use genuine finished-style photos and clarify size, length, preferred date and any salon preparation requirements."], "boho": ["STYLE / BOHO", "Create demand around a distinct look.", "Demonstrate actual boho work, explain relevant style options and route inquiries into the salon's booking process."], "box": ["STYLE / BOX BRAIDS", "Make the service and next step clear.", "Focus on published service options, length and size preferences, preparation and the customer's desired appointment timing."], "cornrows": ["STYLE / CORNROWS", "A focused service campaign, not a generic salon ad.", "Use real portfolio imagery and service-specific copy. Confirm the intended pattern and appointment requirements with the stylist."], "locs": ["STYLE / LOCS", "Connect specialist interest with the right stylist.", "Explain which loc-related services the salon actually offers and pass style questions requiring expertise to a human stylist."]};
const workflows={"voice": ["INCOMING CALL", "A customer calls about knotless braids.", "Hi, I'm the salon's automated assistant. I can help with booking questions. Which style and date were you considering?", "Incoming call \u2192 style request \u2192 details recorded \u2192 staff callback"], "chat": ["WEBSITE CHAT", "A visitor asks about boho braid appointments.", "I can share the salon's published booking information. Are you looking for a specific date, or would you like the stylist to review your request?", "Website question \u2192 approved FAQ \u2192 booking request \u2192 stylist"], "missed": ["CALL FOLLOW-UP", "The stylist is busy with a customer and misses a call.", "This is an automated message from the salon. We missed your call. Would you prefer to send your hairstyle request or receive a callback?", "Missed call \u2192 permission check \u2192 acknowledgement \u2192 callback task"], "nurture": ["SMS + EMAIL", "A prospective customer has asked about availability.", "Thanks for your interest in the salon. Would you like us to review your preferred style and appointment date?", "Inquiry \u2192 relevant follow-up \u2192 response \u2192 human confirmation"], "booking": ["CALENDAR", "A customer requests an appointment.", "I can help start your booking request. The salon will confirm the service details and available appointment time.", "Request \u2192 calendar review \u2192 confirmed booking \u2192 reminder"]};
function activate(selector,id,data,fields){
const value=data[id];if(!value)return;
document.querySelectorAll(selector).forEach(b=>{
const active=(b.dataset.style||b.dataset.workflow)===id;
b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))
});
fields.forEach(([element,index])=>{document.getElementById(element).textContent=value[index]});
}
document.querySelectorAll('[data-style]').forEach(b=>{
const go=()=>activate('[data-style]',b.dataset.style,styles,[['hb-style-kicker',0],['hb-style-title',1],['hb-style-description',2]]);
b.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')go()});
b.addEventListener('focus',go);b.addEventListener('click',go)
});
document.querySelectorAll('[data-workflow]').forEach(b=>{
const go=()=>activate('[data-workflow]',b.dataset.workflow,workflows,[['hb-ai-kicker',0],['hb-ai-title',1],['hb-ai-response',2],['hb-ai-flow',3]]);
b.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')go()});
b.addEventListener('focus',go);b.addEventListener('click',go)
});
const stages=[
['Reach the right local customer.','Match creative and search intent to the salon location, genuine style portfolio and appointment capacity.'],
['Capture useful booking context.','Understand the requested style, preferred date and relevant preparation requirements without making the form unnecessarily long.'],
['Make follow-up accountable.','Route calls, forms and messages to staff or an appropriately disclosed AI assistant, then record what happened.'],
['Verify the real appointment.','Only count a booking as confirmed when the salon or connected calendar has verified it.']
];
function activateStage(button){
const x=stages[Number(button.dataset.step)];if(!x)return;
document.querySelectorAll('[data-step]').forEach(b=>{const on=b===button;b.classList.toggle('active',on);b.setAttribute('aria-pressed',String(on))});
document.getElementById('hb-step-title').textContent=x[0];document.getElementById('hb-step-description').textContent=x[1]
}
document.querySelectorAll('[data-step]').forEach(b=>{
b.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')activateStage(b)});
b.addEventListener('focus',()=>activateStage(b));
b.addEventListener('click',()=>activateStage(b))
});
document.querySelectorAll('.hb-faqs details').forEach(d=>{
d.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')d.open=true});
d.addEventListener('pointerleave',e=>{if((e.pointerType==='mouse'||e.pointerType==='pen')&&!d.contains(document.activeElement))d.open=false});
d.addEventListener('focusin',()=>{d.open=true})
});
const value=id=>Number(document.getElementById(id).value);
function recalc(){
const n=value('hb-leads'),c=value('hb-contact'),f=value('hb-fit'),a=value('hb-confirm');
for(const [id,v] of [['hb-leads-out',n],['hb-contact-out',c+'%'],['hb-fit-out',f+'%'],['hb-confirm-out',a+'%']])document.getElementById(id).textContent=v;
document.getElementById('hb-reached').textContent=Math.round(n*c/100);
document.getElementById('hb-conversations').textContent=Math.round(n*c*f/10000);
document.getElementById('hb-appointments').textContent=Math.round(n*c*f*a/1000000)
}
['hb-leads','hb-contact','hb-fit','hb-confirm'].forEach(id=>document.getElementById(id).addEventListener('input',recalc));recalc()
})();
</script>

