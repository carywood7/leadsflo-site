    <section class="rf-section rf-resource-preview" id="resources">
      <div class="rf-wrap">
        <p class="rf-eyebrow">FREE ROOFING MARKETING RESOURCES</p>
        <h2>Learn how to win<br /><em>better roofing opportunities.</em></h2>
        <a href="/insights/roofing-lead-generation/"
           class="rf-resource-card">
          <div>
            <strong>Roofing Lead Generation: Complete Guide</strong>
            <p>Advertising, qualification, CRM follow-up and booked estimates.</p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      
        <div class="rf-resource-grid">
<a class="rf-resource-card"
           href="/insights/google-ads-for-roofing-contractors/">
