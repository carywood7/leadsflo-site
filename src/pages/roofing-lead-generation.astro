            <strong>Google Ads for Roofing Contractors: A Practical Guide</strong>
            <p>A practical Google Ads guide for roofing contractors covering search intent, keywords, negative keywords, landing pages, lead quality and booked inspections.</p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
    

        <a class="rf-resource-card"
           href="/insights/facebook-ads-for-roofers/">
          <div>
            <strong>Facebook Ads for Roofers: Generate Better Roofing Leads</strong>
            <p>Facebook and Instagram ads for roofers: creative ideas, Reels, Instant Forms, quote funnels, lead qualification and CRM follow-up for roofing contractors.</p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
    

      <a class="rf-resource-card"
         href="/insights/roofing-marketing-strategy/">
        <div>
          <strong>Roofing Marketing Strategy: How to Grow a Roofing Business</strong>
          <p>A roofing marketing strategy covering local SEO, Google Ads, Facebook Ads, landing pages, reviews, CRM follow-up and qualified inspection bookings.</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    

      <a class="rf-resource-card"
         href="/insights/roofing-lead-costs/">
        <div>
          <strong>Roofing Lead Costs &amp; ROI: What Contractors Should Measure</strong>
          <p>Understand roofing lead costs, cost per qualified lead, cost per booked inspection, customer acquisition cost, ROAS and marketing ROI with practical examples.</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
</div>
    
</div>
    </section>

    <section class="rf-section rf-final" id="book">
      <div class="rf-wrap rf-final-grid">
        <div><p class="rf-eyebrow">FOR ESTABLISHED ROOFING COMPANIES</p><h2>Build a better pipeline of <em>roofing opportunities.</em></h2><p>Let's review your market, current marketing, lead handling, and growth goals.</p></div>
        <a class="rf-button rf-button-dark" href={booking} target="_blank" rel="noopener noreferrer">Book a strategy call ↗</a>
      </div>
    </section>
  </main>

  <footer class="rf-footer">
    <div class="rf-wrap rf-footer-layout">
      <div class="rf-footer-brand">
        <a href="/" class="rf-brand rf-footer-logo" aria-label="LeadsFlo homepage">
        <BrandMark />
        <!-- RF_ROOF_LOGO_V1 -->
        <svg class="rf-logo-roof" viewBox="0 0 58 30"
             aria-hidden="true" focusable="false">
          <path d="M4 23 L29 5 L54 23"
                fill="none"
                stroke="#263746"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"/>
          <path d="M9 23 L29 9 L49 23"
                fill="none"
                stroke="#C66A3D"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"/>
        </svg>
      </a>
        <p>More qualified roofing opportunities.<br />
        Less manual follow-up.</p>
      </div>

      <nav class="rf-footer-nav" aria-label="Footer navigation">
        <a href="#challenge">The problem</a>
        <a href="#system">The system</a>
        <a href="#qualification">Qualification</a>
        <a href="#calculator">Revenue Calculator</a>
        <a href="#questions">FAQs</a>
        <a href="#book">Book a call</a>
      </nav>

      <div class="rf-footer-meta">
        <span>© {new Date().getFullYear()} LeadsFlo</span>
        <a href="/privacy-policy/">Privacy</a>
      </div>
    </div>
  </footer>

  <script define:vars={{ stages }}>
    const buttons = document.querySelectorAll(".rf-stage");
    const count = document.getElementById("rf-stage-number");
    const title = document.getElementById("rf-stage-title");
    const description = document.getElementById("rf-stage-description");


    function activateStage(button) {
      const index = Number(button.dataset.stage);
      if (!Number.isInteger(index) || !stages[index]) return;
      buttons.forEach(item =>
        item.setAttribute("aria-pressed", String(item === button))
      );
      count.textContent = `STEP ${String(index + 1).padStart(2, "0")} / 04`;
      title.textContent = stages[index].title;
      description.textContent = stages[index].detail;
    }

    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    buttons.forEach(button => {
      button.addEventListener("click", () => activateStage(button));
      button.addEventListener("focus", () => activateStage(button));
      if (canHover) {
        button.addEventListener("pointerenter", () => activateStage(button));
      }
    });

    const value = document.getElementById("rf-value");
    const leads = document.getElementById("rf-leads");
    const close = document.getElementById("rf-close");
    const money = number => new Intl.NumberFormat("en-US", {
      style: "currency", currency: "USD", maximumFractionDigits: 0
    }).format(number);

    function calculate() {
      const jobs = Number(leads.value) * Number(close.value) / 100;
      document.getElementById("rf-value-output").textContent = money(Number(value.value));
      document.getElementById("rf-leads-output").textContent = leads.value;
      document.getElementById("rf-close-output").textContent = `${close.value}%`;
      document.getElementById("rf-projects").textContent = jobs.toLocaleString("en-US", {maximumFractionDigits: 1});
      document.getElementById("rf-sales").textContent = money(jobs * Number(value.value));
    }

    [value, leads, close].forEach(input => input.addEventListener("input", calculate));
    calculate();

    const roofingProjects = [
      {
        title: "Residential roof replacement",
        description: "Identify the property owner and collect project details before routing an inspection request to an estimator.",
        questions: [
          "Property ownership and location",
          "Roof age and replacement requirements",
          "Project timeframe and inspection availability"
        ]
      },
      {
        title: "Commercial roofing",
        description: "Gather building, decision-maker and procurement information so the inquiry reaches the right commercial roofing team.",
        questions: [
          "Building type and approximate roof size",
          "Decision-maker and roofing system",
          "Scope of work and procurement timeline"
        ]
      },
      {
        title: "Storm damage inspection",
        description: "Prioritize relevant damage inquiries based on geography, urgency and the information needed for an appropriate inspection.",
        questions: [
          "Property address and affected areas",
          "When damage was discovered",
          "Urgency and preferred inspection time"
        ]
      }
    ];

    const projectButtons = document.querySelectorAll(".rf-project-type");
    const roofTitle = document.getElementById("rf-roof-title");
    const roofDescription = document.getElementById("rf-roof-description");
    const roofQuestions = document.getElementById("rf-roof-questions");

    function activateProject(button) {
      const index = Number(button.dataset.roofType);
      const project = roofingProjects[index];
      if (!project) return;

      projectButtons.forEach(item =>
        item.setAttribute("aria-pressed", String(item === button))
      );

      roofTitle.textContent = project.title;
      roofDescription.textContent = project.description;

      roofQuestions.replaceChildren(
        ...project.questions.map(question => {
          const item = document.createElement("span");
          item.textContent = question;
          return item;
        })
      );
    }

    projectButtons.forEach(button => {
      button.addEventListener("click", () => activateProject(button));
      button.addEventListener("focus", () => activateProject(button));
      if (canHover) {
        button.addEventListener("pointerenter", () => activateProject(button));
      }
    });

    // Native details remain clickable on mobile and keyboard accessible.
    // Desktop pointer hover opens the FAQ drawer automatically.
    if (canHover) {
      document.querySelectorAll(".rf-question").forEach(drawer => {
        drawer.addEventListener("pointerenter", () => {
          drawer.open = true;
        });
        drawer.addEventListener("pointerleave", () => {
          drawer.open = false;
        });
      });
    }

  </script>

<script is:inline>
(() => {
  const header = document.querySelector(
    "body.roofing-page .rf-header"
  );

  if (!header) return;

  const toggle = header.querySelector(".rf-menu-toggle");
  const nav = header.querySelector("#rf-mobile-section-nav");
  const mobile = window.matchMedia("(max-width: 700px)");

  if (!toggle || !nav) return;

  let lastY = window.scrollY;

  const closeMenu = () => {
    header.classList.remove("rf-menu-open");
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute(
      "aria-label", "Open section navigation"
    );

    toggle.querySelector(".rf-menu-label").textContent = "Menu";
    toggle.querySelector(".rf-menu-icon").textContent = "☰";
  };

  toggle.addEventListener("click", () => {
    const open = !header.classList.contains("rf-menu-open");

    header.classList.toggle("rf-menu-open", open);
    header.classList.remove("rf-header-hidden");

    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute(
      "aria-label",
      open ? "Close section navigation" : "Open section navigation"
    );

    toggle.querySelector(".rf-menu-label").textContent =
      open ? "Close" : "Menu";

    toggle.querySelector(".rf-menu-icon").textContent =
      open ? "×" : "☰";
  });

  nav.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener("click", () => {
      closeMenu();
      header.classList.remove("rf-header-hidden");
    });
  });

  window.addEventListener("scroll", () => {
    const currentY = window.scrollY;

    if (header.classList.contains("rf-menu-open")) {
      lastY = currentY;
      return;
    }

    if (currentY < 85) {
      header.classList.remove("rf-header-hidden");
      lastY = currentY;
      return;
    }

    const movement = currentY - lastY;

    if (Math.abs(movement) < 6) return;

    if (movement > 0 && currentY > 160) {
      header.classList.add("rf-header-hidden");
    } else if (movement < 0) {
      header.classList.remove("rf-header-hidden");
    }

    lastY = currentY;
  }, { passive: true });

  mobile.addEventListener("change", () => {
    closeMenu();
    header.classList.remove("rf-header-hidden");
    lastY = window.scrollY;
  });

  document.addEventListener("keydown", event => {
    if (event.key === "Escape" &&
        header.classList.contains("rf-menu-open")) {
      closeMenu();
      toggle.focus();
    }
  });

  document.addEventListener("click", event => {
    if (
      header.classList.contains("rf-menu-open") &&
      !header.contains(event.target)
    ) {
      closeMenu();
    }
  });
})();
</script>

