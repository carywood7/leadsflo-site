---
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";

const booking = "https:" + "//calendar.app.google/1fpawLr6fgP7Hmoi7";

const stages = [
  {
    title: "Attract",
    label: "Google & Meta Ads",
    detail: "Reach property owners searching for roofing services, and introduce relevant offers to homeowners considering replacements."
  },
  {
    title: "Qualify",
    label: "Project-specific funnels",
    detail: "Capture location, property type, roofing requirements, project timeline, and the information your sales team needs."
  },
  {
    title: "Route",
    label: "CRM & automation",
    detail: "Organize inquiries, notify the right team members, track lead sources, and manage follow-up without losing context."
  },
  {
    title: "Book",
    label: "Inspections & estimates",
    detail: "Help qualified prospects schedule their next conversation or inspection while giving estimators useful project details."
  }
];

const questions = [
  {
    q: "Do you sell shared roofing leads?",
    a: "Our focus is building dedicated marketing and conversion systems for roofing businesses, rather than reselling shared contact lists."
  },
  {
    q: "Can you work with our existing CRM?",
    a: "Yes. We can assess your existing CRM, calendar, call handling, and estimating process before recommending changes."
  },
  {
    q: "Do you support commercial roofing?",
    a: "Yes. Commercial roofing generally requires different targeting, qualification, and a longer sales process."
  },
  {
    q: "Do you guarantee roofing jobs?",
    a: "No. Results depend on market conditions, campaign performance, budget, follow-up, pricing, and the sales process."
  }
];

const url = "https:" + "//leadsflo.co/roofing-lead-generation/";

const roofServices = [
  ["◉", "Google Ads"],
  ["✦", "Facebook & Instagram Ads"],
  ["▶", "Video Ads & Reels"],
  ["⌂", "Roofing Lead Generation"],
  ["▤", "Roofing Quote Funnels"],
  ["◇", "Lead Qualification"],
  ["▦", "Inspection Booking"],
  ["✉", "Email & SMS Follow-Up"],
  ["↗", "CRM & Attribution"]
];

---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#263746" />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href={url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Roofing Lead Generation Company | Qualified Leads – LeadsFlo</title>
  <meta name="description" content="Roofing lead generation for U.S. contractors. Get qualified inquiries with Google Ads, Meta Ads, roofing quote funnels, CRM follow-up and inspection booking." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Roofing Lead Generation Company | Qualified Leads – LeadsFlo" />
  <meta property="og:description" content="A connected marketing system for roofing businesses, from qualified inquiries to booked inspections." />
  <meta property="og:url" content={url} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Roofing Lead Generation",
    serviceType: "Roofing marketing, lead qualification and CRM automation",
    provider: {
      "@type": "Organization",
      name: "LeadsFlo",
      url: "https://leadsflo.co/"
    },
    areaServed: { "@type": "Country", name: "United States" },
    audience: {
      "@type": "BusinessAudience",
      audienceType: "Established roofing contractors"
    }
  })} />
</head>

<body class="roofing-page">
  <header class="rf-header">
    <div class="rf-wrap rf-nav">
      <a href="/" class="rf-brand" aria-label="LeadsFlo homepage">
        <BrandMark />
        <!-- RF_ROOF_LOGO_V1 -->
        <svg class="rf-logo-roof" viewBox="0 0 58 30"
             aria-hidden="true" focusable="false">
          <path d="M4 23 L29 5 L54 23"
                fill="none"
                stroke="#263746"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"/>
          <path d="M9 23 L29 9 L49 23"
                fill="none"
                stroke="#C66A3D"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"/>
        </svg>
      </a>
      
      <!-- RF_COMPACT_MOBILE_HEADER_V2 -->
      <button
        type="button"
        class="rf-menu-toggle"
        aria-label="Open section navigation"
        aria-controls="rf-mobile-section-nav"
        aria-expanded="false"
      >
        <span class="rf-menu-icon" aria-hidden="true">☰</span>
        <span class="rf-menu-label">Menu</span>
      </button>

      <nav
        id="rf-mobile-section-nav"
        aria-label="Roofing page navigation"
      >
        <a href="#challenge">The problem</a>
        <a href="#system">The system</a>
        <a href="#qualification">Qualification</a>
        <a href="#calculator">Revenue Calculator</a>
        <a href="#questions">FAQs</a>
      </nav>
      <a href={booking} class="rf-button rf-button-small" target="_blank" rel="noopener noreferrer">
        Book a strategy call ↗
      </a>
    </div>
  </header>

  <!-- RF_MOBILE_FIX_V1 -->
  <div class="rf-mobile-booking">
    <a
      href={booking}
      target="_blank"
      rel="noopener noreferrer"
      class="rf-mobile-booking-link"
      aria-label="Book a roofing strategy call"
    >
      <span>Book a strategy call</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>


  <main>
    <section class="rf-hero">
      <div class="rf-wrap rf-hero-grid">
        <div class="rf-hero-copy">
          <p class="rf-eyebrow">FOR ESTABLISHED U.S. ROOFING COMPANIES</p>
          <h1>Better roofing leads.<br /><em>More serious opportunities.</em></h1>
          <p class="rf-lede">
            More inquiries mean little if they never become estimates.
            We connect Google Ads, Meta Ads, qualified quote funnels,
            CRM automation and appointment booking to help roofing
            companies turn interest into sales opportunities.
          </p>
          <div class="rf-actions">
            <a class="rf-button" href={booking} target="_blank" rel="noopener noreferrer">
              Discuss your growth plan ↗
            </a>
            <a class="rf-text-link" href="#system">Explore the system ↓</a>
          </div>
          <p class="rf-disclaimer">Built for growth-minded roofing businesses. No shared lead lists or invented campaign results.</p>
        </div>

        <div class="rf-hero-visual">
          <div class="rf-visual-top">
            <span>ROOFING / GROWTH SYSTEM</span>
            <span>RF—001</span>
          </div>

          <img class="rf-hero-photo"
            src="/images/roofing/installation.jpg"
            width="1400"
            height="933"
            alt="Professional roofing contractor installing shingles on a residential roof"
            fetchpriority="high" />

          <div class="rf-visual-card">
            <small>LEAD FLOW / DEMONSTRATION</small>
            <strong>Qualified inquiry</strong>
            <span><i></i> Ready for estimator review</span>
            <div class="rf-progress"><b></b></div>
          </div>

          <div class="rf-visual-bottom">
            <span>PRECISION OVER VOLUME.</span>
            <span>LEADSFLO</span>
          </div>
        </div>
      </div>
    </section>


    <!-- RF_NAV_MARQUEE_V4 -->
    <section class="rf-service-marquee" aria-label="Roofing marketing capabilities">
      <div class="rf-marquee-title">
        FROM AD TO INSPECTION · ONE CONNECTED SYSTEM
      </div>
      <div class="rf-marquee-viewport" tabindex="0">
        <div class="rf-marquee-track">
          {Array.from({length: 2}, (_, group) => (
            <div class="rf-marquee-group" aria-hidden={group === 1 ? "true" : undefined}>
              {roofServices.map(([symbol, label]) => (
                <span class="rf-marquee-item">
                  <span aria-hidden="true">{symbol}</span>
