 },{passive:true});

  const programs={
    injury:['01','⚖','Personal Injury','Reach people searching for matters your firm handles and make it easy to connect with intake staff.','Local practice-area pages, relevant search campaigns and eligible local ad options','Location, matter category and preferred callback details','Authorized staff reviews the lead and determines next steps'],
    family:['02','◇','Family Law','Present clear, respectful information to people looking for family-law services.','Local SEO, practice-area search ads and clear consultation pages','Service area, type of legal help sought and safe contact preferences','Private consultation request routed to a designated staff member'],
    immigration:['03','◎','Immigration Law','Help prospective clients understand which services your firm offers and how to contact staff.','Service-specific search intent, language-appropriate creative when supported','Service type, location and preferred language where appropriate','Staff-reviewed inquiry with clear next-step communication'],
    defense:['04','◆','Criminal Defense','Offer accessible contact options for people researching relevant legal assistance.','High-intent geographic search, clear phone-first contact paths','Practice area, service region and urgency without sensitive details in analytics','Timely human escalation for intake review'],
    estate:['05','✧','Estate Planning','Build trust with clear educational content and relevant consultation pathways.','Local SEO, topic-led content and focused consultation pages','Service interest, geographic fit and preferred appointment window','Staff-led planning consultation request'],
    business:['06','▣','Business Law','Connect decision-makers with relevant advisory and commercial legal services.','Business-service content, intent-led search and considered follow-up','Organization needs, general service category and contact details','Consultative discovery call with authorized firm personnel']
  };
 const pids=['ed-program-number','ed-program-symbol','ed-program-title','ed-program-description','ed-program-ads','ed-program-fit','ed-program-action'];
 function setProgram(key){
   if(!programs[key])return;
   programs[key].forEach((v,i)=>document.getElementById(pids[i]).textContent=v);
   document.querySelectorAll('[data-program]').forEach(btn=>{
     const selected=btn.dataset.program===key;
     btn.classList.toggle('active',selected);btn.setAttribute('aria-pressed',String(selected));
   });
 }
 document.querySelectorAll('[data-program]').forEach(btn=>{
   btn.addEventListener('click',()=>setProgram(btn.dataset.program));
   btn.addEventListener('focus',()=>setProgram(btn.dataset.program));
   btn.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')setProgram(btn.dataset.program)});
 });

  const stages=[
    ['STAGE 01 / ATTRACT','Get found for the legal services your firm actually provides.','Local SEO, practice-area pages and carefully targeted search ads help potential clients discover relevant information.','Relevant visits, calls and qualified search intent'],
