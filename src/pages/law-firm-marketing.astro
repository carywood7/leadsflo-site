---
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";
import "../styles/navigation.css";

const booking = "https://calendar.app.google/1fpawLr6fgP7Hmoi7";

const faq = [
  {q:"What does a law firm marketing agency do?",a:"A law firm marketing agency helps attorneys get found, attract relevant leads and turn calls or form submissions into organized consultation opportunities using search marketing, landing pages and intake workflows."},
  {q:"How does LeadsFlo generate leads for lawyers?",a:"We tailor local SEO, Google Ads, landing pages and follow-up to a firm's actual practice areas, service geography and intake process. Campaign results and client suitability depend on the firm and market."},
  {q:"Can you market personal injury, family law and immigration practices?",a:"We can tailor campaigns for different practice areas, including personal injury, family law, immigration, criminal defense, estate planning and business law, subject to jurisdiction-specific advertising review."},
  {q:"Can AI answer calls and qualify legal leads?",a:"AI can handle approved routine information and callback requests, but sensitive case details, conflict checks, legal advice and representation decisions must stay with authorized law firm personnel."},
  {q:"Do you guarantee leads or signed cases?",a:"No. We focus on relevant traffic, clear lead capture and accountable intake reporting. Lead volume, case acceptance and signed clients depend on many factors beyond marketing."},
  {q:"What should a law firm measure beyond cost per lead?",a:"Measure eligible leads, reached contacts, consultation requests, completed consultations and firm-verified new-client matters when appropriate. Keep ad-platform events separate from confidential intake records."}
];

const schema = {
  "@context":"https://schema.org",
  "@graph":[
    {"@type":"Organization","@id":"https://leadsflo.co/#organization","name":"LeadsFlo","url":"https://leadsflo.co/"},
    {"@type":"WebPage","@id":"https://leadsflo.co/law-firm-marketing/#webpage","url":"https://leadsflo.co/law-firm-marketing/","name":"Law Firm Marketing Agency | LeadsFlo","description":"SEO, Google Ads, legal lead generation, conversion-focused landing pages and responsible intake automation for US law firms."},
    {"@type":"Service","name":"Law Firm Marketing and Lead Generation","serviceType":"SEO, local search, paid advertising, websites, legal intake workflows and CRM follow-up","provider":{"@id":"https://leadsflo.co/#organization"},"areaServed":{"@type":"Country","name":"United States"},"url":"https://leadsflo.co/law-firm-marketing/"},
    {"@type":"FAQPage","mainEntity":faq.map(x=>({"@type":"Question","name":x.q,"acceptedAnswer":{"@type":"Answer","text":x.a}}))}
  ]
};

const guides = [
  ["law-firm-seo","Law firm SEO","Local visibility, practice-area content and search intent"],
  ["google-ads-for-law-firms","Google Ads for law firms","Campaign structure, geography and lead quality"],
  ["law-firm-lead-generation","Law firm lead generation","From lead capture to qualified consultations"],
  ["ai-receptionist-for-law-firms","AI receptionist for law firms","Responsible call handling and staff handoffs"],
  ["law-firm-marketing-strategies","Law firm marketing strategies","SEO, paid campaigns and client acquisition"]
];
