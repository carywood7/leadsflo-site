 .ed-automation-grid,.ed-guides,.ed-footer-grid{grid-template-columns:1fr}
 .ed-automation-demo{padding:20px}
 .ed-chat-user,.ed-chat-bot{max-width:100%}
 .ed-planner-result{padding:23px}
 .ed-experience-number{font-size:95px}
 .ed-footer{padding-bottom:90px}
 .ed-footer-bottom{flex-direction:column}
 .ed-mobile-cta{display:flex;align-items:center;justify-content:center;position:fixed;z-index:90;bottom:0;left:0;right:0;min-height:60px;padding:12px 18px calc(12px + env(safe-area-inset-bottom));background:#f0c785;color:#17314b;text-align:center;text-decoration:none;font-weight:850;font-size:14px;box-shadow:0 -10px 30px #03182f2c}
 .ed-page{padding-bottom:60px}
}
