/* LEGAL_ATMOSPHERE_V1 — subtle architectural environment */
#practices,#planner,.ed-close{
  position:relative;
  overflow:hidden;
  isolation:isolate;
}

#practices>.ed-wrap,
#planner>.ed-wrap,
.ed-close>.ed-wrap{
  position:relative;
  z-index:2;
}

#practices{
  background-color:#f8fafc;
  background-image:
    linear-gradient(#167e9910 1px,transparent 1px),
    linear-gradient(90deg,#167e9910 1px,transparent 1px);
  background-size:56px 56px;
}

#planner{
  background-image:
    radial-gradient(circle at 95% 15%,#a9dfed25,transparent 35%),
    linear-gradient(#167e990b 1px,transparent 1px),
    linear-gradient(90deg,#167e990b 1px,transparent 1px);
  background-size:auto,48px 48px,48px 48px;
}

.ed-atmosphere{
  position:absolute;
  display:block;
  pointer-events:none;
  user-select:none;
  z-index:0;
  transition:opacity .7s ease,translate 1.4s ease;
}

.ed-atmosphere-drift{
  transform-origin:center;
  animation:edAcademicBreathe 18s ease-in-out infinite alternate;
}

.ed-atmosphere-program{
  width:min(28vw,320px);
  right:-75px;
  top:8%;
  color:#167f9c;
  opacity:.12;
}

.ed-atmosphere-planner{
  width:min(33vw,400px);
  right:-110px;
  bottom:1%;
  color:#2487a2;
  opacity:.10;
}

.ed-close{
  background:
    radial-gradient(ellipse at 82% 55%,#3a75912b,transparent 48%),
    linear-gradient(135deg,#143d5e,#0a203a);
}

.ed-atmosphere-campus{
  width:min(43vw,520px);
  right:-45px;
  bottom:0;
  color:#9bd9e5;
  opacity:.13;
}

#practices:hover .ed-atmosphere-program{
  translate:-8px -4px;
  opacity:.18;
}

#planner:hover .ed-atmosphere-planner{
  translate:-8px -5px;
  opacity:.15;
}

.ed-close:hover .ed-atmosphere-campus{
  translate:-8px 0;
  opacity:.19;
}

@keyframes edAcademicBreathe{
  from{transform:translateY(0) rotate(0deg)}
  to{transform:translateY(-9px) rotate(2deg)}
}

@media(max-width:850px){
  .ed-atmosphere-program{width:200px;right:-85px;opacity:.08}
  .ed-atmosphere-planner{width:230px;right:-100px;opacity:.07}
  .ed-atmosphere-campus{width:280px;right:-90px;opacity:.08}
}

@media(prefers-reduced-motion:reduce){
  .ed-atmosphere,
  .ed-atmosphere-drift{
    animation:none!important;
    transition:none!important;
    translate:none!important;
    transform:none!important;
  }
}

/* LAW_FIRM_THEME_V1 — brass / slate / ivory; scoped to Legal page */
