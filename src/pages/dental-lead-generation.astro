  <script is:inline defer src="/js/leadsflo-conversions.js"></script>
  <script is:inline>
  (()=>{
    const nav=document.querySelector('.d-menu'),toggle=document.querySelector('.d-hamb'),header=document.querySelector('.d-top');
    const close=()=>{nav?.classList.remove('open');toggle?.setAttribute('aria-expanded','false');toggle?.setAttribute('aria-label','Open navigation')};
    toggle?.addEventListener('click',()=>{const open=nav.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Close navigation':'Open navigation')});
    nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});document.addEventListener('click',e=>{if(nav?.classList.contains('open')&&!header.contains(e.target))close()});
    let last=window.scrollY;window.addEventListener('scroll',()=>{let y=window.scrollY,dy=y-last;if(y<90||header.contains(document.activeElement)||nav.classList.contains('open'))header.classList.remove('hide');else if(Math.abs(dy)>7)header.classList.toggle('hide',dy>0);last=y},{passive:true});
    const services={implants:['CAMPAIGN PATH / IMPLANTS','High-consideration consultations','Match treatment research intent with educational, accurate information and an easy way to request a professional assessment.','Service interest, preferred location, contact permission and a trackable consultation-request workflow—without sending sensitive clinical information to ad platforms.'],cosmetic:['CAMPAIGN PATH / COSMETIC','Informed cosmetic inquiries','Use clear, permissioned creative and focused pages to explain consultation options for aligners, veneers or other aesthetic services.','A well-contextualized request, practice location preference and a responsible front-desk next step.'],general:['CAMPAIGN PATH / GENERAL','Local new-patient demand','Connect location-specific searches with office details, practical service pages and a straightforward new-patient request.','Correct practice location, appointment interest and a clear response task.'],multi:['CAMPAIGN PATH / MULTI-LOCATION','Right location, right team','Route ads, calls and web inquiries to the appropriate clinic, with distinct reporting for each service area.','Source-aware inquiry records and a clear owner for each location.']};
    const svc=document.querySelectorAll('[data-service]');function showService(id){svc.forEach(b=>{b.classList.toggle('active',b.dataset.service===id);b.setAttribute('aria-pressed',String(b.dataset.service===id))});const x=services[id];if(!x)return;['d-service-kicker','d-service-title','d-service-copy','d-service-result'].forEach((k,i)=>document.getElementById(k).textContent=x[i])}svc.forEach(b=>{b.addEventListener('click',()=>showService(b.dataset.service));b.addEventListener('mouseenter',()=>showService(b.dataset.service));b.addEventListener('focus',()=>showService(b.dataset.service))});showService('implants');
    const stages=[['Start with relevant intent','Separate implant consultation searches, cosmetic treatment interests and routine local appointment demand. Send each group to the right message and next step.','STAGE 01 / INQUIRY'],['Ask only what is needed','Capture a service interest, appropriate contact permission, practice location and contact preference. Avoid requesting detailed dental or medical history in advertising forms.','STAGE 02 / REQUEST'],['Assign an accountable follow-up','Route the inquiry to the correct front desk; acknowledge receipt, make a responsible contact attempt and record whether the practice reached the person.','STAGE 03 / FOLLOW-UP'],['Check actual appointment status','Record a confirmed consultation only when the practice scheduling system or team has verified the booking. A calendar link click is not a booking.','STAGE 04 / CONFIRMATION']];const steps=document.querySelectorAll('[data-step]');function showStage(n){steps.forEach(b=>{b.classList.toggle('active',Number(b.dataset.step)===n);b.setAttribute('aria-pressed',String(Number(b.dataset.step)===n))});const x=stages[n];document.getElementById('d-path-title').textContent=x[0];document.getElementById('d-path-copy').textContent=x[1];document.getElementById('d-path-status').textContent=x[2]}steps.forEach(b=>{const f=()=>showStage(Number(b.dataset.step));b.addEventListener('click',f);b.addEventListener('mouseenter',f);b.addEventListener('focus',f)});showStage(0);
    const val=id=>Number(document.getElementById(id).value);function calculate(){const n=val('d-inquiries'),c=val('d-contact'),b=val('d-book'),s=val('d-show');[['d-inquiries-out',n],['d-contact-out',c+'%'],['d-book-out',b+'%'],['d-show-out',s+'%']].forEach(([id,v])=>document.getElementById(id).textContent=v);const contacted=Math.round(n*c/100),booked=Math.round(n*c*b/10000),attended=Math.round(n*c*b*s/1000000);document.getElementById('d-contacted-result').textContent=contacted;document.getElementById('d-booked-result').textContent=booked;document.getElementById('d-attended-result').textContent=attended}['d-inquiries','d-contact','d-book','d-show'].forEach(id=>document.getElementById(id)?.addEventListener('input',calculate));calculate();
    document.querySelectorAll('.d-faqs details').forEach(d=>d.addEventListener('mouseenter',()=>{if(window.matchMedia('(hover:hover)').matches)d.open=true}));
  })();
  </script>
</body></html>
