import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";
const booking = "https://calendar.app.google/1fpawLr6fgP7Hmoi7";
const articles = [
  ["Dental lead generation", "/insights/dental-lead-generation/", "Build a consistent path from search to qualified consultations."],
  ["Google Ads for dentists", "/insights/google-ads-for-dentists/", "Separate high-intent treatments, local search and measurable inquiries."],
  ["Dental implant marketing", "/insights/dental-implant-marketing/", "Improve implant inquiry quality without promising clinical outcomes."]
];
const faqs = [
  ["How do you generate dental leads?", "We combine relevant search campaigns, suitable Meta creative, focused landing pages, CRM follow-up and a clear consultation-request process. We separate new-patient demand from implant or cosmetic interests."],
  ["Can you promote dental implants?", "We can help plan implant-related marketing with appropriate, accurate messaging. The treating dental professional decides clinical suitability after an individual assessment; ads must not promise eligibility or outcomes."],
  ["Do you work with one practice or multiple locations?", "Both are possible. We recommend location-specific targeting, appointment ownership and reporting so each practice can see where requests originate."],
  ["Do you guarantee patient appointments?", "No. We can measure and improve inquiry quality, response workflows and consultation booking, but no responsible marketing provider can guarantee appointments or treatment decisions."],
  ["Can we keep our existing practice-management software?", "Usually we begin by evaluating your existing tools and available integrations. Patient information should move only through authorized and appropriately secured systems."],
  ["How do we measure lead quality?", "Track valid inquiries, reached contacts, requested consultations, confirmed appointments and attended consultations where the practice can reliably provide that information. Keep clinical details separate from ad platform reporting."]
];
const schema = {"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://leadsflo.co/#organization", "name": "LeadsFlo", "url": "https://leadsflo.co/", "description": "Performance marketing, lead generation, conversion funnels, CRM automation and appointment-setting services."}, {"@type": "WebPage", "@id": "https://leadsflo.co/dental-lead-generation/#webpage", "url": "https://leadsflo.co/dental-lead-generation/", "name": "Dental Marketing Agency & Lead Generation | LeadsFlo", "description": "Dental marketing for US dental practices, including Google Ads, Meta Ads, consultation funnels and CRM follow-up.", "inLanguage": "en-US", "isPartOf": {"@type": "WebSite", "name": "LeadsFlo", "url": "https://leadsflo.co/"}, "about": {"@id": "https://leadsflo.co/dental-lead-generation/#service"}}, {"@type": "Service", "@id": "https://leadsflo.co/dental-lead-generation/#service", "name": "Dental Marketing and Lead Generation", "serviceType": "Dental practice marketing and consultation lead generation", "url": "https://leadsflo.co/dental-lead-generation/", "provider": {"@id": "https://leadsflo.co/#organization"}, "areaServed": {"@type": "Country", "name": "United States"}, "audience": {"@type": "BusinessAudience", "audienceType": "Dental practices, dental implant clinics and multi-location dental groups"}, "description": "Google Ads, Meta Ads, patient inquiry funnels, lead qualification, CRM follow-up and consultation-request workflows for dental practices.", "hasOfferCatalog": {"@type": "OfferCatalog", "name": "Dental marketing capabilities", "itemListElement": [{"@type": "OfferCatalog", "name": "Dental implant marketing"}, {"@type": "OfferCatalog", "name": "Cosmetic dentistry marketing"}, {"@type": "OfferCatalog", "name": "General dentistry lead generation"}, {"@type": "OfferCatalog", "name": "Multi-location dental marketing"}]}}, {"@type": "BreadcrumbList", "@id": "https://leadsflo.co/dental-lead-generation/#breadcrumbs", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://leadsflo.co/"}, {"@type": "ListItem", "position": 2, "name": "Industries", "item": "https://leadsflo.co/industries/"}, {"@type": "ListItem", "position": 3, "name": "Dental Marketing", "item": "https://leadsflo.co/dental-lead-generation/"}]}]};
schema['@graph'].push({'@type':'FAQPage','@id':'https://leadsflo.co/dental-lead-generation/#faq','mainEntity':faqs.map(([question,answer])=>({'@type':'Question','name':question,'acceptedAnswer':{'@type':'Answer','text':answer}}))});
