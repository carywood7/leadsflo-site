      <label for="ed-applications">Reached prospects who apply <output id="ed-applications-label">25%</output></label>
      <input id="ed-applications" type="range" min="5" max="80" step="5" value="25"/>
    </div>
  </div>
  <div class="ed-planner-result" aria-live="polite">
    <span>HYPOTHETICAL MONTHLY MODEL</span>
