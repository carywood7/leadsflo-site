---
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";
import "../styles/navigation.css";

const booking = "https://calendar.app.google/1fpawLr6fgP7Hmoi7";

const faq = [
  {
    q: "What does an education marketing agency do?",
    a: "An education marketing agency helps institutions attract relevant prospective students, explain programs clearly and move inquiries through admissions conversations, applications and enrollment tracking."
  },
  {
    q: "Can LeadsFlo support coding bootcamps and vocational schools?",
    a: "Yes. We can adapt campaigns and enrollment workflows for bootcamps, vocational and career training, colleges, universities, continuing education and online programs."
  },
  {
    q: "Do you use Google Ads or Meta Ads for enrollment?",
    a: "Both can be useful. Google Ads captures active program-search intent, while Meta can introduce relevant programs to audiences researching their next step. Strategy depends on the program and applicant profile."
  },
  {
    q: "Can AI handle admissions calls and inquiries?",
    a: "AI assistants can answer approved routine questions, collect inquiry details and help with scheduling or human handoff. They should not make admission, funding or eligibility decisions."
  },
  {
    q: "Do you guarantee student enrollments?",
    a: "No. We can build and optimize marketing and follow-up systems, but enrollment depends on program fit, admissions decisions, tuition, availability and other institutional factors."
  },
  {
    q: "How do you measure qualified student inquiries?",
    a: "We separate initial inquiries from reached contacts, program-fit conversations, consultations, applications and verified enrollments, subject to available CRM data and appropriate attribution."
  }
];

const schema = {
  "@context":"https://schema.org",
  "@graph":[
    {
      "@type":"Organization",
      "@id":"https://leadsflo.co/#organization",
      "name":"LeadsFlo",
      "url":"https://leadsflo.co/"
    },
    {
      "@type":"Service",
      "name":"Education Marketing and Student Lead Generation",
      "serviceType":"Performance marketing, enrollment funnels and admissions follow-up",
      "provider":{"@id":"https://leadsflo.co/#organization"},
      "areaServed":{"@type":"Country","name":"United States"},
      "url":"https://leadsflo.co/education-lead-generation/"
    },
    {
      "@type":"FAQPage",
      "mainEntity":faq.map(x=>({
        "@type":"Question",
        "name":x.q,
        "acceptedAnswer":{"@type":"Answer","text":x.a}
      }))
    }
  ]
};

const guides = [
  ["education-lead-generation","Education lead generation","From campaign to qualified inquiry"],
  ["google-ads-for-education","Google Ads for education","Program intent, keywords and conversions"],
  ["student-enrollment-marketing","Student enrollment strategies","Move beyond lead volume"],
  ["ai-admissions-assistants","AI admissions assistants","Responsive inquiry handling with human oversight"]
];
