---
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";

const booking = "https://calendar.app.google/1fpawLr6fgP7Hmoi7";
const canonical = "https://leadsflo.co/hvac-lead-generation/";
const offerings = [
  { n:"01",tag:"INTENT",name:"Google Ads for HVAC",desc:"Capture local searches for AC repairs, heating service, replacements and installation estimates." },
  { n:"02",tag:"DEMAND",name:"Meta Ads & Creative",desc:"Build awareness for seasonal offers, replacement consultations and maintenance programs." },
  { n:"03",tag:"CONVERSION",name:"Websites & Funnels",desc:"Turn visits into service inquiries with clear offers, mobile-first pages and practical lead qualification." },
  { n:"04",tag:"FOLLOW-THROUGH",name:"CRM & Appointment Setting",desc:"Organize inquiries, notify the right people and support follow-up through to booked conversations." },
];
const stages = [
  {n:"01",label:"Attract",tag:"LOCAL DEMAND",title:"Reach people who need the services you actually provide.",body:"Search and social campaigns should reflect your service area, available capacity and the difference between urgent repair and planned replacement work.",points:["Service-specific search intent","Location and coverage targeting","Relevant seasonal messaging"],outcome:"RELEVANT TRAFFIC"},
  {n:"02",label:"Capture",tag:"CONVERSION",title:"Give each visitor the right next step.",body:"A repair inquiry, a replacement estimate and a commercial installation need different offers. Dedicated landing pages make that choice easier.",points:["Mobile-ready forms and calls","Clear offer and service details","Campaign-to-page consistency"],outcome:"NEW INQUIRY"},
  {n:"03",label:"Qualify",tag:"JOB CONTEXT",title:"Know what kind of HVAC opportunity just came in.",body:"Capture service, ZIP code, property type and urgency without asking visitors to conduct technical diagnostics themselves.",points:["Service area and property type","Repair or replacement need","Urgency and timeline"],outcome:"QUALIFIED LEAD"},
  {n:"04",label:"Follow up",tag:"CRM OPERATIONS",title:"Make the next action visible to your team.",body:"Route leads into a CRM, identify the source and support timely, appropriate responses so inquiries do not disappear into an inbox.",points:["Lead ownership","Notifications and reminders","Source-to-outcome visibility"],outcome:"ACTIVE OPPORTUNITY"},
  {n:"05",label:"Book",tag:"SALES HANDOFF",title:"Move suitable inquiries into real appointments.",body:"Support the transition from a campaign inquiry to a service call, site assessment or installation estimate with clear responsibility and follow-through.",points:["Scheduling coordination","Appointment confirmation","Prepared sales handoff"],outcome:"BOOKED CONVERSATION"},
];
const faqs = [
 {q:"How does HVAC lead generation work?",a:"We connect targeted advertising and organic demand with landing pages, lead qualification, CRM follow-up and appointment-setting processes. Each campaign is adapted to the HVAC company's services and service area."},
 {q:"Can we target repairs and replacements separately?",a:"Yes. Emergency repairs, system replacements and maintenance have different economics and buyer intent. We normally recommend separate targeting, offers and measurement for each."},
 {q:"Can you market commercial HVAC services?",a:"Yes. Commercial HVAC generally needs longer sales cycles, account-level qualification and consultative meetings instead of the same process used for residential service calls."},
 {q:"Do I need to replace my existing CRM?",a:"Not necessarily. We first assess your current systems and whether an integration or workflow change is enough."},
 {q:"Can you guarantee a certain number of booked jobs?",a:"No. Results depend on your market, budget, capacity, competition, offer and follow-up. We focus on a measurable process rather than guaranteed lead or revenue claims."},
];
