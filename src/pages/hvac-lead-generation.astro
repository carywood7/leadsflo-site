 <style>
  *,*::before,*::after{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body.hv-page{margin:0;background:#f7fafc;color:#152d40;font-family:Inter,'Helvetica Neue',Arial,sans-serif}
  .hv-page a{text-decoration:none}
  .hv-page button,.hv-page input{font:inherit}
  .hv-page button{cursor:pointer}
  .hv-page .wrap{width:min(1180px,calc(100% - 48px));margin:auto}
  .hv-page .eyebrow{font-size:11px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}
  .hv-page .section{padding:105px 0}
  .hv-page .heading{font-size:clamp(34px,5vw,64px);line-height:1.08;letter-spacing:-.05em;font-weight:800;margin:16px 0 20px}
  .hv-page .bodycopy{font-size:17px;line-height:1.8;color:#526f80;max-width:690px}
  .hv-page .cta{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:17px 23px;background:#f2a56f;color:#132737;border-radius:6px;font-size:14px;font-weight:800;transition:transform .2s,background .2s}
  .hv-page .cta:hover{transform:translateY(-2px);background:#ffc18c}
  .hv-page .cta.alt{border:1px solid #759aaf;background:transparent;color:#fff}
  .hv-page .cta.alt:hover{background:#24495e}
  .hv-page :is(a,button,input,summary):focus-visible{outline:3px solid #ed9959;outline-offset:4px}
  .hv-page .top{background:#0d2435;color:#fff}
  .hv-page .nav{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:84px;border-bottom:1px solid #ffffff25}
  .hv-page .brand{color:#fff;display:inline-flex;align-items:center}
  .hv-page .navlinks{display:flex;align-items:center;gap:25px}
  .hv-page .navlinks a{color:#c6dce6;font-size:13px;font-weight:700}
  .hv-page .navlinks a:hover{color:white}
  .hv-page .navlinks .navcta{border:1px solid #7391a2;border-radius:5px;padding:12px 14px;color:#fff}
  .hv-page .hero{padding:100px 0 110px;overflow:hidden;background:radial-gradient(ellipse at 79% 37%,#28516c 0%,#132e44 52%,#0c2030 100%)}
  .hv-page .herogrid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
  .hv-page .hero .eyebrow{color:#9de0f0}
  .hv-page h1{font-size:clamp(45px,5.8vw,77px);line-height:1.035;letter-spacing:-.06em;margin:22px 0;font-weight:800}
  .hv-page h1 em{font-style:normal;color:#a3def0}
  .hv-page .hero p{font-size:17px;line-height:1.85;color:#c5dbe5;max-width:550px}
  .hv-page .actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
  .hv-page .trust{margin-top:30px;display:flex;gap:10px 20px;flex-wrap:wrap;font-size:12px;font-weight:700;color:#a9cddd}
  .hv-page .trust span::before{content:'✓ ';color:#ffbe83}
  .hv-page .visual{border:1px solid #567e94;border-radius:21px;padding:26px;background:linear-gradient(150deg,#244c65,#10283c);box-shadow:0 32px 65px #0004;min-height:462px;overflow:hidden}
  .hv-page .visualhead{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:10px;letter-spacing:.12em;font-weight:800;color:#b4d0df}
  .hv-page .status{color:#a4e6c1}
  .hv-page .status::before{content:'';display:inline-block;background:#8cdeb3;border-radius:50%;width:7px;height:7px;margin-right:7px}
  .hv-page .unit{position:relative;width:min(280px,84%);aspect-ratio:1;margin:33px auto 21px;background:linear-gradient(140deg,#346681,#17364a);border:1px solid #5e8ca1;border-radius:18px;display:grid;place-items:center;box-shadow:0 23px 35px #0003}
  .hv-page .fan{width:73%;aspect-ratio:1;position:relative;border:12px solid #89bbce;border-radius:50%;background:#183a50;display:grid;place-items:center}
  .hv-page .blades{position:absolute;inset:8%;border-radius:50%;background:conic-gradient(#a9d9e7 0deg 39deg,transparent 39deg 90deg,#a9d9e7 90deg 129deg,transparent 129deg 180deg,#a9d9e7 180deg 219deg,transparent 219deg 270deg,#a9d9e7 270deg 309deg,transparent 309deg);animation:hvfan 17s linear infinite}
  .hv-page .hub{position:relative;width:30px;aspect-ratio:1;background:#285873;border:5px solid #a9d9e7;border-radius:50%}
  .hv-page .unitlabel{position:absolute;bottom:12px;font-size:10px;letter-spacing:.12em;color:#bfdae7;font-weight:800}
  .hv-page .flowmeters{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
  .hv-page .meter{padding:15px 11px;border:1px solid #ffffff19;background:#ffffff0b;border-radius:7px}
  .hv-page .meter small{display:block;font-size:10px;color:#a9cbdb}
  .hv-page .meter strong{display:block;margin-top:7px;font-size:12px;color:#fff}
  .hv-page .band{background:#dceef8;border-bottom:1px solid #bfdbe9}
  .hv-page .bandgrid{display:grid;grid-template-columns:repeat(4,1fr)}
  .hv-page .bandgrid span{padding:25px 8px;text-align:center;border-right:1px solid #bfdbe9;font-size:11px;letter-spacing:.1em;font-weight:800;color:#3b6a85}
  .hv-page .bandgrid span:last-child{border-right:0}
  .hv-page .introgrid{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px}
  .hv-page .blue{color:#1877a2}
  .hv-page .dark{background:#102c42;color:#fff}
  .hv-page .dark .bodycopy{color:#b3cfde}
  .hv-page .sectop{display:flex;justify-content:space-between;align-items:end;gap:38px;margin-bottom:38px}
  .hv-page .sectop .bodycopy{max-width:390px}
  .hv-page .servicegrid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
  .hv-page .service{min-height:315px;padding:24px 21px;background:#ffffff0b;border:1px solid #ffffff22;display:flex;flex-direction:column;transition:transform .2s,background .2s}
  .hv-page .service:hover{transform:translateY(-4px);background:#ffffff18}
  .hv-page .service .index{font-size:11px;color:#9bc2d5;letter-spacing:.08em;font-weight:800}
  .hv-page .service h3{font-size:23px;line-height:1.2;letter-spacing:-.04em;margin:36px 0 14px}
  .hv-page .service p{font-size:14px;line-height:1.8;color:#c0d3df;margin:0}
  .hv-page .service small{margin-top:auto;padding-top:22px;color:#ffc08c;letter-spacing:.11em;font-weight:800;font-size:10px}
  .hv-page .journey{background:#eaf4fa}
  .hv-page .journeygrid{display:grid;grid-template-columns:280px 1fr;gap:24px}
  .hv-page .steps{display:grid;align-content:start;gap:8px}
  .hv-page .step{padding:18px 16px;width:100%;text-align:left;display:flex;justify-content:space-between;align-items:center;gap:12px;background:#fff;border:1px solid #c8deeb;border-radius:6px;color:#315a74;font-weight:800}
  .hv-page .step .num{font-size:11px;color:#7394a8}
  .hv-page .step[aria-pressed='true']{background:#165578;color:#fff;border-color:#165578}
  .hv-page .step[aria-pressed='true'] .num{color:#bedde9}
  .hv-page .stagepanel{background:#fff;border:1px solid #cfe2ed;border-radius:10px;min-height:367px;padding:clamp(24px,4vw,46px);box-shadow:0 20px 30px #0d30400b}
  .hv-page .stagelabel{font-size:11px;letter-spacing:.12em;font-weight:800;color:#26769e}
  .hv-page .stagepanel h3{font-size:clamp(27px,3.3vw,42px);line-height:1.15;letter-spacing:-.045em;margin:20px 0}
  .hv-page .stagepanel p{font-size:16px;line-height:1.8;color:#5e7787}
  .hv-page .stagebottom{display:grid;grid-template-columns:1fr 1fr;gap:26px;border-top:1px solid #e1edf2;margin-top:30px;padding-top:20px}
  .hv-page .stagebottom ul{margin:13px 0;padding-left:20px;font-size:14px;line-height:1.8;color:#48677a}
  .hv-page .output{display:grid;place-items:center;text-align:center;padding:19px;border:1px solid #c6e0ed;border-radius:6px;background:#e9f7fd;color:#16608a;font-size:12px;letter-spacing:.08em;font-weight:800}
  .hv-page .qualgrid{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}
  .hv-page .qualcard{background:#f1f8fc;border:1px solid #cce2ee;border-radius:11px;padding:29px;box-shadow:12px 12px 0 #e1eff5}
  .hv-page .qualrow{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid #d7e6ed;padding:18px 0;font-size:14px}
  .hv-page .qualrow span{color:#667f90}
  .hv-page .qualrow strong{text-align:right}
  .hv-page .qualrow:last-child{border-bottom:0}
  .hv-page .calculator{background:#dfedf7}
  .hv-page .calcgrid{display:grid;grid-template-columns:1fr 1fr;gap:65px}
  .hv-page .calcbox{padding:30px;background:#fff;border:1px solid #c5dce9;border-radius:11px}
  .hv-page .range{display:block;padding:11px 0}
  .hv-page .rangetitle{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:14px;font-weight:700;margin-bottom:12px}
  .hv-page .rangetitle output{color:#156da0}
  .hv-page .range input{width:100%;accent-color:#176eaa}
  .hv-page .result{padding:25px;background:#112e44;border-radius:7px;color:white;margin-top:21px}
  .hv-page .result small{font-size:10px;letter-spacing:.12em;color:#a9d4e7}
  .hv-page .result strong{display:block;font-size:clamp(32px,3vw,46px);letter-spacing:-.04em;margin:9px 0}
  .hv-page .result p{color:#c2d5e0;font-size:12px;line-height:1.7}
  .hv-page .faqgrid{display:grid;grid-template-columns:.8fr 1.2fr;gap:75px}
  .hv-page .faqlist details{padding:21px 0;border-bottom:1px solid #d5e5ed}
  .hv-page .faqlist summary{font-size:17px;line-height:1.5;font-weight:750;cursor:pointer}
  .hv-page .faqlist p{font-size:15px;line-height:1.8;color:#587282}
  .hv-page .resources{background:#eaf4fa}
  .hv-page .resourcegrid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
  .hv-page .resource{min-height:185px;padding:24px;background:#fff;border:1px solid #c9deeb;display:flex;flex-direction:column}
  .hv-page .resource small{font-size:10px;letter-spacing:.12em;font-weight:800;color:#5685a2}
  .hv-page .resource h3{font-size:20px;line-height:1.25;margin:auto 0 0;letter-spacing:-.03em}
  .hv-page .closing{padding:100px 0;background:linear-gradient(125deg,#0d2436,#1b516b);text-align:center;color:#fff}
  .hv-page .closing .heading{max-width:840px;margin:16px auto}
  .hv-page .closing p{max-width:640px;margin:0 auto 33px;color:#c4d9e4;line-height:1.8}
  .hv-page footer{background:#0a1d2a;color:#b4cad5;padding:40px 0}
  .hv-page .foot{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}
  .hv-page .footnav{display:flex;flex-wrap:wrap;gap:17px;font-size:13px}
  .hv-page .footnav a{color:#dae9ee}
  .hv-page .footnav a:hover{text-decoration:underline}
  .hv-page [id]{scroll-margin-top:30px}
  @keyframes hvfan{to{transform:rotate(360deg)}}
  @media(max-width:1000px){.hv-page .herogrid,.hv-page .introgrid,.hv-page .qualgrid,.hv-page .calcgrid,.hv-page .faqgrid{grid-template-columns:1fr;gap:36px}.hv-page .servicegrid,.hv-page .resourcegrid{grid-template-columns:repeat(2,1fr)}.hv-page .visual{max-width:590px}.hv-page .sectop{display:block}}
  @media(max-width:700px){.hv-page .wrap{width:min(100% - 32px,1180px)}.hv-page .section{padding:68px 0}.hv-page .navlinks a:not(.navcta){display:none}.hv-page .nav{min-height:74px}.hv-page .hero{padding:63px 0}.hv-page h1{font-size:clamp(42px,11vw,64px)}.hv-page .actions .cta{width:100%}.hv-page .visual{min-height:390px;padding:18px}.hv-page .unit{margin:26px auto 18px}.hv-page .flowmeters{gap:5px}.hv-page .meter{padding:10px 7px}.hv-page .meter strong{font-size:11px}.hv-page .bandgrid{grid-template-columns:1fr 1fr}.hv-page .bandgrid span{border-bottom:1px solid #bfdbe9}.hv-page .servicegrid,.hv-page .resourcegrid{grid-template-columns:1fr}.hv-page .service{min-height:240px}.hv-page .service h3{margin:23px 0 10px}.hv-page .journeygrid{grid-template-columns:1fr}.hv-page .steps{grid-template-columns:repeat(2,1fr)}.hv-page .step{padding:14px;font-size:13px}.hv-page .stagebottom{grid-template-columns:1fr}.hv-page .calcbox,.hv-page .qualcard{padding:20px}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.hv-page .blades{animation:none}.hv-page .cta,.hv-page .service{transition:none}}

/* HVAC_HOVER_V3 */

.hv-page .brand{
  gap:12px;
  overflow:visible;
}

.hv-page .hv-air-badge{
  width:76px;
  flex:0 0 76px;
  display:inline-flex;
  align-items:center;
}

.hv-page .hv-air-badge svg{
  width:100%;
  overflow:visible;
}

.hv-page .hv-air-rotor{
  transform-origin:82px 26px;
  animation:hvAirSpin 6s linear infinite;
}

.hv-page .hv-air-trails{
  animation:hvAirDrift 2s ease-in-out infinite alternate;
}

.hv-page .brand:hover .hv-air-rotor{
  animation-duration:1.4s;
}

@keyframes hvAirSpin{
  to{transform:rotate(360deg)}
}

@keyframes hvAirDrift{
  to{transform:translateX(5px);opacity:.55}
}

.hv-page .visual{
  transition:transform .35s,box-shadow .35s;
}

.hv-page .visual:hover{
  transform:translateY(-5px);
  box-shadow:0 40px 75px #0005;
}

.hv-page .visual:hover .blades{
  animation-duration:3s;
}

.hv-page .meter{
  transition:transform .2s,background .2s;
}

.hv-page .meter:hover{
  transform:translateY(-4px);
  background:#ffffff1c;
}

/* Continuous scrolling services */
.hv-page .hv-marquee{
  overflow:hidden;
  background:#d9edf7;
  border-block:1px solid #b7d7e7;
}

.hv-page .hv-marquee-window{
  overflow:hidden;
  outline-offset:-3px;
}

.hv-page .hv-marquee-track{
  display:flex;
  width:max-content;
  animation:hvMarquee 30s linear infinite;
}

.hv-page .hv-marquee-group{
  display:flex;
  flex:0 0 auto;
}

.hv-page .hv-ticker-item{
  white-space:nowrap;
  padding:24px 32px;
  font-size:12px;
  font-weight:800;
  letter-spacing:.06em;
  color:#265d7d;
  border-right:1px solid #b7d7e7;
  transition:background .2s;
}

.hv-page .hv-ticker-item:hover{
  background:#bee5f4;
}

.hv-page .hv-marquee-window:hover .hv-marquee-track,
.hv-page .hv-marquee-window:focus-within .hv-marquee-track{
  animation-play-state:paused;
}

@keyframes hvMarquee{
  to{transform:translateX(-50%)}
}

/* Interactive services */
.hv-page .service{
  cursor:pointer;
  outline-offset:4px;
}

.hv-page .service.is-active{
  border-color:#92d9ed;
  background:#ffffff1e;
  transform:translateY(-5px);
}

.hv-page .hv-service-preview{
  margin:18px auto 0;
  width:min(1180px,calc(100% - 48px));
  padding:28px 35px;
  border:1px solid #547b94;
  background:#183e58;
  border-radius:12px;
  display:grid;
  grid-template-columns:minmax(0,1fr) 220px;
  align-items:center;
  gap:30px;
  color:#fff;
}

.hv-page .hv-preview-copy .eyebrow{
  color:#eeac7a;
}

.hv-page .hv-preview-copy h3{
  font-size:clamp(25px,3vw,38px);
  line-height:1.2;
  margin:13px 0;
  letter-spacing:-.04em;
}

.hv-page .hv-preview-copy p{
  color:#c4dce7;
  font-size:15px;
  line-height:1.8;
  max-width:700px;
  margin:0;
}

.hv-page .hv-preview-graphic{
  position:relative;
  min-height:160px;
  display:grid;
  place-items:center;
  overflow:hidden;
}

.hv-page .hv-preview-center{
  position:relative;
  z-index:1;
  width:60px;
  height:60px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#2b6581;
  color:#d6f6ff;
  border:1px solid #90d8ec;
  font-size:30px;
}

.hv-page .hv-preview-pulse{
  position:absolute;
  width:85px;
  height:85px;
  border:1px solid #9dddea;
  border-radius:50%;
  animation:hvPulse 3s ease-out infinite;
}

.hv-page .hv-preview-pulse-alt{
  animation-delay:1.5s;
}

.hv-page .hv-preview-graphic small{
  position:absolute;
  bottom:0;
  letter-spacing:.13em;
  font-size:10px;
  color:#9cc6d8;
}

@keyframes hvPulse{
  from{transform:scale(.75);opacity:.8}
  to{transform:scale(2);opacity:0}
}

/* Journey hover */
.hv-page .step{
  transition:transform .2s,border-color .2s;
}

.hv-page .step:hover,
.hv-page .step:focus-visible{
  transform:translateX(4px);
  border-color:#3986b2;
}

.hv-page .step[aria-pressed="true"]{
  box-shadow:inset 4px 0 #eea876;
