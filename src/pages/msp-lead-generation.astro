---
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";

const booking = "https://calendar.app.google/1fpawLr6fgP7Hmoi7";
const canonical = "https://leadsflo.co/msp-lead-generation/";

const services = [
  {num:"01",title:"MSP demand generation",tag:"Google, LinkedIn & paid search",description:"Reach business decision-makers looking for managed IT support, cybersecurity, cloud solutions and a reliable technology partner."},
  {num:"02",title:"Websites that qualify",tag:"SEO, content & conversion funnels",description:"Build search-focused pages around your services, geographic coverage, ideal customer profile and sales qualification process."},
  {num:"03",title:"CRM & follow-up",tag:"Lead routing & sales automation",description:"Bring new inquiries into an organized pipeline, trigger appropriate follow-up, and give sales teams visibility into every opportunity."},
  {num:"04",title:"Qualified sales meetings",tag:"Appointment setting",description:"Move suitable prospects from first conversation into discovery calls, with meeting reminders and a clear sales handoff."}
];

const stages = [
  {name:"Capture",heading:"Turn the right traffic into inquiries.",eyebrow:"01 / ACQUISITION",description:"Campaigns and SEO attract prospective business clients. A focused form or call experience captures what brought them in.",signal:"Example data: campaign source, company, location, service interest.",next:"Qualify the opportunity"},
  {name:"Qualify",heading:"Understand the business before booking.",eyebrow:"02 / QUALIFICATION",description:"Ask about employee or endpoint count, current IT coverage, service requirements, locations and buying timeframe. Keep the process short and useful.",signal:"Example data: users, locations, decision-maker, contract review window.",next:"Route to the sales owner"},
  {name:"Respond",heading:"Follow up while the conversation is relevant.",eyebrow:"03 / FOLLOW-UP",description:"Route inquiries to an owner, trigger appropriate notifications, record the response and provide a clear path to a human conversation.",signal:"Example data: assigned owner, first response, follow-up status.",next:"Book discovery"},
  {name:"Book",heading:"Convert interest into a real sales meeting.",eyebrow:"04 / BOOKING",description:"Connect a qualified prospect to the right calendar. Confirm meeting details, keep context visible and handle rescheduling.",signal:"Example data: meeting booked, attended, rescheduled, no-show.",next:"Move into a proposal"},
  {name:"Propose",heading:"Don't lose momentum after discovery.",eyebrow:"05 / PROPOSAL",description:"Support the sales team with proposal tracking, approved follow-ups and visibility into the opportunities needing attention.",signal:"Example data: opportunity stage, proposal sent, next action.",next:"Coordinate onboarding"},
  {name:"Onboard",heading:"Connect the closed deal to delivery.",eyebrow:"06 / HANDOFF",description:"Where the client's systems support it, coordinate the handoff from CRM to PSA and onboarding workflows, retaining human approval for sensitive actions.",signal:"Example data: closed-won status, service owner, onboarding checklist.",next:"Build the next opportunity"}
];

const questions = [
  {q:"Do you sell lists of MSP leads?",a:"Our focus is building dedicated client-acquisition systems for your business. We do not position shared contact lists as the same thing as qualified sales opportunities."},
  {q:"Do you work with cybersecurity providers and MSSPs?",a:"Yes. Messaging, qualification and campaigns need to reflect the actual security services, certifications, buyer concerns and sales process of each provider."},
  {q:"Can you work with our PSA and CRM?",a:"We assess your actual stack, access permissions, data-handling rules and supported integrations before specifying what can be connected. PSA tools can include HaloPSA, ConnectWise and Autotask."},
  {q:"Do you guarantee meetings or managed-services contracts?",a:"No. Results depend on market demand, geography, offer, advertising budget, targeting, qualifications, follow-up and sales execution. We focus on measurable opportunities rather than inflated promises."},
  {q:"Is this different from MSP Automations?",a:"Yes. LeadsFlo is the marketing and customer-acquisition service. MSP Automations is separate product and technical expertise that informs our understanding of MSP operations."},
  {q:"Can you run our entire sales process?",a:"We can design lead capture, routing, appropriate automation and appointment-setting workflows. Your sales team remains responsible for technical discovery, pricing, contractual commitments and closing decisions."}
];
