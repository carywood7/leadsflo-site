---
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";

const booking = "https://calendar.app.google/vmGynoLG6hJAo24P6";
const canonical = "https://leadsflo.co/electrician-lead-generation/";
const offerings = [
      {n:"01",tag:"SEARCH",name:"Google Ads for Electricians",
       desc:"Reach customers searching for electrical repairs, panel upgrades, EV chargers and professional installation services."},
      {n:"02",tag:"DEMAND",name:"Meta Ads & Creative",
       desc:"Promote relevant upgrade and installation offers with strong local creative and clear next steps."},
      {n:"03",tag:"CONVERSION",name:"Websites & Funnels",
       desc:"Convert service-specific visits into calls, project inquiries and estimate requests."},
      {n:"04",tag:"FOLLOW-UP",name:"CRM & Appointment Setting",
       desc:"Organize electrical inquiries, qualify projects and coordinate estimates and follow-up."}
    ];
const stages = [
      {n:"01",label:"Attract",tag:"LOCAL DEMAND",
       title:"Reach customers searching for electrical work.",
       body:"Target relevant local demand for repairs, panel upgrades, EV chargers and electrical installations.",
       points:["Service-specific keywords","Local service targeting","Relevant campaigns and creative"],
       outcome:"RELEVANT TRAFFIC"},
      {n:"02",label:"Capture",tag:"CONVERSION",
       title:"Give every visitor a clear next step.",
       body:"Use mobile-friendly service pages to capture calls, inquiries and estimate requests.",
       points:["Relevant landing pages","Visible contact options","Simple mobile intake"],
       outcome:"NEW INQUIRY"},
      {n:"03",label:"Qualify",tag:"PROJECT CONTEXT",
       title:"Understand the request before the estimate.",
       body:"Capture service area, property type, project category and timing. Leave safety assessments to qualified electricians.",
       points:["Service-area fit","Repair or installation scope","Customer timeline"],
       outcome:"QUALIFIED REQUEST"},
      {n:"04",label:"Follow up",tag:"CRM OPERATIONS",
       title:"Keep electrical opportunities moving.",
       body:"Route leads to the right person, track responses and keep project next steps visible.",
       points:["Lead assignment","Response reminders","Project status tracking"],
       outcome:"ACTIVE OPPORTUNITY"},
      {n:"05",label:"Book",tag:"SALES HANDOFF",
       title:"Move qualified inquiries toward booked estimates.",
       body:"Help suitable customers schedule a consultation, site assessment or installation estimate.",
       points:["Scheduling coordination","Confirmed next steps","Appointment follow-through"],
       outcome:"BOOKED ESTIMATE"}
    ];
const faqs = [
      {q:"How does electrician lead generation work?",
       a:"We connect local advertising and search demand with electrical service landing pages, lead qualification and follow-up to support calls and estimate bookings."},
      {q:"Can you promote panel upgrades and EV chargers?",
       a:"Yes. These services can use separate campaigns, landing pages and qualification steps from general electrical repair inquiries."},
      {q:"Do you work with commercial electrical contractors?",
       a:"Yes. Commercial projects often need different targeting, project qualification and longer follow-up cycles."},
      {q:"Do we need to replace our current CRM?",
       a:"Not necessarily. We review your existing CRM and scheduling tools before recommending integrations."},
      {q:"Can you guarantee booked jobs?",
       a:"No. Results depend on market demand, competition, budget, service capacity and how inquiries are handled."}
    ];
