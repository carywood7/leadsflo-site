import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";

const booking = "https://calendar.app.google/gJscT3C474Xt4Nqh7";
const canonical = "https://leadsflo.co/cybersecurity-marketing-agency/";

const services = [{"num": "01", "title": "Security demand generation", "tag": "Google, LinkedIn & targeted campaigns", "description": "Reach companies exploring MDR, SOC, managed security, compliance support and specialized cybersecurity services."}, {"num": "02", "title": "Cybersecurity SEO & funnels", "tag": "Search visibility & credibility", "description": "Explain your actual security offerings with search-focused service pages, clear technical messaging and relevant conversion paths."}, {"num": "03", "title": "Lead qualification & CRM", "tag": "Buyer fit & sales follow-up", "description": "Understand organizational fit, decision-makers, service needs and purchasing windows without requesting unnecessary sensitive information."}, {"num": "04", "title": "Qualified discovery meetings", "tag": "Appointment setting", "description": "Connect suitable cybersecurity buyers with the right commercial and technical teams for meaningful discovery conversations."}];

const stages = [{"name": "Attract", "heading": "Reach relevant security buyers.", "eyebrow": "01 / DEMAND GENERATION", "description": "Use paid campaigns, organic search and relevant content to reach businesses evaluating managed security and cybersecurity expertise.", "signal": "Campaign source, organization, industry and service interest.", "next": "Establish buyer fit"}, {"name": "Qualify", "heading": "Understand the security requirement.", "eyebrow": "02 / QUALIFICATION", "description": "Identify company fit, actual service needs, stakeholders, existing coverage and buying timeline without collecting credentials or security-sensitive incident details.", "signal": "Business size, service fit, decision-maker and timing.", "next": "Assign the inquiry"}, {"name": "Engage", "heading": "Respond with the right expertise.", "eyebrow": "03 / FOLLOW-UP", "description": "Route inquiries to the right sales or technical representative. Keep commercial evaluations distinct from incident-response emergencies.", "signal": "Inquiry owner, response status and follow-up action.", "next": "Arrange discovery"}, {"name": "Discover", "heading": "Book a meaningful security conversation.", "eyebrow": "04 / DISCOVERY", "description": "Coordinate the right commercial and technical stakeholders. Capture enough context to support a productive first meeting.", "signal": "Meeting status, stakeholders and scope.", "next": "Progress the evaluation"}, {"name": "Propose", "heading": "Support the buying committee.", "eyebrow": "05 / SALES PIPELINE", "description": "Track proposals, decision-making stages, proof requirements and approved follow-up throughout the evaluation process.", "signal": "Proposal status, next action and buying window.", "next": "Coordinate delivery"}, {"name": "Handoff", "heading": "Connect sales to secure onboarding.", "eyebrow": "06 / HANDOFF", "description": "Where supported and approved, coordinate the transition from closed-won opportunity to onboarding without exposing security credentials through marketing systems.", "signal": "Agreement stage, onboarding owner and approved checklist.", "next": "Support ongoing relationships"}];

const questions = [{"q": "Do you work with MSSPs and cybersecurity consultancies?", "a": "Yes. Campaigns are tailored to the provider's actual managed security, MDR, SOC, consulting or compliance-related services."}, {"q": "Can you market MDR and SOC services?", "a": "Yes, with technically accurate messaging that reflects verified capabilities and does not exaggerate monitoring coverage, certifications or outcomes."}, {"q": "How do you qualify cybersecurity leads?", "a": "We focus on organization and service fit, relevant buyer roles, requirements, timing and commercial readiness. Sensitive operational information does not belong in an ordinary marketing form."}, {"q": "Can you connect campaigns to our CRM?", "a": "We assess the CRM, data-handling requirements, permissions and supported integrations before defining the workflow."}, {"q": "Do you guarantee qualified meetings or contracts?", "a": "No. Outcomes depend on market demand, offer, credibility, advertising budget, qualification and sales execution."}, {"q": "What makes LeadsFlo different?", "a": "LeadsFlo combines sales and marketing experience with hands-on software development and MSP/MSSP product work, including MSP VOC and MSP Automate."}];
