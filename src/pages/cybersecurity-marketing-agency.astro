  <script define:vars={{stages}} is:inline>
    (() => {
      const header = document.querySelector(".mp-header");
      const menu = document.getElementById("mp-menu");
      const nav = document.getElementById("mp-nav");
      let lastScroll = window.scrollY;
      menu.addEventListener("click", () => {
        const opened = header.classList.toggle("is-open");
        menu.setAttribute("aria-expanded", String(opened));
        header.classList.remove("is-hidden");
      });
      nav.querySelectorAll("a").forEach(a => a.addEventListener("click", () => {
        header.classList.remove("is-open");
        menu.setAttribute("aria-expanded", "false");
      }));
      window.addEventListener("scroll", () => {
        const current = window.scrollY;
        if (Math.abs(current-lastScroll) < 6) return;
        if (current < 90 || current < lastScroll) header.classList.remove("is-hidden");
        else if (!header.classList.contains("is-open")) header.classList.add("is-hidden");
        lastScroll = current;
      }, {passive:true});

      const stageButtons = [...document.querySelectorAll(".mp-stage")];
      stageButtons.forEach(button => {
        button.addEventListener("click", () => {
          const index = Number(button.dataset.stage);
          const stage = stages[index];
          if (!stage) return;
          stageButtons.forEach(b => {
            const active = b === button;
            b.classList.toggle("is-active", active);
            b.setAttribute("aria-pressed", String(active));
          });
          const values = {
            "mp-stage-eyebrow":stage.eyebrow,
            "mp-stage-heading":stage.heading,
            "mp-stage-description":stage.description,
            "mp-stage-signal":stage.signal,
            "mp-stage-next":stage.next
          };
          Object.entries(values).forEach(([id,value]) => {
            document.getElementById(id).textContent = value;
          });
        });
      });


      // MSP_HOVER_POLISH_V2
      // Hover previews stages; click remains the touch fallback.
      stageButtons.forEach(button => {
        button.addEventListener("mouseenter", () => {
          button.click();
        });

        button.addEventListener("focus", () => {
          button.click();
        });
      });

      // Desktop hover FAQs; native details still work by click,
      // keyboard and touch.
      const hoverFAQs = document.querySelectorAll(
        ".mp-faq-list details"
      );

      const desktopHover = window.matchMedia(
        "(hover: hover) and (pointer: fine)"
      );

      hoverFAQs.forEach(details => {
        details.addEventListener("mouseenter", () => {
          if (desktopHover.matches) details.open = true;
        });

        details.addEventListener("mouseleave", () => {
          if (desktopHover.matches) details.open = false;
        });
      });

      const inputs = ["mp-leads","mp-meetings","mp-close","mp-mrr"]
        .map(id => document.getElementById(id));
      const dollars = new Intl.NumberFormat("en-US", {
        style:"currency",currency:"USD",maximumFractionDigits:0
      });
      function calculate() {
        const [leads, meetings, closeRate, mrr] = inputs.map(x => Number(x.value));
        document.getElementById("mp-leads-value").textContent = leads;
        document.getElementById("mp-meetings-value").textContent = meetings+"%";
        document.getElementById("mp-close-value").textContent = closeRate+"%";
        document.getElementById("mp-mrr-value").textContent = dollars.format(mrr);
        document.getElementById("mp-result").textContent =
          dollars.format(leads*meetings/100*closeRate/100*mrr);
      }
      inputs.forEach(input => input.addEventListener("input",calculate));
      calculate();
    })();
  </script>
</body>
</html>

