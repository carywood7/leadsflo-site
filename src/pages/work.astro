<style is:global>
.lf-work-intro{padding:clamp(56px,7vw,100px) 0;background:#f5f7fc}
.lf-work-intro h2{font-size:clamp(30px,4vw,52px);letter-spacing:-.045em;margin:12px 0 20px}
.lf-work-intro p{max-width:780px;color:#55647b;line-height:1.7}
.lf-work-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:35px}
.lf-work-cards .lf-rework__card{background:white;border:1px solid #dbe3ed;border-radius:18px;overflow:hidden}
.lf-work-cards .lf-rework__picture{display:block;aspect-ratio:16/10;overflow:hidden}
.lf-work-cards img{width:100%;height:100%;object-fit:cover;object-position:top center;display:block}
.lf-work-cards .lf-rework__body{padding:22px}
.lf-work-cards .lf-rework__type{font-size:11px!important;color:#315bfa;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
.lf-work-cards h3{font-size:23px;margin:10px 0;letter-spacing:-.04em}
.lf-work-cards p{color:#56647b;line-height:1.6}
.lf-work-cards .lf-rework__go{display:inline-block;margin-top:12px;color:#315bfa;font-weight:750}
.lf-work-cards a{text-decoration:none}
.lf-case-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(290px,.8fr);gap:36px;align-items:start}
.lf-case-layout h2{font-size:clamp(29px,3vw,44px);letter-spacing:-.04em}
.lf-case-layout p,.lf-case-layout li{line-height:1.8;color:#56647b}
.lf-case-shot{width:100%;height:auto;border-radius:15px;border:1px solid #dbe3ed;box-shadow:0 14px 34px rgba(23,35,61,.07)}
@media(max-width:900px){.lf-work-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.lf-work-cards{grid-template-columns:1fr}.lf-case-layout{grid-template-columns:1fr}}
</style>
