<script is:inline>
(function () {
  const finePointer = window.matchMedia(
    "(hover: hover) and (pointer: fine)"
  );

  function enableHover() {
    if (!finePointer.matches) return;

    // Native details preserve click and keyboard behavior.
    const drawers = document.querySelectorAll(
      ".lp-feature, .lp-search-faq details, " +
      ".lp-seo-faq-questions details"
    );

    drawers.forEach(function (card) {
      if (!(card instanceof HTMLDetailsElement)) return;
      if (card.dataset.hoverReady === "true") return;

      card.dataset.hoverReady = "true";

      card.addEventListener("mouseenter", function () {
        if (!finePointer.matches) return;
        card.open = true;
      });

      card.addEventListener("mouseleave", function () {
        if (!finePointer.matches) return;
        if (card.contains(document.activeElement)) return;
        card.open = false;
      });

      card.addEventListener("focusout", function (event) {
        if (!finePointer.matches) return;

        const next = event.relatedTarget;

        if (next instanceof Node && card.contains(next)) return;

        if (!card.matches(":hover")) {
          card.open = false;
        }
      });
    });

    // Reuse the existing click handlers, rather than
    // building a second selection system.
    document.querySelectorAll(
      "[data-step], [data-tier], [data-path]"
    ).forEach(function (card) {
      if (card.dataset.hoverSelectReady === "true") return;

      card.dataset.hoverSelectReady = "true";

      card.addEventListener("mouseenter", function () {
        if (!finePointer.matches) return;

        if (card.getAttribute("aria-pressed") !== "true") {
          card.click();
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded", enableHover, {once:true}
    );
  } else {
    enableHover();
  }
})();
</script>


