/* Animated snowfall, confined to this page, never intercepts clicks */
.lp-snow-overlay{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:74}
.lp-snow-overlay i{position:absolute;top:-30px;left:var(--x);width:var(--size);height:var(--size);border-radius:50%;background:#fff;box-shadow:0 0 2px #aac6cd,0 0 6px #ffffffd0;opacity:.75;animation:lf-christmas-snow var(--duration) linear var(--delay) infinite;will-change:transform}
@keyframes lf-christmas-snow{0%{transform:translate3d(0,-20px,0);opacity:0}10%{opacity:.8}90%{opacity:.6}100%{transform:translate3d(var(--drift),105vh,0);opacity:0}}
@media(max-width:1000px){body .lp-nav a{font-size:14px!important}body .lp-nav{gap:12px!important}}
@media(max-width:690px){body .lp-nav a{font-size:14px!important;padding:7px 0!important}body .lp-nav{gap:18px!important}body .lp-button-sm{font-size:12px!important}body .lp-brand::after{font-size:15px;right:-9px}.lp-snow-overlay i:nth-child(2n){display:none}}
@media(prefers-reduced-motion:reduce){.lp-snow-overlay{display:none!important}}
</style>
<script is:inline>
(function(){
  if (document.getElementById("lp-snow-overlay-holiday")) return;
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  const layer=document.createElement("div");
  layer.id="lp-snow-overlay-holiday";
  layer.className="lp-snow-overlay";
  layer.setAttribute("aria-hidden","true");
  let seed=20261028;
  function rnd(){seed=(1664525*seed+1013904223)>>>0;return seed/4294967296;}
  for(let i=0;i<45;i++){
    const flake=document.createElement("i");
    const size=(2.5+rnd()*5).toFixed(1)+"px";
    flake.style.setProperty("--x",(rnd()*100).toFixed(1)+"%");
    flake.style.setProperty("--size",size);
    flake.style.setProperty("--duration",(11+rnd()*16).toFixed(1)+"s");
    flake.style.setProperty("--delay",(-rnd()*29).toFixed(1)+"s");
    flake.style.setProperty("--drift",((rnd()-.5)*110).toFixed(1)+"px");
    layer.appendChild(flake);
  }
  document.body.appendChild(layer);
})();
</script>


<!-- LEADSFLO_CHRISTMAS_POLISH_V3 -->
<style is:inline>
/* Snow adjusts to the background underneath it. */
.lp-snow-overlay {
  mix-blend-mode: difference;
  pointer-events: none !important;
}

.lp-snow-overlay i {
  background: #fff !important;
