<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const brand = document.querySelector(".lp-brand");
  if (!brand) return;

  const anchor = brand.matches("a")
    ? brand
    : brand.querySelector("a");

  if (anchor) {
    anchor.setAttribute("href", "#top");
  } else {
    brand.setAttribute("role", "button");
    brand.setAttribute("tabindex", "0");
    brand.setAttribute("aria-label", "Scroll to top");
  }

  const goTop = (event) => {
    event.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches ? "instant" : "smooth"
    });
  };

  (anchor || brand).addEventListener("click", goTop);

  if (!anchor) {
    brand.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        goTop(event);
      }
    });
  }
});
</script>


