  });

  document.getElementById('r-ai-type').textContent = w.type;
  document.getElementById('r-ai-headline').textContent = w.headline;
  document.getElementById('r-ai-description').textContent = w.description;
  document.getElementById('r-ai-customer').textContent = w.customer;
  document.getElementById('r-ai-response').textContent = w.response;

  const steps = document.getElementById('r-ai-steps');
  steps.replaceChildren(...w.steps.map(value => {
    const span = document.createElement('span');
    span.textContent = value;
    return span;
  }));
}

aiButtons.forEach(button => {
  button.addEventListener('pointerenter', event => {
    if (event.pointerType === 'mouse' || event.pointerType === 'pen') {
      showAIWorkflow(button.dataset.aiWorkflow);
    }
  });

  button.addEventListener('focus', () => {
    showAIWorkflow(button.dataset.aiWorkflow);
  });

  button.addEventListener('click', () => {
    showAIWorkflow(button.dataset.aiWorkflow);
  });
});

const number=id=>Number(document.getElementById(id).value);
function update(){
const n=number('r-leads'),c=number('r-contact'),q=number('r-qualified'),b=number('r-booked');
for(const [id,value] of [['r-leads-out',n],['r-contact-out',c+'%'],['r-qualified-out',q+'%'],['r-booked-out',b+'%']])document.getElementById(id).textContent=value;
document.getElementById('r-reached').textContent=Math.round(n*c/100);
document.getElementById('r-conversations').textContent=Math.round(n*c*q/10000);
document.getElementById('r-meetings').textContent=Math.round(n*c*q*b/1000000);
}
['r-leads','r-contact','r-qualified','r-booked'].forEach(id=>document.getElementById(id).addEventListener('input',update));
update();
})();
</script>
</body>
