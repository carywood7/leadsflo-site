<style is:global>
:root{--r-ink:#102b27;--r-green:#255b48;--r-sage:#d7e6d7;--r-paper:#f7f5ef;--r-gold:#d8b47b;--r-muted:#637870}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body.realestate{margin:0;color:var(--r-ink);background:var(--r-paper);font-family:Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased}
.realestate a{color:inherit}.realestate button,.realestate input{font:inherit}.realestate button{cursor:pointer}
.realestate :focus-visible{outline:3px solid #c99038;outline-offset:4px}
.r-wrap{width:min(1200px,calc(100% - 48px));margin:auto}
.r-top{position:sticky;top:0;z-index:80;background:#fbfaf6ee;backdrop-filter:blur(18px);border-bottom:1px solid #dfe7dc;transition:transform .24s}
.r-top.hide{transform:translateY(-110%)}
.r-nav{min-height:86px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.r-logo{text-decoration:none!important;display:inline-flex}
.r-logo .lf-brand-v4{--brand-text:#193831;--brand-flo:#27614c;--brand-plane:#27614c;--brand-period:#c09b5e;font-size:30px}
.r-logo .lf-brand-v4__current1{stroke:#27614c}.r-logo .lf-brand-v4__current2{stroke:#c09b5e}
.r-links{display:flex;gap:25px;align-items:center}.r-links>a:not(.r-btn){text-decoration:none;font-size:14px;font-weight:750}
.r-btn{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:49px;padding:14px 22px;color:#fff!important;background:#163f34;text-decoration:none!important;border-radius:6px;font-weight:800;font-size:14px;transition:transform .2s,background .2s}
.r-btn:hover{background:#2c6753;transform:translateY(-2px)}.r-btn.light{background:#f5f1e6;color:#153b31!important}
.r-hamb{display:none;width:52px;height:52px;border-radius:8px;border:1px solid #bdccc0;background:#fff;color:#173c31;align-items:center;justify-content:center}
.r-hamb span{display:flex;flex-direction:column;gap:6px}.r-hamb i{display:block;width:28px;height:3px;background:currentColor;border-radius:4px}
.r-hero{position:relative;overflow:hidden;background:linear-gradient(125deg,#f6f6ee,#e9f0e8 55%,#dbe9de);padding:105px 0 110px}
.r-hero:before{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(#345c4112 1px,transparent 1px),linear-gradient(90deg,#345c4112 1px,transparent 1px);background-size:85px 85px;mask-image:linear-gradient(90deg,transparent,#000)}
.r-hero-grid{display:grid;grid-template-columns:1.06fr .94fr;gap:60px;align-items:center;position:relative}
.r-kicker{display:inline-flex;align-items:center;gap:12px;font-size:11px;letter-spacing:.17em;font-weight:850;text-transform:uppercase;color:#267155}
.r-kicker:before{content:"";width:25px;height:2px;background:var(--r-gold)}
.r-hero h1{font-size:clamp(46px,5.8vw,78px);letter-spacing:-.07em;line-height:1.045;margin:22px 0 26px;max-width:700px}
.r-hero h1 em{font-style:normal;color:#37795d}
.r-lede{font-size:18px;line-height:1.85;color:#577067;max-width:610px}
.r-actions{display:flex;flex-wrap:wrap;gap:13px;margin:30px 0}.r-pills{display:flex;flex-wrap:wrap;gap:10px}
.r-pills span{border:1px solid #bfd2c5;background:#ffffffc7;border-radius:25px;padding:9px 14px;font-size:12px;font-weight:750;color:#42715d}
.r-property{position:relative;min-height:540px;background:linear-gradient(140deg,#153d32,#2f6550);border:10px solid white;box-shadow:0 32px 80px #214a3740;border-radius:20px;overflow:hidden}
.r-property:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 77% 17%,#bcdcc055,transparent 32%),linear-gradient(155deg,transparent 48%,#0c302caa);pointer-events:none}
.r-property svg{position:absolute;width:100%;height:100%;inset:0}
.r-property-top{position:absolute;top:24px;left:24px;z-index:1;color:#e3f2e5;font-size:11px;letter-spacing:.16em;font-weight:850}
.r-property-bottom{position:absolute;left:24px;right:24px;bottom:24px;z-index:1;padding:20px 23px;background:#f3f6eccF;border:1px solid #fff7;border-radius:11px;display:flex;justify-content:space-between;align-items:center;gap:14px}
.r-property-bottom strong{font-size:21px}.r-property-bottom small{font-size:12px;color:#4f7060}
.r-band{background:#153c32;color:white;padding:22px 0;overflow:hidden}.r-band-track{display:flex;gap:12px;width:max-content;animation:r-slide 38s linear infinite}.r-band:hover .r-band-track{animation-play-state:paused}
.r-band-track span{padding:12px 20px;border:1px solid #6d9886;border-radius:6px;white-space:nowrap;font-size:13px;font-weight:800}
.r-band-track span:before{content:"✦";color:#e2bf84;margin-right:12px}
.r-section{padding:100px 0}.r-section.soft{background:#e7eee5}.r-section.dark{background:#112f28;color:#f2f6ed}
.r-section h2{font-size:clamp(34px,4.3vw,56px);letter-spacing:-.058em;line-height:1.12;margin:16px 0 20px;max-width:850px}
.r-intro{font-size:16px;line-height:1.85;color:#647a70;max-width:750px}.r-section.dark .r-intro{color:#b4cfc0}
.r-choices{display:flex;gap:13px;flex-wrap:wrap;margin:35px 0 18px}
.r-choice{padding:16px 24px;border:1px solid #c2d5c6;border-radius:8px;background:#fff;color:#1b4436;font-weight:800}
.r-choice.active,.r-choice:hover{background:#1e5140;color:white;border-color:#1e5140}
.r-campaign{display:grid;grid-template-columns:1.1fr .9fr;gap:25px;background:#fff;border:1px solid #d0ded0;padding:35px;border-radius:15px;align-items:center}
.r-campaign h3{font-size:clamp(26px,3vw,38px);letter-spacing:-.045em;margin:7px 0 14px}
.r-campaign p,.r-campaign li{line-height:1.8;color:#5e7669}
.r-campaign ul{padding-left:20px}.r-campaign-visual{min-height:260px;background:#dcead9;border-radius:11px;padding:26px;display:flex;flex-direction:column;justify-content:space-between}
.r-campaign-visual small{font-size:11px;letter-spacing:.13em;color:#537b5d;font-weight:850}
.r-campaign-visual strong{font-size:36px;line-height:1.1;letter-spacing:-.055em;color:#245846}
.r-campaign-visual span{font-size:13px;color:#547266}
.r-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:38px}
.r-step{min-height:205px;text-align:left;border:1px solid #557666;background:#1a4437;padding:25px;border-radius:11px;color:#fff}
.r-step:hover,.r-step.active{border-color:#e4c28a;background:#28614d}.r-step small{font-size:11px;letter-spacing:.1em;color:#c1e4cc;display:block;margin-bottom:32px}
.r-step strong{font-size:20px;line-height:1.25}
.r-step-detail{margin-top:15px;border:1px solid #557666;background:#e8eee4;color:#153e32;border-radius:12px;padding:29px}
.r-step-detail h3{font-size:25px;margin:0 0 8px}.r-step-detail p{line-height:1.8;color:#4f6e5e;max-width:850px}
.r-services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px;margin-top:38px}
.r-service{border-radius:13px;border:1px solid #d0decf;background:#fff;padding:28px;min-height:245px;position:relative;overflow:hidden}
.r-service:before{content:"";position:absolute;width:110px;height:110px;right:-30px;top:-30px;border:1px solid #bbd2bb;transform:rotate(45deg)}
.r-service b{font-size:12px;color:#4f916d}.r-service h3{font-size:24px;letter-spacing:-.035em;margin:33px 0 10px}
.r-service p{font-size:14px;line-height:1.75;color:#637b6f}
.r-planner{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:37px}
.r-fields,.r-results{padding:35px;border-radius:15px;border:1px solid #cbdbca;background:#fff}
.r-fields label{display:flex;justify-content:space-between;margin:17px 0 12px;gap:15px;font-weight:750;font-size:14px}
.r-fields output{color:#257253}.r-fields input{width:100%;accent-color:#286b4c;margin-bottom:16px}
.r-results{background:#163b30;color:#fff;border-color:#163b30}
.r-results>small{font-size:11px;letter-spacing:.12em;color:#c3e1cf;font-weight:800}
.r-stat{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:24px 0;border-bottom:1px solid #47715e}
.r-stat strong{font-size:36px;letter-spacing:-.045em}.r-stat span{font-size:13px;color:#cae0cf}
.r-disclaimer{font-size:12px;line-height:1.7;color:#c5dbc8;margin:24px 0}
.r-faqs{display:grid;gap:12px;margin-top:34px}.r-faqs details{padding:21px 24px;background:white;border:1px solid #d2dfce;border-radius:9px}
.r-faqs summary{font-size:17px;font-weight:800;cursor:pointer}.r-faqs p{color:#61766c;line-height:1.85;max-width:900px}
.r-articles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin-top:35px}
.r-article{padding:30px;border-radius:12px;background:#fff;border:1px solid #d1dfd0;text-decoration:none;display:flex;flex-direction:column;gap:15px;min-height:240px;transition:transform .2s,border-color .2s}
.r-article:hover{transform:translateY(-3px);border-color:#3d9566}
.r-article small{color:#53866b;font-weight:850;letter-spacing:.08em}
.r-article strong{font-size:23px;letter-spacing:-.04em}.r-article span{color:#648072;font-size:13px;line-height:1.7}.r-article b{margin-top:auto;color:#27694d}
.r-close{background:linear-gradient(120deg,#173b30,#315f47);color:#fff;padding:94px 0}.r-close h2{font-size:clamp(38px,5vw,64px);line-height:1.11;letter-spacing:-.06em;max-width:900px;margin:18px 0}.r-close p{font-size:17px;line-height:1.8;max-width:650px;color:#d1e3d6}
.r-footer{background:#0d2a23;color:#e9f1e9;padding:65px 0 32px}.r-footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:45px}.r-footer a{color:#e8f5e8}
.r-footer h3{font-size:13px;text-transform:uppercase;letter-spacing:.12em;color:#afd2b8}.r-footer p{line-height:1.8;color:#bbd3c4}
.r-footer-grid nav{display:flex;flex-direction:column;gap:15px}.r-footer-grid nav a{font-size:14px;text-decoration:none}
.r-footer-bottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;border-top:1px solid #335e47;padding-top:25px;margin-top:55px;font-size:12px;color:#bcd1c0}
.r-mobile-cta{display:none}
@keyframes r-slide{to{transform:translateX(-50%)}}
@media(max-width:1000px){.r-hero-grid{gap:25px}.r-property{min-height:430px}.r-links{gap:14px}.r-steps{grid-template-columns:repeat(2,1fr)}.r-services{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){
.r-nav{min-height:73px}.r-hamb{display:flex}.r-links{display:none;position:absolute;top:100%;left:0;right:0;background:#fbfaf6;padding:13px 24px 24px;box-shadow:0 18px 35px #0b2d2340;border-bottom:1px solid #d6e0d6;flex-direction:column;align-items:stretch}
.r-links.open{display:flex}.r-links>a{padding:12px 4px;font-size:15px!important}.r-links .r-btn{margin-top:8px}
.r-hero{padding:66px 0}.r-hero-grid,.r-campaign,.r-planner{grid-template-columns:1fr}.r-hero h1{font-size:clamp(43px,9vw,65px)}.r-property{min-height:370px}
.r-section{padding:72px 0}.r-articles{grid-template-columns:1fr}.r-footer-grid{grid-template-columns:1fr 1fr}.r-footer-grid>div{grid-column:1/-1}
.r-mobile-cta{display:block;position:fixed;bottom:0;left:0;right:0;z-index:100;background:#f5f7f1f2;border-top:1px solid #c4d5c5;padding:10px 15px calc(10px + env(safe-area-inset-bottom));backdrop-filter:blur(12px)}
.r-mobile-cta .r-btn{width:100%}body.realestate{padding-bottom:calc(70px + env(safe-area-inset-bottom))}
}
@media(max-width:500px){.r-wrap{width:calc(100% - 30px)}.r-hero h1{font-size:clamp(39px,10vw,52px)}.r-property{min-height:320px}.r-property-bottom strong{font-size:16px}.r-services,.r-steps{grid-template-columns:1fr}.r-step{min-height:135px}.r-step small{margin-bottom:15px}.r-fields,.r-results,.r-campaign{padding:23px}.r-footer-grid{grid-template-columns:1fr}.r-footer-grid>div{grid-column:auto}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.r-band-track{animation:none}.r-top,.r-article,.r-btn{transition:none}}

/* LEADSFLO_REAL_ESTATE_V2_FIXED */
.r-market-layout{display:grid;grid-template-columns:.84fr 1.16fr;gap:20px;margin-top:34px}
.r-market-options{display:grid;gap:10px;align-content:start}
.r-market-choice{border:1px solid #cbdace;background:#fff;color:#1b4234;text-align:left;
padding:20px 23px;border-radius:10px;min-height:70px;display:flex;
align-items:center;justify-content:space-between;font-size:16px;font-weight:800;
transition:background .2s,transform .2s,color .2s}
.r-market-choice:after{content:"↗";font-size:21px}
.r-market-choice:hover,.r-market-choice:focus-visible,.r-market-choice.active{
background:#215641;color:#fff;transform:translateX(4px)}
.r-market-panel{min-height:510px;padding:35px;border-radius:15px;background:
linear-gradient(135deg,#163c31,#2b6048);color:white;
display:flex;flex-direction:column;box-shadow:0 22px 50px #143b2926}
.r-market-panel small{color:#debf86;letter-spacing:.12em;font-weight:800}
.r-market-panel h3{font-size:clamp(27px,3.4vw,43px);line-height:1.14;
letter-spacing:-.045em;margin:20px 0}
.r-market-panel p{color:#cfe1d2;font-size:16px;line-height:1.85}
.r-market-art{height:180px;margin:22px 0;border-radius:10px;
background:repeating-linear-gradient(0deg,transparent 0 38px,#ffffff14 39px 40px),
repeating-linear-gradient(90deg,transparent 0 38px,#ffffff14 39px 40px);
position:relative;overflow:hidden}
.r-market-art svg{width:100%;height:100%}
.r-market-output{margin-top:auto;border-top:1px solid #719681;padding-top:20px}
.r-market-output strong{display:block;margin-top:12px;font-size:17px;line-height:1.5}
.r-market-note{font-size:12px!important;color:#b1c9b9!important}
.r-step{transition:transform .2s,box-shadow .2s,border-color .2s}
.r-step:hover,.r-step:focus-visible{transform:translateY(-4px);
box-shadow:0 15px 30px #071b171c}
.r-service{transition:transform .2s,box-shadow .2s,border-color .2s}
.r-service:hover{transform:translateY(-4px);border-color:#74af89;
box-shadow:0 18px 30px #163c3020}
.r-faqs details{transition:border-color .2s,background .2s}
.r-faqs details:hover,.r-faqs details[open],.r-faqs details:focus-within{
border-color:#7bad89;background:#fbfffb}
@media(max-width:820px){.r-market-layout{grid-template-columns:1fr}
.r-market-options{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:540px){.r-market-options{grid-template-columns:1fr}
.r-market-panel{padding:24px;min-height:440px}
.r-market-art{height:125px}
.r-market-choice{min-height:58px;padding:15px 18px}}
@media(hover:none){.r-step:hover,.r-market-choice:hover,.r-service:hover{transform:none}}
@media(prefers-reduced-motion:reduce){.r-step,.r-market-choice,.r-service{transition:none}}


/* LEADSFLO_REAL_ESTATE_FINAL_VISUAL_FIX */

.r-footer-logo {
  display: inline-flex;
  align-items: center;
  width: max-content;
  max-width: 100%;
  margin-bottom: 14px;
  text-decoration: none !important;
}

.r-footer-logo .lf-brand-v4 {
  --brand-text: #f2f5ec;
  --brand-flo: #a7d6b5;
  --brand-plane: #d6ba86;
  --brand-period: #d6ba86;
  font-size: 35px;
}

.r-footer-logo .lf-brand-v4__current1 {
  stroke: #a7d6b5;
}

.r-footer-logo .lf-brand-v4__current2 {
  stroke: #d6ba86;
}

.r-footer-logo:hover {
  opacity: .88;
}

@media (max-width: 600px) {
  .r-footer-logo .lf-brand-v4 {
    font-size: 32px;
  }
}


/* Real Estate conversational AI and workflow showcase */
.r-ai-section {
  background:#f0f3ea;
}

.r-ai-highlights {
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin:26px 0 37px;
}

.r-ai-highlights span {
  padding:10px 15px;
  background:#e0ebdf;
  color:#245943;
  border:1px solid #cadccc;
  border-radius:6px;
  font-size:12px;
  font-weight:800;
}

.r-ai-layout {
  display:grid;
  grid-template-columns:.83fr 1.17fr;
  gap:20px;
}

.r-ai-options {
  display:grid;
  gap:10px;
  align-content:start;
}

.r-ai-option {
  display:flex;
  align-items:center;
  gap:17px;
  text-align:left;
  width:100%;
  min-height:76px;
  padding:20px 19px;
  background:#fff;
  color:#204736;
  border:1px solid #c9dbcc;
  border-radius:10px;
  font-size:15px;
  font-weight:800;
  transition:background .2s,color .2s,transform .2s;
}

.r-ai-option-index {
  font-size:11px;
  letter-spacing:.08em;
  color:#718c79;
}

.r-ai-option-arrow {
  margin-left:auto;
  font-size:20px;
  font-weight:400;
}

.r-ai-option:hover,
.r-ai-option:focus-visible,
.r-ai-option.active {
  background:#205540;
  border-color:#205540;
  color:#fff;
  transform:translateX(4px);
}

.r-ai-option:hover .r-ai-option-index,
.r-ai-option.active .r-ai-option-index {
  color:#c3d8c8;
}

.r-ai-demo {
  background:#153b30;
  color:#fff;
  padding:32px;
