const booking = "https://calendar.app.google/1fpawLr6fgP7Hmoi7";
const canonical = "https://leadsflo.co/it-services-lead-generation/";

const services = [{"num": "01", "title": "IT services demand generation", "tag": "Google, LinkedIn & targeted campaigns", "description": "Reach businesses planning IT consulting, cloud migrations, infrastructure modernization and systems integration projects."}, {"num": "02", "title": "IT SEO, websites & funnels", "tag": "Search intent & conversion", "description": "Create focused service pages and landing experiences explaining your capabilities, target customers and discovery process."}, {"num": "03", "title": "Project qualification & CRM", "tag": "Scope, budget & follow-up", "description": "Capture high-level project needs, company fit, expected budget, timing and decision-maker information before assigning an opportunity."}, {"num": "04", "title": "Discovery & appointment setting", "tag": "Consultation to proposal", "description": "Turn suitable inquiries into prepared discovery meetings, proposal follow-up and structured sales-to-delivery handoffs."}];

const stages = [{"name": "Attract", "heading": "Reach businesses planning IT projects.", "eyebrow": "01 / ACQUISITION", "description": "Connect with organizations searching for consulting, cloud modernization, systems integration or infrastructure expertise.", "signal": "Campaign source, company profile, geography and service interest.", "next": "Qualify the project"}, {"name": "Qualify", "heading": "Understand what needs to be delivered.", "eyebrow": "02 / PROJECT QUALIFICATION", "description": "Capture the service required, business size, indicative budget, project timeline and buying responsibilities.", "signal": "Project type, scope, budget range and decision window.", "next": "Arrange consultation"}, {"name": "Consult", "heading": "Book a relevant technical conversation.", "eyebrow": "03 / DISCOVERY", "description": "Connect suitable prospects with the appropriate consultant or sales engineer. Confirm goals and expectations for the meeting.", "signal": "Assigned consultant, buyer roles and meeting status.", "next": "Define project scope"}, {"name": "Scope", "heading": "Translate requirements into a clear scope.", "eyebrow": "04 / SOLUTION PLANNING", "description": "Track project requirements, dependencies, technical discovery and assumptions before preparing a commercial proposal.", "signal": "Scope review, technical owner and dependencies.", "next": "Prepare proposal"}, {"name": "Propose", "heading": "Keep commercial decisions moving.", "eyebrow": "05 / SALES PIPELINE", "description": "Follow proposal status, procurement requirements, stakeholder questions and the agreed next steps.", "signal": "Proposal status, estimated value and buying timeline.", "next": "Coordinate the kickoff"}, {"name": "Onboard", "heading": "Hand the project to delivery.", "eyebrow": "06 / PROJECT HANDOFF", "description": "Coordinate approved sales-to-delivery tasks when the deal closes. Technical access and implementation decisions remain with authorized personnel.", "signal": "Agreement status, project owner and kickoff checklist.", "next": "Develop the client relationship"}];

const questions = [{"q": "Which IT service providers do you work with?", "a": "IT consulting firms, cloud service providers, systems integrators, infrastructure specialists and other B2B technology companies."}, {"q": "Can you help generate cloud migration leads?", "a": "We can create campaigns, landing pages and qualification processes around genuine cloud migration and modernization services."}, {"q": "How do you qualify IT project leads?", "a": "We can assess service requirements, company fit, approximate scope, budget expectations, buying roles and implementation timing."}, {"q": "Do you work with project-based and recurring services?", "a": "Yes. The sales process can be adapted to consulting projects, implementations and recurring technology services."}, {"q": "Can you connect our CRM and booking system?", "a": "We assess supported integrations, permissions and current workflows before defining CRM routing, follow-up and scheduling."}, {"q": "Do you guarantee signed IT projects?", "a": "No. Outcomes depend on demand, positioning, budget, lead quality and sales execution. We focus on measurable, suitable opportunities."}];
