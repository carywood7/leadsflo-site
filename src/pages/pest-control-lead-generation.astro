 <script define:vars={{stages,offerings}}>
  const root=document.querySelector('[data-hv-journey]');
  if(root){
   const buttons=[...root.querySelectorAll('[data-hv-step]')];
   function choose(index){
    const s=stages[index];if(!s)return;
    buttons.forEach((b,i)=>b.setAttribute('aria-pressed',String(i===index)));
    function put(sel,text){const el=root.querySelector(sel);if(el)el.textContent=text;}
    put('[data-hv-tag]',s.tag);put('[data-hv-title]',s.title);put('[data-hv-body]',s.body);put('[data-hv-outcome]',s.outcome);
    const list=root.querySelector('[data-hv-points]');
    if(list){list.replaceChildren();s.points.forEach(p=>{const li=document.createElement('li');li.textContent=p;list.append(li);});}
   }

   buttons.forEach((b,i)=>{
    b.addEventListener('click',()=>choose(i));
    b.addEventListener('focus',()=>choose(i));
    b.addEventListener('pointerenter',e=>{
      if(e.pointerType==='mouse'||e.pointerType==='pen'){
        choose(i);
      }
    });
   });

  }

  // Interactive service cards.
  const cards = [
    ...document.querySelectorAll('[data-hv-service]')
  ];

  const preview = document.querySelector('[data-hv-preview]');

  if (preview && cards.length === offerings.length) {
    function pick(index) {
      const item = offerings[index];
      if (!item) return;

      cards.forEach((card, i) => {
        card.classList.toggle('is-active', i === index);
        card.setAttribute('aria-pressed', String(i === index));
      });

      preview.querySelector(
        '[data-hv-preview-number]'
      ).textContent = item.n;

      preview.querySelector(
        '[data-hv-preview-name]'
      ).textContent = item.name;

      preview.querySelector(
        '[data-hv-preview-desc]'
      ).textContent = item.desc;
    }

    cards.forEach((card, index) => {
      card.addEventListener('click', () => pick(index));
      card.addEventListener('focus', () => pick(index));

      card.addEventListener('pointerenter', event => {
        if (event.pointerType === 'mouse' ||
            event.pointerType === 'pen') {
          pick(index);
        }
      });

      card.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          pick(index);
        }
      });
    });

    pick(0);
  }

  // Native tap and keyboard support remains intact.
  // Mouse hover opens the relevant FAQ.
  const faq = [
    ...document.querySelectorAll('.faqlist details')
  ];

  faq.forEach(item => {
    item.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'mouse' &&
          event.pointerType !== 'pen') return;

      faq.forEach(other => {
        other.open = (other === item);
      });
    });
  });

  const box=document.querySelector('[data-hv-calc]');
  if(box){
   const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
   const get=k=>Number(box.querySelector(`[data-hv-range="${k}"]`)?.value||0);
   function calc(){
    const leads=get('leads'),book=get('book'),close=get('close'),job=get('job');
    const bookings=leads*book/100,won=bookings*close/100;
    const outputs={leads:String(leads),book:book+'%',close:close+'%',job:money(job)};
    Object.entries(outputs).forEach(([key,val])=>{const el=box.querySelector(`[data-hv-value="${key}"]`);if(el)el.textContent=val;});
    box.querySelector('[data-hv-revenue]').textContent=money(won*job);
    box.querySelector('[data-hv-breakdown]').textContent=bookings.toFixed(1)+' potential bookings · '+won.toFixed(1)+' expected jobs';
   }
   box.querySelectorAll('[data-hv-range]').forEach(input=>input.addEventListener('input',calc));calc();
  }
 </script>


