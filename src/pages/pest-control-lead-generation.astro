body.hv-page .pc-ant-3 { animation-delay: -7.4s; }
body.hv-page .pc-ant-4 { animation-delay: -10.6s; }
body.hv-page .pc-ant-5 { animation-delay: -13.8s; }

@keyframes pcAntWalk {
  0% {
    transform: translate3d(-30px, 4px, 0);
    opacity: 0;
  }
  10% { opacity: .85; }
  84% { opacity: .85; }
  100% {
    transform: translate3d(105vw, -5px, 0);
    opacity: 0;
  }
}

/* Ant-and-shield niche logo */
body.hv-page .brand .pc-logo-shield {
  transform-origin: 50% 50%;
  animation: pcShieldBreathe 3.8s ease-in-out infinite;
}

body.hv-page .brand .pc-logo-ant {
  transform-origin: 17px 17px;
  animation: pcLogoAntMove 3.8s ease-in-out infinite;
}

@keyframes pcShieldBreathe {
  0%, 100% {
    opacity: .75;
    transform: scale(.96);
  }
  50% {
    opacity: 1;
    transform: scale(1.035);
  }
}

@keyframes pcLogoAntMove {
  0%, 100% { transform: translateX(-.6px); }
  50% { transform: translateX(.7px); }
}

/* Disable inherited motion on the replaced shield. */
body.hv-page .pc-logo-shield {
  animation: pcShieldBreathe 3.8s ease-in-out infinite;
}

/* Dashboard */
body.hv-page .pc-detection-panel {
  border: 1px solid rgba(180, 233, 201, .24);
  border-radius: 12px;
  padding: 15px;
  margin: 15px 0 18px;
  background: rgba(9, 35, 36, .57);
  color: #e8f6ec;
}

body.hv-page .pc-detection-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

body.hv-page .pc-detection-eyebrow {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .11em;
  color: #c2e8d2;
}

body.hv-page .pc-detection-live {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #b9e9cc;
  font-size: 9px;
  font-weight: 800;
  white-space: nowrap;
  letter-spacing: .07em;
}

body.hv-page .pc-live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #99edb8;
  box-shadow: 0 0 0 3px rgba(153, 237, 184, .12);
}

body.hv-page .pc-detection-status {
  display: flex;
  align-items: center;
  gap: 13px;
  min-height: 57px;
  margin-bottom: 15px;
}

body.hv-page .pc-detection-indicator {
  position: relative;
  width: 39px;
  height: 39px;
  flex: 0 0 39px;
  display: grid;
  place-items: center;
}

body.hv-page .pc-indicator-ring {
  width: 35px;
  height: 35px;
  border: 2px solid #9dddb7;
  border-radius: 50%;
  animation: pcRadarPulse 2.5s ease-out infinite;
}

body.hv-page .pc-indicator-center {
  position: absolute;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #eaba82;
}

@keyframes pcRadarPulse {
  0% {
    transform: scale(.72);
    opacity: 1;
  }
  100% {
    transform: scale(1.15);
    opacity: .2;
  }
}

body.hv-page .pc-detection-copy {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
}

body.hv-page .pc-detection-copy strong {
  font-size: 15px;
  font-weight: 800;
  line-height: 1.25;
  color: #f0f9f2;
}

body.hv-page .pc-detection-copy small {
  font-size: 11px;
  line-height: 1.5;
  color: #bbd7ca;
}

body.hv-page .pc-stage-controls {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7px;
}

body.hv-page .pc-stage-controls button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-width: 0;
  min-height: 41px;
  padding: 9px 7px;
  border: 1px solid #63897a;
  border-radius: 7px;
  background: rgba(35, 86, 71, .38);
  color: #c9e9d6;
  font-size: 11px;
  font-weight: 750;
  cursor: pointer;
  transition: background .2s, border-color .2s;
}

body.hv-page .pc-stage-controls button span {
  color: #e5b380;
  font-size: 10px;
}

body.hv-page .pc-stage-controls button[aria-pressed="true"] {
  background: #d5ebd8;
  color: #1b4c3d;
  border-color: #d5ebd8;
}

body.hv-page .pc-stage-controls button[aria-pressed="true"] span {
  color: #946036;
}

body.hv-page .pc-stage-controls button:hover {
  border-color: #daf1df;
}

body.hv-page .pc-stage-controls button:focus-visible {
  outline: 3px solid #eeba87;
  outline-offset: 3px;
}

body.hv-page .pc-detection-disclaimer {
  color: #a4c4b7 !important;
  font-size: 10px !important;
  line-height: 1.5 !important;
  margin: 12px 0 0 !important;
}

/* Stage-specific treatments */
body.hv-page [data-pc-phase="qualify"] .pc-indicator-center {
  background: #9be7c3;
}

body.hv-page [data-pc-phase="book"] .pc-indicator-center {
  background: #f0c18d;
}

body.hv-page [data-pc-phase="book"] .pc-indicator-ring {
  border-color: #f0c18d;
}

/* Premium photo hover effect */
body.hv-page .hv-photo-image {
  position: relative;
  overflow: hidden;
}

body.hv-page .hv-photo-image::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      105deg,
      transparent 35%,
      rgba(171, 246, 199, .18) 49%,
      transparent 63%
    );
  transform: translateX(-130%);
  transition: transform .75s ease;
  pointer-events: none;
}

body.hv-page .hv-photo-card:hover .hv-photo-image::after,
body.hv-page .hv-photo-card:focus-within .hv-photo-image::after {
  transform: translateX(130%);
}

@media (max-width: 700px) {
  body.hv-page .pc-ant-trail {
    height: 33px;
    opacity: .32;
  }

  body.hv-page .pc-ant-sprite {
    width: 19px;
    height: 15px;
  }

  body.hv-page .pc-detection-panel {
    padding: 13px;
  }

  body.hv-page .pc-detection-copy strong {
    font-size: 14px;
  }

  body.hv-page .pc-stage-controls button {
    min-height: 44px;
    font-size: 10px;
    gap: 4px;
  }
}

@media (prefers-reduced-motion: reduce) {
  body.hv-page .pc-ant-sprite,
  body.hv-page .pc-logo-shield,
  body.hv-page .pc-logo-ant,
  body.hv-page .pc-indicator-ring {
    animation: none !important;
  }

  body.hv-page .pc-ant-trail {
    display: none;
  }

  body.hv-page .hv-photo-image::after {
    display: none;
  }

  body.hv-page .pc-stage-controls button {
    transition: none;
  }
}
</style>


