import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";

const booking = "https://calendar.app.google/gJscT3C474Xt4Nqh7";
const canonical = "https://leadsflo.co/pest-control-lead-generation/";
const offerings = [
      {
        n:"01",tag:"SEARCH",
        name:"Google Ads for Pest Control",
        desc:"Reach local homeowners searching for exterminators, termite inspections, rodent removal and professional pest management."
      },
      {
        n:"02",tag:"DEMAND",
        name:"Meta Ads & Creative",
        desc:"Promote seasonal pest services, inspection offers and recurring protection plans with relevant local creative."
      },
      {
        n:"03",tag:"CONVERSION",
        name:"Websites & Funnels",
        desc:"Convert local traffic into calls, pest inspection requests and qualified residential or commercial inquiries."
      },
      {
        n:"04",tag:"FOLLOW-UP",
        name:"CRM & Appointment Setting",
        desc:"Route inquiries by pest type, property and location, and coordinate consultations, service visits and follow-up."
      }
    ];
const stages = [
      {
        n:"01",label:"Attract",tag:"LOCAL DEMAND",
        title:"Show up when customers need pest control.",
        body:"Target relevant searches for termites, rodents, ants, cockroaches and scheduled pest management in the areas you serve.",
        points:["Pest-specific search campaigns","Service-area targeting","Seasonal and recurring offers"],
        outcome:"RELEVANT LOCAL DEMAND"
      },
      {
        n:"02",label:"Capture",tag:"CONVERSION",
        title:"Make inspection requests easy.",
        body:"Give visitors a fast mobile experience with a clear call option or a short request form tailored to the pest problem.",
        points:["Clear next steps","Mobile-friendly forms","Service-specific landing pages"],
        outcome:"NEW SERVICE INQUIRY"
      },
      {
        n:"03",label:"Qualify",tag:"SERVICE FIT",
        title:"Understand the property and pest problem.",
        body:"Capture location, pest category, residential or commercial property and preferred timing without implying an unverified diagnosis.",
        points:["Location and coverage","Pest category","Property and scheduling details"],
        outcome:"QUALIFIED REQUEST"
      },
      {
        n:"04",label:"Follow up",tag:"CRM OPERATIONS",
        title:"Keep every inquiry moving.",
        body:"Route inspection and service requests, record contact attempts and provide clear next steps for the office or field team.",
        points:["Lead assignment","Call and form follow-up","Customer status tracking"],
        outcome:"ACTIVE OPPORTUNITY"
      },
      {
        n:"05",label:"Book",tag:"SERVICE HANDOFF",
        title:"Turn suitable inquiries into scheduled service.",
        body:"Coordinate an inspection, initial service visit or consultation and keep recurring-plan follow-up visible.",
        points:["Inspection scheduling","Confirmed next steps","Recurring service follow-up"],
        outcome:"BOOKED SERVICE"
      }
    ];
const faqs = [
      {
        q:"How does pest control lead generation work?",
        a:"We connect local advertising and search demand with service-specific landing pages, qualification and CRM follow-up to generate relevant pest control inquiries and booking opportunities."
      },
      {
        q:"Can you market termite and rodent services separately?",
        a:"Yes. Termite inspections, rodent management and routine pest treatment can have distinct offers, campaigns and customer qualification requirements."
      },
      {
        q:"Can you help promote recurring pest control plans?",
        a:"Yes. Where appropriate, recurring residential or commercial programs can use dedicated messaging, inquiry flows and follow-up processes."
      },
      {
        q:"Do we need to replace our existing field-service software?",
        a:"Not necessarily. We review the systems you already use before recommending CRM, scheduling or communication integrations."
      },
      {
        q:"Do you guarantee booked pest control jobs?",
        a:"No. Results depend on competition, service territory, budget, capacity and customer response. Our goal is a measurable lead-to-booking process."
      }
    ];
