body.hv-page .pc-falling-particle {
  position: absolute;
  top: -55px;
  left: var(--pc-left);
  width: var(--pc-size);
  height: var(--pc-size);
  display: block;
  opacity: 0;
  color: #5c947b;
  animation:
    pcFullPageFall var(--pc-duration)
    linear var(--pc-delay) infinite;
  will-change: transform;
}

body.hv-page .pc-falling-particle svg {
