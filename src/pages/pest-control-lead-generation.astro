<script is:inline>
/* PEST CONTROL_HEADER_V3 */
(() => {
  const header = document.querySelector(
    '[data-pl-scroll-header]'
  );

  if (!header) return;

  let previousY = Math.max(0, window.scrollY);
  let directionDistance = 0;
  let lastDirection = 0;
  let ticking = false;

  const reveal = () => {
    header.classList.remove('pl-header-hidden');
  };

  function update() {
    const y = Math.max(0, window.scrollY);
    const difference = y - previousY;

    previousY = y;
    ticking = false;

    if (
      y <= 100 ||
      document.activeElement &&
      header.contains(document.activeElement)
    ) {
      reveal();
      directionDistance = 0;
      lastDirection = 0;
      return;
    }

    // Ignore small scroll jitter and rubber-band bounce.
    if (Math.abs(difference) < 2) return;

    const direction = difference > 0 ? 1 : -1;

    if (direction !== lastDirection) {
      directionDistance = 0;
      lastDirection = direction;
    }

    directionDistance += Math.abs(difference);

    if (directionDistance < 16) return;

    if (direction > 0) {
      header.classList.add('pl-header-hidden');
    } else {
      reveal();
    }

    directionDistance = 0;
  }

  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(update);
  }, { passive: true });

  header.addEventListener('focusin', reveal);

  // Anchor navigation should reveal its destination cleanly.
  header.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener('click', reveal);
  });

  window.addEventListener('pageshow', () => {
    previousY = Math.max(0, window.scrollY);
    reveal();
  });

  reveal();
})();
</script>


<script is:inline>
/* Pest Control interactive inspection demonstration */
(() => {
  const panel = document.querySelector('[data-pc-scanner]');
  if (!panel) return;

  const title = panel.querySelector('[data-pc-phase-title]');
  const description = panel.querySelector(
    '[data-pc-phase-description]'
  );
  const buttons = Array.from(
    panel.querySelectorAll('[data-pc-stage]')
  );

  const phases = [
    {
      id: 'detect',
      title: 'Activity detected',
      description: 'Relevant local pest control inquiry'
    },
    {
      id: 'qualify',
      title: 'Lead qualified',
      description: 'Pest category, property and service area checked'
    },
    {
      id: 'book',
      title: 'Ready to schedule',
      description: 'Inspection or service appointment next step'
    }
  ];

  const reduced = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  );

  let index = 0;
  let interval = null;

  const show = next => {
    index = next;
    const phase = phases[index];

    panel.dataset.pcPhase = phase.id;
    title.textContent = phase.title;
    description.textContent = phase.description;

    buttons.forEach(button => {
      button.setAttribute(
        'aria-pressed',
        String(button.dataset.pcStage === phase.id)
      );
    });
  };

  const stop = () => {
    if (interval !== null) {
      window.clearInterval(interval);
      interval = null;
    }
  };

  const start = () => {
    stop();

    if (
      reduced.matches ||
      document.hidden ||
      panel.matches(':hover') ||
      panel.contains(document.activeElement)
    ) return;

    interval = window.setInterval(() => {
      show((index + 1) % phases.length);
    }, 3900);
  };

  buttons.forEach((button, next) => {
    button.addEventListener('click', () => {
      show(next);
      stop();
    });

    button.addEventListener('focus', stop);
  });

  panel.addEventListener('mouseenter', stop);
  panel.addEventListener('mouseleave', start);
  panel.addEventListener('focusin', stop);
  panel.addEventListener('focusout', () => {
    window.requestAnimationFrame(start);
  });

  document.addEventListener('visibilitychange', start);

  if (reduced.addEventListener) {
    reduced.addEventListener('change', start);
  }

  show(0);
  start();
})();
</script>

