---
import SiteLayout from "../layouts/SiteLayout.astro";
const articles = [{"slug": "google-ads-vs-meta-ads-for-lead-generation", "title": "Google Ads vs Meta Ads for Lead Generation", "desc": "Understand the different jobs Google Search and Meta Ads do in a lead generation strategy, and how to choose where to start."}, {"slug": "why-your-lead-generation-landing-page-is-not-converting", "title": "Why Your Lead Generation Landing Page Is Not Converting", "desc": "Common reasons paid traffic does not turn into inquiries, from message mismatch and weak offers to forms and mobile usability."}, {"slug": "crm-follow-up-for-new-leads", "title": "A Practical CRM Follow-Up Process for New Leads", "desc": "A practical framework for routing new inquiries, responding quickly, tracking progress and avoiding missed sales opportunities."}];
---
<SiteLayout title="Lead Generation Insights" description="Practical guides on paid advertising, conversion funnels and CRM follow-up for businesses looking to generate better leads." path="/insights/">
<section class="lf-page-hero"><div class="container lf-hero-inner"><div class="lf-hero-copy"><p class="section-kicker">LEAD GENERATION INSIGHTS</p><h1>Ideas you can put to work.</h1><p class="lf-lede">Practical guides about attracting, capturing and following up with qualified prospects—without chasing vanity metrics.</p></div><aside class="lf-hero-aside"><span>THE EDITORIAL FOCUS</span><strong>Clear answers, useful frameworks and thoughtful marketing decisions.</strong><span class="lf-aside-mark">↗</span></aside></div></section>
<section class="lf-page-section lf-section-muted"><div class="container"><div class="lf-section-head"><p class="section-kicker">LATEST GUIDES</p><h2>Read, learn, apply.</h2></div><div class="lf-insights-grid">{articles.map((article,index) => <article class="lf-insight-card"><span class="lf-card-index">0{index+1} / FIELD GUIDE</span><h3><a href={`/insights/${article.slug}/`}>{article.title}</a></h3><p>{article.desc}</p><a class="lf-read-more" href={`/insights/${article.slug}/`}>Read guide ↗</a></article>)}</div></div></section>
</SiteLayout>