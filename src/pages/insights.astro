---
import SiteLayout from "../layouts/SiteLayout.astro";
const articles = [
  { slug: "google-ads-vs-meta-ads-for-lead-generation", title: "Google Ads vs Meta Ads for Lead Generation", category: "CHANNEL STRATEGY", desc: "When to choose search intent, when to choose social discovery, and how to assess lead quality." },
  { slug: "why-your-lead-generation-landing-page-is-not-converting", title: "Why Your Lead Generation Landing Page Is Not Converting", category: "CONVERSION", desc: "Diagnose message mismatch, weak offers, mobile friction and broken conversion tracking." },
  { slug: "crm-follow-up-for-new-leads", title: "A Practical CRM Follow-Up Process for New Leads", category: "CRM & OPERATIONS", desc: "A practical workflow for assigning, qualifying and following up with new inquiries." }
];
---
<SiteLayout title="Lead Generation Insights" description="Practical field guides on paid advertising, lead generation landing pages and CRM follow-up from LeadsFlo." path="/insights/">
  <section class="lf-page-hero"><div class="container lf-hero-inner"><div class="lf-hero-copy"><p class="section-kicker">LEAD GENERATION INSIGHTS</p><h1>Ideas you can put to work.</h1><p class="lf-lede">Practical guides to help you attract the right audience, turn visits into inquiries and make every follow-up count.</p></div><aside class="lf-hero-aside"><span>FIELD NOTES</span><strong>Clear explanations. Useful checklists. No growth guarantees.</strong><span class="lf-aside-mark" aria-hidden="true">↗</span></aside></div></section>
  <section class="lf-page-section lf-section-muted"><div class="container"><div class="lf-section-head"><p class="section-kicker">THE GUIDES</p><h2>Start with the challenge you're solving.</h2></div><div class="lf-insights-grid">{articles.map((article,index) => <article class="lf-insight-card lf-insight-card-updated"><div class={`lf-insight-cover lf-insight-cover-${index+1}`} aria-hidden="true"><span>{article.category}</span><strong>{String(index+1).padStart(2,'0')}</strong></div><span class="lf-card-index">{article.category} / FIELD GUIDE</span><h3><a href={`/insights/${article.slug}/`}>{article.title}</a></h3><p>{article.desc}</p><a class="lf-read-more" href={`/insights/${article.slug}/`}>Read guide ↗</a></article>)}</div></div></section>
  <section class="lf-page-section"><div class="container"><div class="lf-section-head"><p class="section-kicker">NEED IMPLEMENTATION SUPPORT?</p><h2>Put the ideas into practice.</h2><p>Explore <a href="/performance-marketing/">paid advertising</a>, <a href="/websites-funnels/">conversion funnels</a> and <a href="/crm-automation/">lead follow-up systems</a>, or <a href="/contact/">tell us about your project</a>.</p></div></div></section>
</SiteLayout>
<style>
  .lf-insight-card-updated{overflow:hidden}
  .lf-insight-cover{min-height:148px;border-radius:9px;display:flex;justify-content:space-between;align-items:flex-start;padding:20px;margin-bottom:22px;color:#fff;background:linear-gradient(135deg,#172442,#2851b8)}
  .lf-insight-cover-2{background:linear-gradient(135deg,#0b415c,#198c92)}
  .lf-insight-cover-3{background:linear-gradient(135deg,#172442,#6663b3)}
  .lf-insight-cover span{font-size:11px;font-weight:800;letter-spacing:.12em}
  .lf-insight-cover strong{font-size:76px;line-height:1;opacity:.2;font-weight:800}
</style>
