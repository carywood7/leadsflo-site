.deck-page main section:before{content:"";position:absolute;z-index:0;pointer-events:none;width:350px;height:245px;right:-100px;bottom:25px;border:2px solid #b2875255;background:repeating-linear-gradient(90deg,transparent 0 30px,#b2875242 31px 33px,transparent 34px 62px);transform:skewY(-6deg);opacity:.32;animation:deckDrift 14s ease-in-out infinite alternate}
.deck-page #practices:before,.deck-page #automation:before,.deck-page #faq:before{left:-120px;right:auto}
