<script is:inline>
(()=>{
 const header=document.getElementById('ed-header');
 const menuBtn=document.getElementById('ed-menu-btn');
 const menu=document.getElementById('ed-menu');
 menuBtn?.addEventListener('click',()=>{
   const open=menu.classList.toggle('open');
   menuBtn.setAttribute('aria-expanded',String(open));
   menuBtn.setAttribute('aria-label',open?'Close navigation':'Open navigation');
 });
 menu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{
   menu.classList.remove('open'); menuBtn.setAttribute('aria-expanded','false');
   menuBtn.setAttribute('aria-label','Open navigation');
 }));
 document.addEventListener('keydown',e=>{
   if(e.key==='Escape'){menu?.classList.remove('open');menuBtn?.setAttribute('aria-expanded','false')}
 });
 let last=window.scrollY;
 window.addEventListener('scroll',()=>{
   const now=window.scrollY;
   if(now<65 || header.contains(document.activeElement) || Math.abs(now-last)<9){if(now<65)header.classList.remove('hidden');last=now;return}
   header.classList.toggle('hidden',now>last);last=now;
 },{passive:true});

  const programs={"wood": ["01", "▤", "Wood Decks", "Reach homeowners planning outdoor wood decks.", "Local deck builder searches and project pages", "ZIP code, approximate size and wood preference", "Arrange a project estimate"], "composite": ["02", "▥", "Composite Decking", "Reach homeowners researching composite decking.", "Composite deck installation searches", "Service area, approximate size and material interest", "Discuss a site visit"], "privacy": ["03", "▦", "Privacy Fences", "Capture residential privacy-fence installation demand.", "Local privacy-fence campaigns", "Fence length, height, material and ZIP code", "Book a fence estimate"], "commercial": ["04", "▧", "Commercial Fencing", "Connect with property managers and commercial buyers.", "Commercial fencing and property searches", "Site type, scope, geography and timing", "Route to commercial estimating"], "repair": ["05", "⌁", "Deck Repairs", "Attract repair work that fits your crew’s service offering.", "Deck repair searches and service-area content", "Existing condition, location and approximate scope", "Check suitability for site inspection"], "fence": ["06", "▤", "Fence Installation", "Connect with homeowners installing or replacing fences.", "Fence installation and material-specific search", "Material, linear footage, gates and timeline", "Book installation estimate"]};
 const pids=['ed-program-number','ed-program-symbol','ed-program-title','ed-program-description','ed-program-ads','ed-program-fit','ed-program-action'];
 function setProgram(key){
   if(!programs[key])return;
   programs[key].forEach((v,i)=>document.getElementById(pids[i]).textContent=v);
   document.querySelectorAll('[data-program]').forEach(btn=>{
     const selected=btn.dataset.program===key;
     btn.classList.toggle('active',selected);btn.setAttribute('aria-pressed',String(selected));
   });
 }
 document.querySelectorAll('[data-program]').forEach(btn=>{
   btn.addEventListener('click',()=>setProgram(btn.dataset.program));
   btn.addEventListener('focus',()=>setProgram(btn.dataset.program));
   btn.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')setProgram(btn.dataset.program)});
 });

  const stages=[["STAGE 01 / ATTRACT", "Get found for the deck and fence work you want.", "Local SEO and Google Ads bring relevant buyers to project pages.", "Relevant visits and calls"], ["STAGE 02 / CAPTURE", "Make it easy to request an estimate.", "Short forms and clear contact options capture new inquiries.", "New project inquiries"], ["STAGE 03 / QUALIFY", "Confirm that a project fits the crew.", "Review location, materials, scope and timing before booking.", "Suitable project leads"], ["STAGE 04 / RESPOND", "Follow up while the project is top of mind.", "Route forms, missed calls and follow-up messages appropriately.", "Reached leads"], ["STAGE 05 / VISIT", "Arrange an estimate or site inspection.", "Coordinate availability and confirm site details with the customer.", "Booked estimate visits"], ["STAGE 06 / PROPOSE", "Track project outcomes beyond the inquiry.", "Review proposals and verified projects won where attribution exists.", "Estimates and project outcomes"]];
 function setStage(n){
   const s=stages[n];if(!s)return;
   ['ed-stage-kicker','ed-stage-title','ed-stage-body','ed-stage-metric'].forEach((id,i)=>document.getElementById(id).textContent=s[i]);
   document.querySelectorAll('[data-stage]').forEach(btn=>{
     const active=Number(btn.dataset.stage)===n;
     btn.classList.toggle('active',active);btn.setAttribute('aria-pressed',String(active));
   });
 }
 document.querySelectorAll('[data-stage]').forEach(btn=>{
   btn.addEventListener('click',()=>setStage(Number(btn.dataset.stage)));
   btn.addEventListener('focus',()=>setStage(Number(btn.dataset.stage)));
   btn.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')setStage(Number(btn.dataset.stage))});
 });

 const ids=['ed-inquiries','ed-qualified','ed-contacted','ed-applications'];
 function updatePlanner(){
   const [a,b,c,d]=ids.map(id=>Number(document.getElementById(id).value));
   ids.forEach((id,i)=>{
     document.getElementById(id+'-label').textContent=[a,b+'%',c+'%',d+'%'][i];
   });
   const qualified=Math.round(a*b/100), reached=Math.round(qualified*c/100), applications=Math.round(reached*d/100);
   document.getElementById('ed-out-inquiries').textContent=a.toLocaleString();
   document.getElementById('ed-out-qualified').textContent=qualified.toLocaleString();
   document.getElementById('ed-out-reached').textContent=reached.toLocaleString();
   document.getElementById('ed-out-applications').textContent=applications.toLocaleString();
 }
 ids.forEach(id=>document.getElementById(id)?.addEventListener('input',updatePlanner));
 updatePlanner();

 document.querySelectorAll('.ed-faqs details').forEach(el=>{
   el.addEventListener('pointerenter',e=>{
     if(e.pointerType==='mouse')el.open=true;
   });
  el.addEventListener('pointerleave',e=>{
    if(e.pointerType==='mouse')el.open=false;
  });
 });
})();

</script>

