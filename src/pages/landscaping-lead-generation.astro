/* LEADSFLO_LANDSCAPING_FINISH_V2 */

.ls-brand{position:relative}

.ls-brand-leaf{
  position:absolute;
  right:-16px;
  top:-9px;
  width:21px;
  height:29px;
  color:#6c984c;
  transform-origin:bottom center;
  animation:ls-bloom 4s ease-in-out infinite alternate;
  pointer-events:none;
}

@keyframes ls-bloom{
  from{transform:rotate(-8deg) scale(.93)}
  to{transform:rotate(7deg) scale(1.05)}
}

.ls-gallery{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:18px;
}

.ls-photo{
  min-width:0;
  overflow:hidden;
  border:1px solid #d7e4d5;
  border-radius:14px;
  background:#fff;
  transition:transform .25s,box-shadow .25s;
}

.ls-photo:hover{
  transform:translateY(-5px);
  box-shadow:0 18px 30px rgba(22,57,35,.10);
}

.ls-photo img{
  width:100%;
  height:260px;
  object-fit:cover;
  display:block;
}

.ls-photo-body{padding:22px}

.ls-photo-body span{
  color:#507e59;
  font-size:11px;
  font-weight:850;
  letter-spacing:.09em;
}

.ls-photo-body h3{
  font-size:22px;
  letter-spacing:-.04em;
  margin:10px 0;
}

.ls-photo-body p{
  color:#5b7164;
  font-size:14px;
  line-height:1.7;
  margin:0;
}

.ls-photo-credit{
  margin-top:18px;
  font-size:12px;
  line-height:1.7;
  color:#718477;
}

.ls-photo-credit a{color:#275d41!important}

.ls-qualify{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:24px;
}

.ls-qual-form,
.ls-qual-board{
  padding:29px;
  border-radius:15px;
  min-width:0;
}

.ls-qual-form{
  background:#fff;
  border:1px solid #d3e1d1;
}

.ls-qual-form label{
  display:flex;
  flex-direction:column;
  gap:8px;
  margin-bottom:17px;
  font-weight:750;
  color:#31573e;
  font-size:13px;
}

.ls-qual-form input,
.ls-qual-form select{
  width:100%;
  padding:12px;
  min-height:46px;
  border:1px solid #c2d3c2;
  border-radius:7px;
  background:#fcfefa;
  color:#1d3f2e;
}

.ls-qual-board{
  display:flex;
  flex-direction:column;
  gap:17px;
  background:#113a2c;
  color:#e9f4ea;
}

.ls-qual-board .ls-kicker{color:#bade8e}

.ls-qual-board h3{
  font-size:29px;
  line-height:1.15;
  letter-spacing:-.04em;
  margin:0;
}

.ls-qual-board dl{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:15px;
  margin:0;
}

.ls-qual-board dt{
  color:#b1cab9;
  font-size:10px;
  font-weight:800;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.ls-qual-board dd{
  margin:6px 0 0;
  font-size:15px;
  font-weight:750;
  overflow-wrap:anywhere;
}

.ls-qual-next{
  background:#254f3e;
  border:1px solid #5c8965;
  border-radius:9px;
  padding:17px;
  line-height:1.65;
}

.ls-qual-board .ls-disclaimer{
  color:#b8cfc0;
  margin-top:auto;
}

@media(max-width:900px){
  .ls-gallery{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
  .ls-photo:last-child{grid-column:span 2}
  .ls-qualify{grid-template-columns:1fr}
}

@media(max-width:650px){
  .ls-gallery{grid-template-columns:1fr}
  .ls-photo:last-child{grid-column:auto}
  .ls-photo img{height:230px}
  .ls-qual-form,.ls-qual-board{padding:22px}
  .ls-photo:hover{transform:none}
}

@media(prefers-reduced-motion:reduce){
  .ls-brand-leaf{animation:none}
  .ls-photo{transition:none}
  .ls-photo:hover{transform:none}
}


/* LEADSFLO LANDSCAPING V3 */

.ls-section.dark .ls-card {
  color:#163b2b;
  background:#fff;
}
.ls-section.dark .ls-card h3 {
  color:#163b2b !important;
  opacity:1;
}
.ls-section.dark .ls-card p {color:#526b5a}
.ls-section.dark .ls-card span {color:#477a55}

.ls-marquee {
  background:#103528;
  padding:15px 0 24px;
  overflow:hidden;
}
.ls-marquee-label {
  color:#d0ed92;
  font-size:11px;
  font-weight:850;
  letter-spacing:.14em;
}
.ls-marquee-viewport {
  overflow:hidden;
}
.ls-marquee-track {
  display:flex;
  width:max-content;
  animation:ls-marquee-scroll 32s linear infinite;
}
.ls-marquee-group {
  display:flex;
  gap:12px;
  flex-shrink:0;
  padding-right:12px;
}
.ls-ticker-card {
  display:flex;
  align-items:center;
  gap:13px;
  padding:17px 23px;
  background:#f9f8ed;
  color:#183d2b;
  border:1px solid #b7cba9;
  border-radius:8px;
  font-size:16px;
  font-weight:800;
  white-space:nowrap;
}
.ls-ticker-card span {color:#579052}
.ls-marquee-viewport:hover .ls-marquee-track,
.ls-marquee-viewport:focus .ls-marquee-track {
  animation-play-state:paused;
}
@keyframes ls-marquee-scroll {
  to {transform:translateX(-50%)}
}

.ls-capability {
  cursor:pointer;
  transition:border-color .2s,box-shadow .2s;
}
.ls-capability:hover,
.ls-capability:focus-visible,
.ls-capability[aria-pressed="true"] {
  border-color:#75ae70;
  box-shadow:0 10px 24px #071f161e;
}
.ls-capability[aria-pressed="true"] {
  border-left:5px solid #78ab5d;
}
.ls-capability-panel {
  margin-top:24px;
  padding:28px;
  display:grid;
  grid-template-columns:1.3fr .7fr;
  gap:24px;
  background:#244c39;
  border:1px solid #648469;
  color:#f8faef;
  border-radius:13px;
}
.ls-capability-panel .ls-kicker {color:#d1ed98}
.ls-capability-panel h3 {
  font-size:clamp(25px,3vw,37px);
  color:#fff;
  line-height:1.17;
  margin:15px 0;
}
.ls-capability-panel p {
  color:#d3e4d4;
  line-height:1.75;
}
.ls-capability-panel-side {
  background:#123829;
  border:1px solid #648469;
  border-radius:9px;
  padding:22px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:12px;
}
.ls-capability-panel-side small {color:#d0ec92}
.ls-capability-panel-side strong {
  color:white;
  font-size:18px;
}
.ls-capability-panel-side p {
  font-size:12px;
  margin:0;
}
.ls-mobile-shortcuts,
.ls-mobile-booking {display:none}

.ls-top {
  position:sticky;
  top:0;
  z-index:100;
  transition:transform .25s ease;
}
.ls-top.ls-header-hidden {transform:translateY(-105%)}
body.ls section[id] {scroll-margin-top:115px}

.ls-footer-v3 {
  padding:62px 0 25px;
  background:#0e2b20;
  color:#e5f0e3;
}
.ls-footer-v3 .ls-footer-grid {
  display:grid;
  grid-template-columns:1.45fr 1fr 1fr 1.1fr;
  align-items:start;
  gap:35px;
}
.ls-footer-grid nav {
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:13px;
}
.ls-footer-grid nav strong {
  color:#cce98d;
