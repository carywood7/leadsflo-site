import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";
const booking = "https://calendar.app.google/gJscT3C474Xt4Nqh7";
const faqs = [
  ["How do you generate landscaping leads?", "We connect service-specific Google Ads and Meta Ads to focused landing pages, lead qualification and CRM follow-up. The campaign should distinguish routine lawn maintenance from landscaping installations and commercial contracts."],
  ["Can you help with both lawn care and landscape installation?", "Yes. These services have different buyer intent, timelines and economics, so we recommend separating campaigns, offers, forms and follow-up where appropriate."],
  ["Do you work with commercial landscaping companies?", "We can build campaigns and qualification flows for commercial grounds maintenance, property managers and larger contract opportunities, depending on your market and service capacity."],
  ["How much should a landscaping business spend on advertising?", "That depends on your local competition, service area, average job value, margins and available capacity. We work from your business economics rather than publishing one universal budget recommendation."],
  ["Can we use our existing CRM?", "Often, yes. We can connect suitable existing CRM and scheduling platforms instead of requiring you to replace everything. The aim is to make follow-up and booking reliable."],
  ["What makes a landscaping lead qualified?", "Qualification can include ZIP code, residential or commercial property, service type, project scope, timeline and relevant budget expectations. It should fit how your team estimates and books work."]
];
const schema = {"@context":"https://schema.org","@type":"Service","serviceType":"Landscaping marketing and lead generation","provider":{"@type":"Organization","name":"LeadsFlo","url":"https://leadsflo.co/"},"areaServed":{"@type":"Country","name":"United States"},"url":"https://leadsflo.co/landscaping-lead-generation/","description":"Landscaping and lawn care marketing through Google Ads, Meta Ads, conversion funnels, CRM follow-up and appointment setting."};
