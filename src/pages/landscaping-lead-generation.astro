  color:#b3d58b;
  opacity:.75;
  bottom:-4px;
}

/* Keep the actual wordmark visually dominant. */
body.ls .ls-brand .lf-brand-v4 {
  position:relative;
  z-index:1;
}

/* Hamburger is visible only at mobile navigation widths. */
@media(min-width:721px) {
