  background:#e6efdf;
}

body.ls .ls-hamb-lines {
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  width:30px;
  height:24px;
}

body.ls .ls-hamb-lines > span {
  display:block;
  flex:none;
  width:100%;
  height:3px;
  background:currentColor;
  border-radius:3px;
  transition:transform .2s ease,opacity .2s ease;
}

body.ls .ls-hamb[aria-expanded="true"]
  .ls-hamb-lines > span:nth-child(1) {
  transform:translateY(10.5px) rotate(45deg);
}

body.ls .ls-hamb[aria-expanded="true"]
  .ls-hamb-lines > span:nth-child(2) {
  opacity:0;
}

body.ls .ls-hamb[aria-expanded="true"]
  .ls-hamb-lines > span:nth-child(3) {
  transform:translateY(-10.5px) rotate(-45deg);
}

