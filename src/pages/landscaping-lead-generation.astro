<script is:inline>
(() => {
  const data = [{"title": "Google Search & local visibility", "desc": "Match keywords and service areas to actual offerings, from hardscape installation to maintenance routes. Separate high-intent categories where the buyer need differs."}, {"title": "Meta Ads & visual creative", "desc": "Use project imagery, seasonal offers and relevant local messaging to reach homeowners and property decision-makers without promising arbitrary lead counts."}, {"title": "Landing pages & qualification", "desc": "Build mobile-first offers, clear forms, calls and project-specific questions. A patio inquiry should not be handled like a weekly mowing request."}, {"title": "CRM & automation", "desc": "Route leads by service and location, notify the right team and keep follow-up visible. Integrate suitable existing tools rather than replacing working systems without reason."}, {"title": "Appointment setting", "desc": "Organize callbacks, site visits, estimates and design consultations with the context the sales or estimating team needs."}, {"title": "Measurement beyond CPL", "desc": "Compare inquiry volume with qualified leads, booked estimates, show rates and the jobs actually won, where the business tracks those outcomes."}];
  const cards = [...document.querySelectorAll(
    '[data-ls-capability]'
  )];

  function choose(index) {
    const entry = data[index];
    if (!entry) return;

    cards.forEach((card, i) => {
      card.setAttribute('aria-pressed', String(i === index));
    });

    document.getElementById('ls-capability-title').textContent =
      entry.title;
    document.getElementById('ls-capability-description').textContent =
      entry.desc;
  }

  cards.forEach((card, index) => {
    card.addEventListener('click', () => choose(index));
    card.addEventListener('focus', () => choose(index));
    card.addEventListener('pointerenter', event => {
      if (event.pointerType === 'mouse') choose(index);
    });
    card.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        choose(index);
      }
    });
  });

  choose(0);

  // Existing service selector retains its own click behavior.
  document.querySelectorAll('[data-service]').forEach(button => {
    button.addEventListener('pointerenter', event => {
      if (event.pointerType === 'mouse' &&
          button.getAttribute('aria-pressed') !== 'true') {
        button.click();
      }
    });
  });

  const finePointer = matchMedia(
    '(hover:hover) and (pointer:fine)'
  );

  document.querySelectorAll('#faqs details').forEach(detail => {
    detail.addEventListener('mouseenter', () => {
      if (finePointer.matches) detail.open = true;
    });
    detail.addEventListener('mouseleave', () => {
      if (finePointer.matches &&
          !detail.contains(document.activeElement)) {
        detail.open = false;
      }
    });
  });

  const header = document.querySelector('.ls-top');
  if (header) {
    let last = window.scrollY;
    let scheduled = false;

    window.addEventListener('scroll', () => {
      if (scheduled) return;
      scheduled = true;

      requestAnimationFrame(() => {
        const now = window.scrollY;
        const delta = now - last;
        const focused = header.contains(document.activeElement);
        const menuOpen = document.querySelector('.ls-menu.open');

        if (now < 95 || focused || menuOpen) {
          header.classList.remove('ls-header-hidden');
        } else if (Math.abs(delta) > 7) {
          header.classList.toggle('ls-header-hidden', delta > 0);
        }

        last = now;
        scheduled = false;
      });
    }, {passive:true});

    header.addEventListener('focusin', () => {
      header.classList.remove('ls-header-hidden');
    });

    header.querySelectorAll('a[href^="#"]').forEach(link => {
      link.addEventListener('click', () => {
        header.classList.remove('ls-header-hidden');
      });
    });
  }
})();
</script>


<script is:inline>
(() => {
  const presets = {
    lawn:{budget:2500,cpl:85,qualified:60,booked:45,
          show:80,close:30,value:600},
    design:{budget:5000,cpl:140,qualified:55,booked:50,
            show:85,close:25,value:8500},
    commercial:{budget:6000,cpl:200,qualified:50,booked:40,
                show:80,close:20,value:12000}
  };
  const names = {
    lawn:'LAWN CARE',
    design:'DESIGN & BUILD',
    commercial:'COMMERCIAL GROUNDS'
  };
  const keys = ['budget','cpl','qualified','booked',
                'show','close','value'];
  const inputs = Object.fromEntries(keys.map(k => [
    k,document.getElementById('lp-'+k)
  ]));
  if (keys.some(k => !inputs[k])) return;

  const put = (id,value) => {
    const el=document.getElementById(id);
    if(el) el.textContent=value;
  };
  const money = n => '$'+Math.round(n).toLocaleString('en-US');
  const number = n => n.toLocaleString('en-US',{
    maximumFractionDigits:1
  });
  let active='lawn';
  let changed=false;

  function get(k) {
    const input=inputs[k];
    const n=Number(input.value);
    if(!Number.isFinite(n)) return 0;
    return Math.min(
      Number(input.max)||1000000,
      Math.max(Number(input.min)||0,n)
    );
  }

  function render() {
    const budget=get('budget');
    const cpl=Math.max(1,get('cpl'));
    const q=get('qualified')/100;
    const b=get('booked')/100;
    const show=get('show')/100;
    const close=get('close')/100;
    const value=get('value');

    keys.filter(k=>k!=='value').forEach(k=>{
      const input=inputs[k];
      const v=get(k);
      const min=Number(input.min);
      const max=Number(input.max);
      const pct=max>min?100*(v-min)/(max-min):0;
      input.style.setProperty('--progress',pct+'%');
      put('lp-o-'+k,
          k==='budget'||k==='cpl'?money(v):v+'%');
    });

    const leads=budget/cpl;
    const qualified=leads*q;
    const booked=qualified*b;
    const shows=booked*show;
    const won=shows*close;
    const revenue=won*value;

    put('lp-revenue',money(revenue));
    put('lp-leads',number(leads));
    put('lp-qual',number(qualified));
    put('lp-books',number(booked));
    put('lp-won',number(won));
    put('lp-cpb',booked?money(budget/booked):'—');
    put('lp-cpa',won?money(budget/won):'—');
    put('lp-model',names[active]+(changed?' / CUSTOM':''));

    const stages={leads,qualified,booked,shows,won};
    Object.entries(stages).forEach(([k,v])=>{
      const row=document.querySelector('[data-lp-stage="'+k+'"]');
      if(!row)return;
      row.querySelector('b').textContent=number(v);
      row.querySelector('em').style.width=
        (leads?Math.min(100,100*v/leads):0)+'%';
    });
  }

  function select(name){
    if(!presets[name])return;
    active=name;
    changed=false;
    keys.forEach(k=>inputs[k].value=presets[name][k]);
    document.querySelectorAll('[data-lp-preset]').forEach(btn=>{
      btn.setAttribute('aria-pressed',
        String(btn.dataset.lpPreset===name));
    });
    render();
  }

  document.querySelectorAll('[data-lp-preset]').forEach(btn=>{
    btn.addEventListener('click',()=>select(btn.dataset.lpPreset));
  });
  keys.forEach(k=>{
    inputs[k].addEventListener('input',()=>{
      changed=true;
      render();
    });
  });
  document.getElementById('lp-reset')?.addEventListener(
    'click',()=>select(active)
  );
  select('lawn');
})();
</script>

