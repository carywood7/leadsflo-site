/* LEADSFLO LANDSCAPING ATMOSPHERE V6 */

body.ls section[data-ls-atmosphere] {
  position:relative;
  isolation:isolate;
}

body.ls section[data-ls-atmosphere] > .ls-wrap {
  position:relative;
  z-index:2;
}

body.ls .ls-atmo-shadow,
body.ls .ls-atmo-grass {
  position:absolute;
  z-index:0;
  pointer-events:none !important;
  user-select:none;
}

body.ls .ls-atmo-shadow {
  inset:0;
  overflow:hidden;
  background:
    url("/images/landscaping/leaf-shadows.svg")
    center top / cover no-repeat;
  opacity:.12;
  filter:blur(11px);
  transform-origin:85% 5%;
  animation:ls-leaf-breeze 13s ease-in-out infinite alternate;
}

body.ls [data-ls-atmosphere="hero"] .ls-atmo-shadow {
  opacity:.18;
}

body.ls [data-ls-atmosphere="planner"] .ls-atmo-shadow {
  opacity:.10;
  filter:blur(14px);
}

body.ls [data-ls-atmosphere="services"] .ls-atmo-shadow,
body.ls [data-ls-atmosphere="lead-flow"] .ls-atmo-shadow {
  opacity:.07;
}

body.ls [data-ls-atmosphere="faqs"] .ls-atmo-shadow {
  opacity:.11;
}

body.ls [data-ls-atmosphere="closing"] .ls-atmo-shadow {
  opacity:.12;
}

@keyframes ls-leaf-breeze {
  0% {
    transform:translate3d(-7px,0,0) rotate(-1.5deg)
      scale(1.02);
  }
  100% {
    transform:translate3d(9px,3px,0) rotate(2deg)
      scale(1.03);
  }
}

body.ls .ls-atmo-grass {
  left:0;
  right:0;
  bottom:-1px;
  height:45px;
  overflow:hidden;
  background:
    url("/images/landscaping/grass-edge.svg")
    center bottom / auto 45px repeat-x;
  opacity:.32;
}

body.ls [data-ls-atmosphere="planner"] .ls-atmo-grass {
  opacity:.25;
}

body.ls [data-ls-atmosphere="closing"] .ls-atmo-grass {
  opacity:.20;
}

/* Final planner surface refinements. */
body.ls .ls-planner-controls {
  background:linear-gradient(
    160deg,#ffffff 0%,#f8fbf6 100%
  );
}

body.ls .ls-planner-dashboard {
  background:
    radial-gradient(
      ellipse at 98% 0%,
      rgba(138,185,112,.12),
      transparent 46%
    ),
    linear-gradient(155deg,#143c2c,#0f2e23);
}

body.ls .ls-planner-presets button[aria-pressed="true"] {
  background:linear-gradient(
    160deg,#e9f5df,#dceecf
  );
  box-shadow:
    inset 0 0 0 1px #6b9c5d,
    0 8px 18px rgba(35,82,43,.09);
}

body.ls .ls-planner-revenue {
  box-shadow:0 14px 30px rgba(5,29,15,.15);
}

@media(max-width:900px) {
  body.ls .ls-atmo-shadow {
    opacity:.07;
    filter:blur(13px);
  }

  body.ls .ls-atmo-grass {
    height:32px;
    background-size:auto 32px;
    opacity:.20;
  }
}

@media(max-width:600px) {
  body.ls .ls-atmo-shadow {
    opacity:.04;
    filter:blur(16px);
    animation-duration:20s;
  }

  body.ls .ls-atmo-grass {
    height:22px;
    background-size:auto 22px;
    opacity:.15;
  }
}

@media(prefers-reduced-motion:reduce) {
  body.ls .ls-atmo-shadow {
    animation:none !important;
    transform:none !important;
  }
}


/* LEADSFLO_LANDSCAPING_MOBILE_LOGO_V7 */

/* Three clear hamburger lines with an accessible touch target. */
body.ls .ls-hamb {
  align-items:center;
  justify-content:center;
  width:52px;
  height:52px;
  min-width:52px;
  min-height:52px;
  padding:9px;
  border-radius:9px;
  color:#173f2d;
  background:transparent;
