---
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";
const booking = "https:" + "//calendar.app.google/1fpawLr6fgP7Hmoi7";
const canonical = "https:" + "//leadsflo.co/med-spa-lead-generation/";
const services = [
  {id:"acquire",num:"01",title:"Bring in the right inquiries",name:"Google & Meta advertising",desc:"Build focused campaigns around the treatments, service area, consultation process and capacity of the practice."},
  {id:"qualify",num:"02",title:"Understand the request",name:"Consultation funnels",desc:"Capture the service of interest, preferred location and appointment window without asking for sensitive clinical information."},
  {id:"respond",num:"03",title:"Answer before interest fades",name:"AI reception & chatbot",desc:"Handle routine questions, missed-call coverage, consultation routing and staff handoffs using approved information."},
  {id:"book",num:"04",title:"Turn interest into appointments",name:"CRM & booking automation",desc:"Coordinate appointments, reminders and consent-based follow-up while tracking each lead's source and status."}
];
const faqs = [
  {q:"Do you sell lists of med spa leads?",a:"No. We build marketing and conversion systems for individual practices, with campaigns, landing pages, qualification and follow-up connected to their booking workflow."},
  {q:"Can an AI receptionist book consultations?",a:"It can help handle routine inquiries and booking requests when connected to a supported calendar. Actual capabilities depend on the chosen phone, scheduling and CRM systems."},
  {q:"What can the AI chatbot answer?",a:"Approved questions about services, hours, locations, consultation availability and next steps. Medical advice, suitability decisions and sensitive concerns should go to qualified staff."},
  {q:"Can you make outbound AI follow-up calls?",a:"Where consent and applicable laws permit, an AI-assisted workflow can follow up on inquiries, confirm consultation details and assist with scheduling. We do not position unsolicited AI robocalling as a service."},
  {q:"Do you guarantee booked patients or revenue?",a:"No. Results depend on demand, service mix, budget, campaign performance, staff response, availability and conversion rates. We measure the funnel and optimize what we can verify."},
  {q:"Can this connect to our current CRM and calendar?",a:"Often, yes. We assess existing platforms, permissions, scheduling and data-handling requirements before specifying integrations or migrations."}
];
