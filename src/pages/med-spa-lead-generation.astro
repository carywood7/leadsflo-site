  <script is:inline>
    (()=>{
      const header=document.querySelector('.ms-header');const menu=document.querySelector('.ms-menu');const nav=document.querySelector('.ms-nav');let prev=window.scrollY;
      function closeMenu(){header.classList.remove('ms-open');menu.setAttribute('aria-expanded','false');}
      menu.addEventListener('click',()=>{const open=header.classList.toggle('ms-open');menu.setAttribute('aria-expanded',String(open));header.classList.remove('ms-hidden');});
      nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
      window.addEventListener('scroll',()=>{const now=window.scrollY;if(Math.abs(now-prev)<5)return;if(now<75||now<prev){header.classList.remove('ms-hidden')}else if(!header.classList.contains('ms-open')){header.classList.add('ms-hidden')}prev=now;},{passive:true});

      // MS_VISUAL_REDESIGN_V2: accessible treatment-journey selector
      const treatmentImage = document.getElementById('ms-treatment-image');
      const treatmentLabel = document.getElementById('ms-treatment-visual-label');
      const treatmentCount = document.getElementById('ms-treatment-count');
      const treatmentChoices = [...document.querySelectorAll('[data-treat]')];
      const treatmentStates = [
