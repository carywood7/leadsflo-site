<script is:inline>
(()=>{
 const header=document.getElementById('ed-header');
 const menuBtn=document.getElementById('ed-menu-btn');
 const menu=document.getElementById('ed-menu');
 menuBtn?.addEventListener('click',()=>{
   const open=menu.classList.toggle('open');
   menuBtn.setAttribute('aria-expanded',String(open));
   menuBtn.setAttribute('aria-label',open?'Close navigation':'Open navigation');
 });
 menu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{
   menu.classList.remove('open'); menuBtn.setAttribute('aria-expanded','false');
   menuBtn.setAttribute('aria-label','Open navigation');
 }));
 document.addEventListener('keydown',e=>{
   if(e.key==='Escape'){menu?.classList.remove('open');menuBtn?.setAttribute('aria-expanded','false')}
 });
 let last=window.scrollY;
 window.addEventListener('scroll',()=>{
   const now=window.scrollY;
   if(now<65 || header.contains(document.activeElement) || Math.abs(now-last)<9){if(now<65)header.classList.remove('hidden');last=now;return}
   header.classList.toggle('hidden',now>last);last=now;
 },{passive:true});

  const programs={"independent": ["01", "⌂", "Independent Hotels", "Help potential guests understand the property and book directly.", "Hotel SEO, local searches and booking-focused pages", "Location, travel dates and suitable room types", "Guide guests to verified availability and rates"], "boutique": ["02", "✧", "Boutique Hotels", "Lead with a unique guest experience rather than competing only on room price.", "Experience-led content, property photography and paid search", "Trip purpose, guest preferences and availability", "Progress from property story to booking engine"], "resort": ["03", "◈", "Resorts", "Reach travelers researching extended stays and on-property experiences.", "Destination SEO, seasonal campaigns and package pages", "Travel window, guest count and relevant packages", "Match guest interests to the right offer"], "extended": ["04", "▥", "Extended-Stay Properties", "Reach guests assessing convenience, amenities and longer stays.", "Location and need-based pages with appropriate ads", "Stay duration, room configuration and availability", "Support inquiries and direct booking pathways"], "luxury": ["05", "◇", "Luxury & Design Hotels", "Communicate what makes the property worth considering.", "Visual storytelling and high-intent brand/category search", "Guest expectations, stay intent and room options", "Make personal assistance and direct booking clear"], "group": ["06", "▣", "Groups & Events", "Handle event or group inquiries separately from individual stays.", "Group-specific pages, search campaigns and inquiry forms", "Dates, guest count, venue needs and capacity", "Route inquiries to the right hospitality team"]};
 const pids=['ed-program-number','ed-program-symbol','ed-program-title','ed-program-description','ed-program-ads','ed-program-fit','ed-program-action'];
 function setProgram(key){
   if(!programs[key])return;
   programs[key].forEach((v,i)=>document.getElementById(pids[i]).textContent=v);
   document.querySelectorAll('[data-program]').forEach(btn=>{
     const selected=btn.dataset.program===key;
     btn.classList.toggle('active',selected);btn.setAttribute('aria-pressed',String(selected));
   });
 }
 document.querySelectorAll('[data-program]').forEach(btn=>{
   btn.addEventListener('click',()=>setProgram(btn.dataset.program));
   btn.addEventListener('focus',()=>setProgram(btn.dataset.program));
   btn.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')setProgram(btn.dataset.program)});
 });

  const stages=[["STAGE 01 / DISCOVER", "Help the right travelers find your property.", "Hotel SEO, relevant paid search and useful destination content bring qualified guest intent.", "Relevant discovery and site visits"], ["STAGE 02 / EXPLORE", "Make the stay and experience easy to understand.", "Present honest property photography, room options, amenities, location and policies.", "Engaged property-page visits"], ["STAGE 03 / CHECK", "Make the route to availability clear.", "Give guests a visible, reliable path to dates, room types and available rates.", "Booking engine entries"], ["STAGE 04 / CONSIDER", "Reduce uncertainty before the reservation.", "Keep rates, inclusions and key booking terms clear; offer helpful human support when needed.", "Useful booking interactions"], ["STAGE 05 / RESERVE", "Measure confirmed direct reservations accurately.", "Coordinate marketing attribution with supported booking-engine confirmation data.", "Confirmed direct bookings where measurable"], ["STAGE 06 / RETURN", "Support loyalty without overwhelming guests.", "Use opt-in post-stay messages and useful future-stay offers where appropriate.", "Repeat guests and consented engagement"]];
 function setStage(n){
   const s=stages[n];if(!s)return;
   ['ed-stage-kicker','ed-stage-title','ed-stage-body','ed-stage-metric'].forEach((id,i)=>document.getElementById(id).textContent=s[i]);
   document.querySelectorAll('[data-stage]').forEach(btn=>{
     const active=Number(btn.dataset.stage)===n;
     btn.classList.toggle('active',active);btn.setAttribute('aria-pressed',String(active));
   });
 }
 document.querySelectorAll('[data-stage]').forEach(btn=>{
   btn.addEventListener('click',()=>setStage(Number(btn.dataset.stage)));
   btn.addEventListener('focus',()=>setStage(Number(btn.dataset.stage)));
   btn.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')setStage(Number(btn.dataset.stage))});
 });


 const capabilities = [["CAPABILITY 01 / HOTEL SEO", "Be discoverable for the stays you actually offer.", "Create useful property and destination pages answering guest questions, with honest room details and a clear booking path."], ["CAPABILITY 02 / PAID SEARCH", "Bring high-intent guest searches to the right offer.", "Build Google Ads around destination, property and booking intent, aligned with rates, availability and seasonal capacity."], ["CAPABILITY 03 / DIRECT BOOKING PAGES", "Reduce the distance between interest and availability.", "Make key amenities, rates, policies and booking links easy to find without pretending inquiries are reservations."], ["CAPABILITY 04 / PROPERTY STORYTELLING", "Give guests a reason to choose your experience.", "Use accurate property photography, useful content and clear audience-specific messages—not unsupported luxury claims."], ["CAPABILITY 05 / GUEST FOLLOW-UP", "Connect guest communications without creating friction.", "Coordinate inquiry routing, opt-in messaging and appropriate post-stay offers where supported by the hotel’s systems."], ["CAPABILITY 06 / BOOKING MEASUREMENT", "Know which steps lead to real reservations.", "Separate ad clicks, booking engine starts and confirmed direct reservations using reliable integrations when available."]];
 function setCapability(i){
  const v=capabilities[i]; if(!v)return;
  ['saas-service-label','saas-service-title','saas-service-body'].forEach((id,j)=>document.getElementById(id).textContent=v[j]);
  document.querySelectorAll('[data-service]').forEach(btn=>{const on=Number(btn.dataset.service)===i;btn.classList.toggle('active',on);btn.setAttribute('aria-pressed',String(on));});
 }
 document.querySelectorAll('[data-service]').forEach(btn=>{
  const choose=()=>setCapability(Number(btn.dataset.service));
  btn.addEventListener('click',choose);btn.addEventListener('focus',choose);
  btn.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')choose()});
 });

 const ids=['ed-inquiries','ed-qualified','ed-contacted','ed-applications'];
 function updatePlanner(){
   const [a,b,c,d]=ids.map(id=>Number(document.getElementById(id).value));
   ids.forEach((id,i)=>{
     document.getElementById(id+'-label').textContent=[a,b+'%',c+'%',d+'%'][i];
   });
   const qualified=Math.round(a*b/100), reached=Math.round(qualified*c/100), applications=Math.round(reached*d/100);
   document.getElementById('ed-out-inquiries').textContent=a.toLocaleString();
   document.getElementById('ed-out-qualified').textContent=qualified.toLocaleString();
   document.getElementById('ed-out-reached').textContent=reached.toLocaleString();
   document.getElementById('ed-out-applications').textContent=applications.toLocaleString();
 }
 ids.forEach(id=>document.getElementById(id)?.addEventListener('input',updatePlanner));
 updatePlanner();

 document.querySelectorAll('.ed-faqs details').forEach(el=>{
   el.addEventListener('pointerenter',e=>{
     if(e.pointerType==='mouse')el.open=true;
   });
  el.addEventListener('pointerleave',e=>{
    if(e.pointerType==='mouse')el.open=false;
  });
 });
})();

</script>

