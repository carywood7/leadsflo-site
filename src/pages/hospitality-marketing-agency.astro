 right:-30px;top:30px;width:255px;height:390px;opacity:.67;
 background:
  linear-gradient(90deg,#8bb6aa61 3px,transparent 3px) 0 0/53px 100%,
  linear-gradient(#b6926766 3px,transparent 3px) 0 0/100% 66px;
 border:2px solid #b692676b;clip-path:polygon(0 7%,50% 0,100% 7%,100% 100%,0 100%);
}
