 width:245px;height:150px;right:-50px;top:56px;
 border:9px solid #b79461a1;border-radius:23px;
 box-shadow:0 17px 0 #bd966239,0 36px 0 #bd96621e;
 background:linear-gradient(135deg,#e9c78f75 0 34%,transparent 34%);
 transform:rotate(15deg);
 animation:hotelKey 12s ease-in-out infinite alternate;
}
.hospitality-page #automation::after{
 right:40px;top:107px;width:76px;height:12px;background:#16777b99;
 border-radius:10px;transform:rotate(15deg);
}
/* Planner: readable geometric floor-plan grid, positioned behind right edge */
.hospitality-page #planner{background:
 linear-gradient(#b8915b20 1px,transparent 1px),
 linear-gradient(90deg,#b8915b20 1px,transparent 1px),#fbf9f3;
 background-size:56px 56px}
.hospitality-page #planner::before{
 right:-130px;bottom:-125px;width:395px;height:395px;
 border:22px double #b78b568c;border-radius:50%;opacity:.62;
 box-shadow:0 0 0 23px #ccae7c24;
 animation:hotelArch 15s ease-in-out infinite alternate;
}
/* Guide cards: editorial travel-postcard detailing, warmer than SaaS grids */
.hospitality-page #guides{background:linear-gradient(135deg,#ece6d9,#f9f5ec)}
.hospitality-page #guides::before{
 width:225px;height:225px;right:-65px;top:30px;opacity:.7;
 border:7px solid #b88c556b;outline:2px dashed #b88c5580;outline-offset:12px;
 transform:rotate(14deg);border-radius:14px;
}
.hospitality-page #guides::after{
 left:-45px;bottom:25px;width:320px;height:3px;
 background:repeating-linear-gradient(90deg,#c39358 0 18px,transparent 18px 29px);opacity:.7;
}
/* Final invitation: distinct arch-shaped glow, not repeated across every section */
.hospitality-page .ed-close::after{
 width:380px;height:430px;right:-105px;bottom:-160px;
 border:11px solid #f0c98d63;border-bottom:0;border-radius:200px 200px 0 0;
 box-shadow:inset 0 0 0 16px #e6bf8521;
}
@keyframes hotelArch{to{transform:translateY(-14px);opacity:.82}}
@keyframes hotelRoute{to{transform:rotate(-4deg) translateX(15px)}}
@keyframes hotelKey{to{transform:rotate(10deg) translateY(-10px)}}
@media(max-width:900px){
 .hospitality-page .ed-brand .hospitality-monogram{width:41px;height:41px;min-width:41px}
 .hospitality-page #services::before,.hospitality-page #practices::before,
 .hospitality-page #intake::before,.hospitality-page #automation::before,
 .hospitality-page #planner::before,.hospitality-page #guides::before{opacity:.19}
}
@media(prefers-reduced-motion:reduce){
 .hospitality-page main section::before,.hospitality-page main section::after{animation:none!important}
}

</style>



