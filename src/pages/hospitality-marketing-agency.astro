/* Services: very visible left-side decorative lobby arch and light strip */
.hospitality-page #services{background:
  linear-gradient(110deg,#f2e8d8 0%,#f8f4ec 58%,#efe4d1 100%)}
.hospitality-page #services::before{
  width:250px;height:350px;right:-85px;top:45px;
