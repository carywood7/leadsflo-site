<script is:inline>
(()=>{
 const header=document.getElementById('ed-header');
 const menuBtn=document.getElementById('ed-menu-btn');
 const menu=document.getElementById('ed-menu');
 menuBtn?.addEventListener('click',()=>{
   const open=menu.classList.toggle('open');
   menuBtn.setAttribute('aria-expanded',String(open));
   menuBtn.setAttribute('aria-label',open?'Close navigation':'Open navigation');
 });
 menu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{
   menu.classList.remove('open'); menuBtn.setAttribute('aria-expanded','false');
   menuBtn.setAttribute('aria-label','Open navigation');
 }));
 document.addEventListener('keydown',e=>{
   if(e.key==='Escape'){menu?.classList.remove('open');menuBtn?.setAttribute('aria-expanded','false')}
 });
 let last=window.scrollY;
 window.addEventListener('scroll',()=>{
   const now=window.scrollY;
   if(now<65 || header.contains(document.activeElement) || Math.abs(now-last)<9){if(now<65)header.classList.remove('hidden');last=now;return}
   header.classList.toggle('hidden',now>last);last=now;
 },{passive:true});

  const programs={"sales": ["01", "▣", "Sales-Led SaaS", "Bring high-intent buyers into conversations with your sales team.", "Category SEO, commercial Google Ads and demo-intent pages", "Company fit, role, use case and buying timeline", "Route accepted leads to the right sales conversation"], "plg": ["02", "⌘", "Product-Led SaaS", "Connect relevant demand with products buyers can actually evaluate.", "Use-case SEO, trial-focused paid search and activation paths", "Intended use case, account fit and product engagement", "Track meaningful activation, not every trial as pipeline"], "startup": ["03", "✧", "SaaS Startups", "Test clear positioning and focused acquisition channels before scaling.", "Narrow ICP pages, practical SEO and tightly scoped PPC tests", "Target segment, problem urgency and product suitability", "Learn from qualified conversations and activation signals"], "enterprise": ["04", "⬡", "Enterprise Software", "Support buying teams researching technical and commercial requirements.", "Solution pages, problem-led content and intent-led campaigns", "Industry, company requirements and stakeholder fit", "Coordinate sales handoff and account-level follow-up"], "vertical": ["05", "◫", "Vertical SaaS", "Speak directly to buyers solving specialized industry problems.", "Industry-specific SEO, comparison pages and focused ads", "Industry, workflow requirements and serviceable regions", "Book a relevant use-case demo"], "software": ["06", "↗", "Software & Platforms", "Reach buyers assessing business software and technology solutions.", "Solution SEO, paid search and conversion-oriented pages", "Business use case, team needs and qualification criteria", "Progress the right leads to discovery or trial"]};
 const pids=['ed-program-number','ed-program-symbol','ed-program-title','ed-program-description','ed-program-ads','ed-program-fit','ed-program-action'];
 function setProgram(key){
   if(!programs[key])return;
   programs[key].forEach((v,i)=>document.getElementById(pids[i]).textContent=v);
   document.querySelectorAll('[data-program]').forEach(btn=>{
     const selected=btn.dataset.program===key;
     btn.classList.toggle('active',selected);btn.setAttribute('aria-pressed',String(selected));
   });
 }
 document.querySelectorAll('[data-program]').forEach(btn=>{
   btn.addEventListener('click',()=>setProgram(btn.dataset.program));
   btn.addEventListener('focus',()=>setProgram(btn.dataset.program));
   btn.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')setProgram(btn.dataset.program)});
 });

  const stages=[["STAGE 01 / ATTRACT", "Reach people researching software problems and solutions.", "SEO, high-intent search campaigns and helpful product content make your business discoverable.", "Relevant search visits and engaged buyers"], ["STAGE 02 / CAPTURE", "Give interested buyers a clear next step.", "Use persona-specific pages, short forms, product trials and demo requests appropriate to the sales motion.", "Relevant inquiries, demo requests or trials"], ["STAGE 03 / QUALIFY", "Distinguish genuine fit from raw signups.", "Assess buyer role, company fit, use case and intent; for product-led companies, review activation signals.", "Qualified lead or product-fit signals"], ["STAGE 04 / NURTURE", "Help promising leads progress at the right pace.", "Connect CRM stages, consent-based messaging, education and timely sales handoff.", "Reached and engaged qualified buyers"], ["STAGE 05 / DEMO / ACTIVATE", "Move prospects into meaningful evaluation.", "Support completed demos for sales-led motions or useful activation milestones for product-led motions.", "Completed demos or meaningful activations"], ["STAGE 06 / OPPORTUNITY", "Measure pipeline impact, not vanity totals.", "Track sales-accepted opportunities and verified customer outcomes when attribution permits.", "Sales opportunities and verified outcomes"]];
 function setStage(n){
   const s=stages[n];if(!s)return;
   ['ed-stage-kicker','ed-stage-title','ed-stage-body','ed-stage-metric'].forEach((id,i)=>document.getElementById(id).textContent=s[i]);
   document.querySelectorAll('[data-stage]').forEach(btn=>{
     const active=Number(btn.dataset.stage)===n;
     btn.classList.toggle('active',active);btn.setAttribute('aria-pressed',String(active));
   });
 }
 document.querySelectorAll('[data-stage]').forEach(btn=>{
   btn.addEventListener('click',()=>setStage(Number(btn.dataset.stage)));
   btn.addEventListener('focus',()=>setStage(Number(btn.dataset.stage)));
   btn.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')setStage(Number(btn.dataset.stage))});
 });


 const capabilities = [["CAPABILITY 01 / SEARCH INTENT", "Turn relevant searches into software buyer conversations.", "Create useful SEO pages for the problems, categories and comparisons your ideal buyers research. Track qualified organic demand, not just rankings."], ["CAPABILITY 02 / PAID ACQUISITION", "Pay for intent, not vanity clicks.", "Build Google Ads around relevant commercial searches, clear landing pages and agreed conversion definitions such as qualified demo requests."], ["CAPABILITY 03 / CONVERSION PATHS", "Make each next step match buyer readiness.", "Use focused forms, demos, trials and product pages appropriate to the buyer and the company’s sales motion."], ["CAPABILITY 04 / DEMAND GENERATION", "Help the market understand the problem before it buys.", "Combine educational content, clear positioning and acquisition campaigns across awareness and evaluation stages."], ["CAPABILITY 05 / LIFECYCLE OPERATIONS", "Connect leads to timely follow-up.", "Coordinate opt-in nurturing, routing, handoffs and lifecycle stages without assuming every raw signup is sales-qualified."], ["CAPABILITY 06 / MEASUREMENT", "Make pipeline quality visible.", "Measure qualified leads, completed demos, activated trials and opportunities when reliable attribution is available."]];
 function setCapability(i){
  const v=capabilities[i]; if(!v)return;
  ['saas-service-label','saas-service-title','saas-service-body'].forEach((id,j)=>document.getElementById(id).textContent=v[j]);
  document.querySelectorAll('[data-service]').forEach(btn=>{const on=Number(btn.dataset.service)===i;btn.classList.toggle('active',on);btn.setAttribute('aria-pressed',String(on));});
 }
 document.querySelectorAll('[data-service]').forEach(btn=>{
  const choose=()=>setCapability(Number(btn.dataset.service));
  btn.addEventListener('click',choose);btn.addEventListener('focus',choose);
  btn.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')choose()});
 });

 const ids=['ed-inquiries','ed-qualified','ed-contacted','ed-applications'];
 function updatePlanner(){
   const [a,b,c,d]=ids.map(id=>Number(document.getElementById(id).value));
   ids.forEach((id,i)=>{
     document.getElementById(id+'-label').textContent=[a,b+'%',c+'%',d+'%'][i];
   });
   const qualified=Math.round(a*b/100), reached=Math.round(qualified*c/100), applications=Math.round(reached*d/100);
   document.getElementById('ed-out-inquiries').textContent=a.toLocaleString();
   document.getElementById('ed-out-qualified').textContent=qualified.toLocaleString();
   document.getElementById('ed-out-reached').textContent=reached.toLocaleString();
   document.getElementById('ed-out-applications').textContent=applications.toLocaleString();
 }
 ids.forEach(id=>document.getElementById(id)?.addEventListener('input',updatePlanner));
 updatePlanner();

 document.querySelectorAll('.ed-faqs details').forEach(el=>{
   el.addEventListener('pointerenter',e=>{
     if(e.pointerType==='mouse')el.open=true;
   });
  el.addEventListener('pointerleave',e=>{
    if(e.pointerType==='mouse')el.open=false;
  });
 });
})();

</script>

