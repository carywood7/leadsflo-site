<script is:inline>
(() => {
 const planner = document.querySelector('.saas-page #planner');
 if (!planner || !window.matchMedia('(pointer:fine)').matches) return;
 planner.addEventListener('pointermove', e => {
   const r = planner.getBoundingClientRect();
   planner.style.setProperty('--saas-x', ((e.clientX-r.left)/r.width*100)+'%');
   planner.style.setProperty('--saas-y', ((e.clientY-r.top)/r.height*100)+'%');
 }, {passive:true});
 planner.addEventListener('pointerleave', () => {
   planner.style.removeProperty('--saas-x');
   planner.style.removeProperty('--saas-y');
 });
})();
</script>

